def cmd_watch(args):
    if not args.once:
        print("watch 는 상주하지 않습니다. cron/systemd 타이머/Windows 작업 스케줄러에서 `devmaru-fleet watch --once` 를 호출하세요.", file=sys.stderr)
        return EX_USAGE
    hosts = select_hosts(load_inventory(), args.hosts)
    rows = run_parallel(collect_status, hosts, args.parallel)
    now = {r["name"]: summarize(r) for r in rows}
    sp = state_dir() / "watch-state.json"
    try:
        old = json.loads(sp.read_text(encoding="utf-8")) if sp.exists() else None
    except (OSError, ValueError):
        old = None
    changes = []
    if old is None:
        changes.append("처음 실행: 기준 상태를 저장합니다(%d대)" % len(now))
    else:
        for name, cur in now.items():
            prev = old.get(name)
            if prev is None:
                changes.append("%s: 새로 추가됨(%s)" % (name, cur["state"])); continue
            for k, v in cur.items():
                if prev.get(k) != v:
                    changes.append("%s: %s %s → %s" % (name, k, prev.get(k), v))
        for name in old:
            if name not in now:
                changes.append("%s: 인벤토리에서 빠짐" % name)
    try:
        state_dir().mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=str(state_dir()))
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(now, f, ensure_ascii=False)
        if not _is_windows():
            os.chmod(tmp, 0o600)
        os.replace(tmp, sp)
    except OSError as e:
        print("경고: 상태 파일을 저장하지 못했습니다: %s" % one_line(str(e)), file=sys.stderr)
    for r in rows:
        audit("watch", r["name"], "read", r["state"])
    for c in changes:
        print(c)
    if not changes:
        print("변화 없음(%d대)" % len(now))
    if exit_for(rows) == EX_UNREACH:
        return EX_UNREACH
    return EX_WARN if (changes and old is not None) else EX_OK


