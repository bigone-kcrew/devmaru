# ───────────────────────── 3단계: 안내형 갱신(update) · 회원 컨테이너 갱신(members) ─────────────────────────
UPDATE_UNIT, UPDATE_LOG = "devmaru-fleet-update", "/var/log/devmaru-fleet-update.log"
MEMBERS_UNIT, MEMBERS_LOG = "devmaru-fleet-members", "/var/log/devmaru-fleet-members.log"


def ver_key(v):
    try:
        return tuple(int(x) for x in str(v).strip().split("."))
    except ValueError:
        return None


def kit_info(tarball):
    """tarball 안의 킷 버전·Golden 버전을 읽는다(풀지 않고 지정한 두 파일만)."""
    import tarfile
    info = {"version": None, "golden": None}
    with tarfile.open(tarball, "r:gz") as tf:
        names = tf.getnames()
        top = names[0].split("/")[0] if names else ""
        for key, path in (("version", top + "/VERSION"), ("golden", top + "/tree/golden/GOLDEN_VERSION")):
            try:
                info[key] = tf.extractfile(path).read().decode("utf-8", "replace").strip()
            except (KeyError, AttributeError):
                pass
    return info


def remote_facts(host):
    """갱신·회원 갱신 가드용 읽기 전용 사실. sudo -n 이 필요한 것(정비 락·회원 집계)은 sudo 가능 여부도 함께 돌려준다."""
    r = ssh_run(host, ["sh", "-c", "cat /opt/devmaru-kit/VERSION 2>/dev/null; echo ---; cat /opt/%s/images/dev/GOLDEN_VERSION 2>/dev/null; echo ---; "
                       "d=/srv; [ -d $d ] || d=/; df --output=avail -BG $d | tail -1 | tr -dc 0-9" % host.prefix])
    if r.kind != "ok":
        return None, r
    parts = (r.out.split("---\n") + ["", "", ""])[:3]
    f = {"kit": parts[0].strip() or None, "golden": parts[1].strip() or None, "disk_gb": int(re.sub(r"\D", "", parts[2]) or 0)}
    m = ssh_run(host, sbin(host, "maintenance", "status", "--json"))
    f["sudo"] = m.kind != "no_sudo"
    mt = parse_json(m.out) if f["sudo"] else None
    f["maint"] = mt.get("state") if mt else None
    mu = ssh_run(host, bin_(host, "member-update-all", "--json")) if f["sudo"] else None
    f["members"] = parse_json(mu.out) if mu else None
    return f, None


def evaluate_update(f, new, force):
    notes = []

    def add(ok, okm, badm, warn=False):
        notes.append(("성공" if ok else ("경고" if warn else "실패"), okm if ok else badm))
    cur = f.get("kit")
    add(cur is not None, "설치된 킷 %s" % cur, "설치된 devmaru 를 찾지 못했습니다(/opt/devmaru-kit/VERSION) — 새 서버는 install 을 쓰세요")
    nv, cv = ver_key(new.get("version")), (ver_key(cur) if cur else None)
    if not nv:
        add(False, "", "tarball 의 버전을 읽지 못했습니다")
    elif cur and cv:
        if nv < cv:
            add(False, "", "새 킷(%s)이 설치된 킷(%s)보다 낮습니다 — 다운그레이드는 지원하지 않습니다" % (new["version"], cur))
        elif nv == cv:
            add(force, "같은 버전(%s)을 다시 적용합니다(--force)" % cur, "이미 같은 버전(%s)입니다 — 다시 적용하려면 --force" % cur)
        else:
            add(True, "킷 %s → %s" % (cur, new["version"]), "")
    add(f.get("sudo", False), "sudo -n 가능(가드 점검)", "가드 점검에 비밀번호 없는 sudo(또는 agent 모듈의 제한 sudo)가 필요합니다")
    add(f.get("maint") == "idle", "다른 정비 작업 없음", "다른 정비 작업이 실행 중이거나 확인할 수 없습니다(상태: %s)" % f.get("maint"))
    if new.get("golden") and new["golden"] != f.get("golden"):
        gb = f.get("disk_gb", 0)
        add(gb >= 30, "Golden 이미지를 다시 빌드합니다(%s → %s) — /srv 여유 %dGB" % (f.get("golden"), new["golden"], gb),
            "Golden 재빌드(%s → %s)가 필요한데 /srv 여유가 %dGB 입니다 — 최소 30GB" % (f.get("golden"), new["golden"], gb))
    else:
        notes.append(("성공", "Golden 이미지 변경 없음(재빌드 안 함)"))
    mem = (f.get("members") or {}).get("summary")
    if mem is None:
        add(False, "", "회원 집계를 확인하지 못했습니다(서버 킷이 1.3.0 이전이거나 권한 없음)", warn=True)
    elif mem.get("busy"):
        add(False, "", "작업 중인 회원 %d명 — 갱신은 서비스를 다시 적용하므로 잠시 연결이 끊길 수 있습니다" % mem["busy"], warn=True)
    return notes


def evaluate_members(f):
    """(notes, 할 일 있음). 작업 중인 회원이 있으면 거부(BLOCKED), 컨테이너가 없는 회원이 있으면 검토(REVIEW)도 거부."""
    notes = []
    notes.append(("성공" if f.get("sudo") else "실패", "sudo -n 가능(가드 점검)" if f.get("sudo") else "가드 점검에 비밀번호 없는 sudo(또는 agent 모듈의 제한 sudo)가 필요합니다"))
    notes.append(("성공" if f.get("maint") == "idle" else "실패", "다른 정비 작업 없음" if f.get("maint") == "idle" else "다른 정비 작업이 실행 중이거나 확인할 수 없습니다(상태: %s)" % f.get("maint")))
    mj = f.get("members") or {}
    res = mj.get("result"); summ = mj.get("summary") or {}
    if res == "READY":
        notes.append(("성공", "작업 중인 회원 없음(READY) — 회원 %s명" % summ.get("members")))
    elif res == "BLOCKED":
        notes.append(("실패", "작업 중인 회원 %s명(BLOCKED) — 컨테이너를 다시 만들면 진행 중인 작업이 끊깁니다. 끝난 뒤 다시 하세요" % summ.get("busy")))
    elif res == "REVIEW":
        notes.append(("실패", "개발 컨테이너가 없는 회원 %s명(REVIEW) — 먼저 확인하세요" % summ.get("missing")))
    else:
        notes.append(("실패", "회원 상태를 확인하지 못했습니다(%s)" % one_line(str(mj.get("error", "응답 없음")), 80)))
    todo = (summ.get("outdated") or 0) > 0
    notes.append(("성공", "새 Golden 이미지를 쓰지 않는 컨테이너 %s개를 갱신합니다" % summ.get("outdated") if todo else "모든 회원 컨테이너가 이미 최신입니다 — 할 일 없음"))
    return notes, todo


def show_notes(host, notes, quiet_ok=False):
    bad = False
    for lv, msg in notes:
        print("  [%s] %s: %s" % (host.name, lv, msg)); bad = bad or lv == "실패"
    return bad


def launch_job(host, unit, log, shell_cmd, interactive):
    rotate_log(host, log, interactive)
    cmd = ["systemd-run", "--unit=" + unit, "--collect", "--property=StandardOutput=append:" + log, "--property=StandardError=inherit",
           "sh", "-c", shell_cmd + "; echo FLEET_EXIT=$?"]
    return run_sudo(host, cmd, interactive)


def ask_typed(prompt_text, expected):
    print(prompt_text)
    try:
        typed = input("입력: ").strip()
    except EOFError:
        typed = ""
    return typed == expected


def update_prepare(host, args, new, quiet=False):
    """읽기 전용 가드. 반환: 'ok' | 'blocked' | 'unreachable'(+ facts)."""
    facts, err = remote_facts(host)
    if facts is None:
        print("  [%s] 실패: 서버에 접속하지 못했습니다: %s" % (host.name, one_line(err.err) or err.kind)); return "unreachable", None
    bad = show_notes(host, evaluate_update(facts, new, args.force))
    return ("blocked" if bad else "ok"), facts


def update_run(host, args, kit, new, interactive):
    """업로드 → 분리 실행 → 따라가기 → 확인. 반환 True/False."""
    rdir = REMOTE_TMP % host.user
    sumfile = Path(tempfile.mkdtemp()) / "kit.tar.gz.sha256"
    sumfile.write_text("%s  kit.tar.gz\n" % sha256_file(kit), encoding="utf-8")
    ok1, e1 = upload(host, kit, rdir, "kit.tar.gz"); ok2, e2 = upload(host, str(sumfile), rdir, "kit.tar.gz.sha256")
    if not (ok1 and ok2):
        print("  [%s] 실패: 킷 업로드 실패: %s" % (host.name, e1 or e2)); return False
    r = ssh_run(host, ["sha256sum", "%s/kit.tar.gz" % rdir])
    if r.rc != 0 or r.out.split()[:1] != [sha256_file(kit)]:
        print("  [%s] 실패: 올린 킷의 sha256 이 로컬과 다릅니다(전송 오류)" % host.name); return False
    cmd = "/usr/local/sbin/{p}-update --yes{f} file://{d}/kit.tar.gz".format(p=host.prefix, f=" --force" if args.force else "", d=rdir)
    rc, out = launch_job(host, UPDATE_UNIT, UPDATE_LOG, cmd, interactive)
    if rc != 0:
        print("  [%s] 실패: 갱신을 시작하지 못했습니다: %s" % (host.name, one_line(out, 160))); audit("update-apply", host.name, "apply", "start-fail"); return False
    audit("update-apply", host.name, "apply", "started")
    print("  [%s] 갱신을 시작했습니다(서버에서 분리 실행 — 연결이 끊겨도 계속됩니다)" % host.name)
    code, stage, failed = poll_install(host, None, timeout=args.timeout, unit=UPDATE_UNIT, log=UPDATE_LOG, label="update")
    if code != 0:
        print("  [%s] 실패: 갱신이 끝나지 않았습니다 — %s%s" % (host.name, stage or "?", " · " + failed if failed else "")); audit("update-apply", host.name, "apply", "fail-%s" % code); return False
    facts, _ = remote_facts(host)
    d = parse_json(ssh_run(host, sbin(host, "doctor", "--json")).out)
    good = bool(facts) and facts.get("kit") == new["version"] and bool(d) and d.get("status") == "pass"
    print("  [%s] %s: 킷 %s · doctor %s(경고 %s)" % (host.name, "성공" if good else "실패", (facts or {}).get("kit"), (d or {}).get("status"), (d or {}).get("warnings")))
    audit("update-apply", host.name, "apply", "ok" if good else "verify-fail")
    return good


def cmd_update(args):
    hosts = select_hosts(load_inventory(), args.hosts)
    if args.action == "status":
        if len(hosts) != 1:
            print("실패: update status 는 --hosts 로 서버 하나를 지정하세요", file=sys.stderr); return EX_USAGE
        return job_status(hosts[0], UPDATE_UNIT, UPDATE_LOG, "갱신", "update", args.follow, args.timeout)
    if not args.kit:
        print("실패: update %s 에는 --kit <릴리스 tarball> 이 필요합니다" % args.action, file=sys.stderr); return EX_USAGE
    ok, msgs = verify_release(args.kit, args.allow_unsigned)
    for m in msgs:
        print(m)
    if not ok:
        audit("update-" + args.action, "-", args.action, "verify-fail"); return EX_WARN
    new = kit_info(args.kit)
    print("새 킷 %s (Golden %s) — 서버 %d대: %s" % (new["version"], new["golden"], len(hosts), ", ".join(h.name + ("*" if h.canary else "") for h in hosts)))
    if not any(h.canary for h in hosts):
        print("안내: 선택한 서버에 canary 가 없습니다 — 한 번에 한 서버씩, 서버별 확인으로 진행합니다.")
    states = {}
    for h in hosts:
        print("\n== %s (%s:%d)" % (h.name, h.address, h.port))
        st, facts = update_prepare(h, args, new); states[h.name] = (st, facts)
    blocked = [n for n, (st, _) in states.items() if st != "ok"]
    if args.action == "plan":
        audit("update-plan", "-", "plan", "blocked" if blocked else "ok")
        print("\n계획만 보여 드렸습니다. 서버에는 아무것도 바꾸지 않았습니다." + (" 막힌 서버: " + ", ".join(blocked) if blocked else ""))
        return EX_WARN if blocked else EX_OK
    if blocked:
        print("\n막힌 서버가 있어 적용하지 않습니다(%s). 해결한 뒤 다시 실행하거나 --hosts 로 막히지 않은 서버만 고르세요." % ", ".join(blocked)); return EX_WARN
    print("\n※ 갱신을 되돌리는 공식 도구는 없습니다. 실패하면 `update` 를 다시 실행하거나 이전 킷으로 다시 적용해야 합니다.")
    inter = sys.stdin.isatty() and sys.stdout.isatty()
    n = max(1, args.rolling)
    if n > 1 and not all((states[h.name][1] or {}).get("sudo") for h in hosts):
        print("실패: --rolling %d 은 서버 여러 대를 동시에 진행하므로 모든 서버에 비밀번호 없는 sudo 가 필요합니다" % n); return EX_WARN
    canaries = [h for h in hosts if h.canary]; rest = [h for h in hosts if not h.canary]
    batches = [[h] for h in canaries] + [rest[i:i + n] for i in range(0, len(rest), n)]
    results = {}
    for bi, batch in enumerate(batches):
        names = ", ".join(h.name for h in batch)
        if len(batch) == 1:
            if not ask_typed("\n서버 `%s` 을(를) 갱신합니다%s. 서버 이름을 그대로 입력하세요." % (batch[0].name, " (canary)" if batch[0].canary else ""), batch[0].name):
                print("취소했습니다. 이후 서버는 진행하지 않습니다."); audit("update-apply", batch[0].name, "apply", "cancel"); break
        else:
            groups = {h.group for h in batch}
            token = (groups.pop() if len(groups) == 1 else "") or "all"
            if not ask_typed("\n서버 %d대(%s)를 동시에 갱신합니다. 확인 문구 `%s` 를 그대로 입력하세요." % (len(batch), names, token), token):
                print("취소했습니다. 이후 서버는 진행하지 않습니다."); audit("update-apply", names, "apply", "cancel"); break
        if len(batch) == 1:
            results[batch[0].name] = update_run(batch[0], args, args.kit, new, inter)
        else:
            with ThreadPoolExecutor(max_workers=len(batch)) as ex:
                for h, okh in zip(batch, ex.map(lambda x: update_run(x, args, args.kit, new, False), batch)):
                    results[h.name] = okh
        if not all(results.get(h.name) for h in batch):
            print("\n실패한 서버가 있어 이후 서버는 진행하지 않습니다."); break
    print("\n== 결과")
    for h in hosts:
        print("  %-14s %s" % (h.name, "성공" if results.get(h.name) else ("실패" if h.name in results else "진행 안 함")))
    return EX_OK if all(results.get(h.name) for h in hosts) else EX_WARN


def cmd_members(args):
    host = select_hosts(load_inventory(), args.host)[0]
    if args.action == "status":
        return job_status(host, MEMBERS_UNIT, MEMBERS_LOG, "회원 갱신", "members", args.follow, args.timeout)
    facts, err = remote_facts(host)
    if facts is None:
        print("실패: 서버에 접속하지 못했습니다: %s" % (one_line(err.err) or err.kind)); return EX_UNREACH
    print("== %s members %s — %s" % (TOOL, args.action, host.name))
    notes, todo = evaluate_members(facts)
    bad = show_notes(host, notes)
    if args.action == "plan":
        audit("members-plan", host.name, "plan", "blocked" if bad else "ok")
        print("\n계획만 보여 드렸습니다. 서버에는 아무것도 바꾸지 않았습니다."); return EX_WARN if bad else EX_OK
    if bad:
        print("\n막힌 항목이 있어 적용하지 않습니다."); audit("members-apply", host.name, "apply", "blocked"); return EX_WARN
    if not todo:
        return EX_OK
    if not ask_typed("\n서버 `%s` 의 회원 컨테이너를 **다시 만듭니다**(홈·workspace 는 유지, 실행 중인 프로세스는 끊김). 서버 이름을 그대로 입력하세요." % host.name, host.name):
        print("취소했습니다."); audit("members-apply", host.name, "apply", "cancel"); return EX_WARN
    inter = sys.stdin.isatty() and sys.stdout.isatty()
    rc, out = launch_job(host, MEMBERS_UNIT, MEMBERS_LOG, "/usr/local/bin/%s-member-update-all" % host.prefix, inter)
    if rc != 0:
        print("실패: 시작하지 못했습니다: %s" % one_line(out, 160)); return EX_WARN
    audit("members-apply", host.name, "apply", "started")
    code, stage, failed = poll_install(host, None, timeout=args.timeout, unit=MEMBERS_UNIT, log=MEMBERS_LOG, label="members")
    f2, _ = remote_facts(host)
    summ = ((f2 or {}).get("members") or {}).get("summary") or {}
    good = code == 0 and summ.get("outdated") == 0
    print("%s: 회원 컨테이너 갱신 %s(최신 아님 %s개)" % ("성공" if good else "실패", "완료" if code == 0 else "끝나지 않음 — %s%s" % (stage or "?", " · " + failed if failed else ""), summ.get("outdated")))
    audit("members-apply", host.name, "apply", "ok" if good else "fail"); return EX_OK if good else EX_WARN


def job_status(host, unit, log, label, cmdname, follow=False, timeout=7200):
    r = ssh_run(host, ["sh", "-c", "systemctl is-active %s 2>/dev/null; echo ---; tail -n 300 %s 2>/dev/null" % (unit, log)])
    if r.kind in ("unreachable", "timeout", "no_trust"):
        print("서버에 닿지 못했습니다: %s" % one_line(r.err)); return EX_UNREACH
    head, _, text = r.out.partition("---\n")
    stage, code, failed = stage_progress(text)
    print("서버 %s — %s 작업 %s" % (host.name, label, head.strip() or "없음"))
    if stage:
        print("  마지막 단계: " + stage)
    if code is not None:
        print("  결과: 종료 코드 %s%s" % (code, " · " + failed if failed else "")); return EX_OK if code == 0 else EX_WARN
    if head.strip() == "active":
        if follow:
            c, st, fl = poll_install(host, None, timeout=timeout, unit=unit, log=log, label=cmdname)
            print("%s: %s" % ("성공" if c == 0 else "실패", st or "?")); return EX_OK if c == 0 else EX_WARN
        print("  진행 중입니다. 끝까지 따라가려면 `%s %s status … --follow`" % (TOOL, cmdname)); return EX_OK
    print("  기록된 %s 작업이 없습니다." % label if not stage else "  작업이 중단됐습니다(종료 기록 없음)."); return EX_WARN


def build_parser():
    p = argparse.ArgumentParser(prog=TOOL, description="devmaru 여러 서버를 SSH 로 점검(1단계: 읽기 전용)")
    p.add_argument("--version", action="version", version="%s %s" % (TOOL, TOOL_VERSION))
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="인벤토리 서버 목록").set_defaults(fn=cmd_list)
    sub.add_parser("doctor", help="관리자 PC 쪽 점검").set_defaults(fn=cmd_doctor)
    t = sub.add_parser("trust", help="SSH 호스트 키 지문 확인·등록"); t.add_argument("host"); t.set_defaults(fn=cmd_trust)
    for name, fn, h in (("status", cmd_status, "서버별 상태"), ("check", cmd_check, "갱신 가능 여부"), ("watch", cmd_watch, "변화만 알림")):
        s = sub.add_parser(name, help=h)
        s.add_argument("--hosts", default="", help="쉼표로 구분한 서버 이름(기본: 전체)")
        s.add_argument("--parallel", type=int, default=4, help="동시 조회 수(읽기 전용, 기본 4)")
        if name != "watch":
            s.add_argument("--json", action="store_true", help="JSON 으로 출력")
        else:
            s.add_argument("--once", action="store_true", help="한 번만 수집하고 끝(필수)")
        s.set_defaults(fn=fn)
    ins = sub.add_parser("install", help="원격 설치(계획 우선)")
    ins.add_argument("action", choices=("plan", "apply", "status", "resume")); ins.add_argument("host")
    ins.add_argument("--config", help="설치 설정 파일(KEY=값, 비밀 없음)"); ins.add_argument("--kit", help="릴리스 tarball(+ .sha256, 선택 .sig)")
    ins.add_argument("--allow-unsigned", action="store_true", help="서명 없는 릴리스를 경고와 함께 허용")
    ins.add_argument("--skip-dns", action="store_true", help="DNS 점검 건너뜀(내부망·시험용)")
    ins.add_argument("--timeout", type=int, default=7200, help="진행 따라가기 최대 초(서버에서는 계속 진행)")
    ins.add_argument("--follow", action="store_true", help="status: 진행 중이면 끝날 때까지 따라간다")
    ins.set_defaults(fn=cmd_install)
    up = sub.add_parser("update", help="킷 갱신(canary 먼저, 서버별 확인)")
    up.add_argument("action", choices=("plan", "apply", "status")); up.add_argument("--hosts", default="", help="쉼표로 구분한 서버 이름(기본: 전체)")
    up.add_argument("--kit", help="새 릴리스 tarball(+ .sha256, 선택 .sig)"); up.add_argument("--allow-unsigned", action="store_true")
    up.add_argument("--force", action="store_true", help="같은 버전을 다시 적용"); up.add_argument("--rolling", type=int, default=1, help="canary 뒤 한 번에 N대(기본 1)")
    up.add_argument("--timeout", type=int, default=7200); up.add_argument("--follow", action="store_true"); up.set_defaults(fn=cmd_update)
    mb = sub.add_parser("members", help="회원 컨테이너 갱신(작업 중인 회원이 있으면 거부)")
    mb.add_argument("action", choices=("plan", "apply", "status")); mb.add_argument("host")
    mb.add_argument("--timeout", type=int, default=3600); mb.add_argument("--follow", action="store_true"); mb.set_defaults(fn=cmd_members)
    vr = sub.add_parser("verify-release", help="릴리스 tarball 의 sha256·서명 검증")
    vr.add_argument("tarball"); vr.add_argument("--allow-unsigned", action="store_true"); vr.set_defaults(fn=cmd_verify_release)
    lg = sub.add_parser("log", help="이 도구의 감사 로그"); lg.add_argument("--tail", type=int, default=50); lg.set_defaults(fn=cmd_log)
    return p


def main(argv=None):
    try:
        sys.stdout.reconfigure(line_buffering=True)   # 파일·파이프로 보낼 때도 진행 줄이 바로 보이게(cron·nohup 용)
    except (AttributeError, ValueError):
        pass
    args = build_parser().parse_args(argv)
    if getattr(args, "parallel", 1) < 1 or getattr(args, "parallel", 1) > 16:
        print("--parallel 은 1~16", file=sys.stderr); return EX_USAGE
    try:
        return args.fn(args)
    except InventoryError as e:
        print("실패: " + str(e), file=sys.stderr); return EX_USAGE
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
