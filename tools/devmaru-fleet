def rotate_log(host, log, interactive=False):
    """새 작업을 시작하기 전에 이전 로그를 .prev 로 옮긴다 — 이전 작업의 FLEET_EXIT 를 현재 결과로 오인하지 않게."""
    rc, out = run_sudo(host, ["sh", "-c", "mv -f %s %s.prev 2>/dev/null; : > %s" % (log, log, log)], interactive)
    return rc == 0


def poll_install(host, state, timeout=7200, interval=10, out=print, unit=None, log=None, label="install"):
    """분리 실행된 설치를 따라간다. Ctrl-C 로 끊어도 서버에서는 계속 돈다(`install status` 로 다시 붙는다)."""
    unit = unit or REMOTE_UNIT; log = log or REMOTE_LOG
    t0 = time.time(); last = None; idle = 0
    while time.time() - t0 < timeout:
        r = ssh_run(host, ["sh", "-c", "systemctl is-active %s 2>/dev/null; echo ---; tail -n 300 %s 2>/dev/null" % (unit, log)])
        if r.kind in ("unreachable", "timeout", "no_trust"):
            out("  (연결 끊김 — 서버에서는 작업이 계속됩니다. 다시 붙으려면 `%s %s status %s --follow`)" % (TOOL, label, host.name))
            time.sleep(interval); continue
        head, _, text = r.out.partition("---\n")
        active = head.strip() == "active"
        stage, code, failed = stage_progress(text)
        if stage and stage != last:
            out("  [%s] · %s" % (host.name, stage) if label != "install" else "  · " + stage); last = stage
        if code is not None:
            return code, stage, failed
        idle = 0 if active else idle + 1
        if idle >= 2 and stage:   # 작업이 끝났는데 종료 기록이 없다 = 중단(서버 재부팅·강제 중지 등)
            return None, stage, "설치 작업이 중단됐습니다(서버 재부팅이나 강제 중지일 수 있음)"
        if not active and not text.strip() and time.time() - t0 > 60:
            return None, stage, "설치 작업과 로그를 찾지 못했습니다"
        time.sleep(interval)
    return None, last, "시간 초과(%ds) — 서버에서는 계속 진행 중일 수 있습니다" % timeout


def remote_preflight(host, cfg):
    r = ssh_run(host, ["sh", "-c", PREFLIGHT_SH])
    if r.kind != "ok" and r.kind != "no_sudo":
        return None, [("실패", one_line(r.err) or r.kind)]
    k = kv_lines(r.out); notes = []
    def lvl(ok, okmsg, badmsg, warn=False):
        notes.append(("성공" if ok else ("경고" if warn else "실패"), okmsg if ok else badmsg))
    lvl(k.get("arch") == "x86_64", "x86_64", "x86_64 만 지원합니다(현재 %s)" % k.get("arch"))
    lvl(k.get("os") == "ubuntu 26.04", "Ubuntu 26.04", "Ubuntu 26.04 에서만 검증됨(현재 %s)" % k.get("os"), warn=True)
    mem = int(k.get("mem_gb") or 0); lvl(mem >= 7, "메모리 %dGB" % mem, "메모리 %dGB — 최소 8GB 필요" % mem)
    disk = int(k.get("disk_gb") or 0); lvl(disk >= 30, "/srv 여유 %dGB" % disk, "/srv 여유 %dGB — 최소 30GB 필요" % disk)
    lvl(not k.get("ports"), "80·443 비어 있음", "80/443 사용 중(%s) — 설치기가 다시 점검합니다" % k.get("ports"), warn=True)
    lvl(k.get("installed") == "no", "이미 설치된 흔적 없음", "이미 devmaru 가 설치돼 있습니다(/opt/devmaru-kit) — 갱신은 update 를 쓰세요")
    lvl(k.get("sudo_nopass") == "yes", "sudo 비밀번호 없이 가능", "sudo 에 비밀번호가 필요합니다 — 적용 때 터미널에서 직접 입력해야 합니다", warn=True)
    lvl(k.get("python", "").startswith("Python 3"), k.get("python", ""), "python3 가 필요합니다")
    return k, notes


def cmd_install(args):
    host = select_hosts(load_inventory(), args.host)[0]
    sub = args.action
    if sub == "status":
        return install_status(host, follow=args.follow, timeout=args.timeout)
    if sub == "resume":
        return install_resume(host, args)
    if not args.config or not args.kit:
        print("실패: install %s 에는 --config <설정 파일> 과 --kit <릴리스 tarball> 이 필요합니다" % sub, file=sys.stderr); return EX_USAGE
    cfg = read_install_config(args.config, host)
    print("== %s install %s — %s (%s:%d)" % (TOOL, sub, host.name, host.address, host.port))
    print("설정: 접두어 %s · 서비스 '%s' · 도메인 %s · 모듈 %s" % (cfg["PFX"], one_line(cfg["BRAND"], 40), cfg["DOMAIN"], cfg.get("MODULES", "(기본)")))
    ok, msgs = verify_release(args.kit, args.allow_unsigned)
    for m in msgs:
        print(m)
    if not ok:
        audit("install-" + sub, host.name, "plan" if sub == "plan" else "apply", "verify-fail"); return EX_WARN
    k, notes = remote_preflight(host, cfg)
    if k is None:
        print("실패: 서버에 접속하지 못했습니다: %s" % notes[0][1]); audit("install-" + sub, host.name, sub, "unreachable"); return EX_UNREACH
    bad = False
    for lv, msg in notes:
        print("%s: %s" % (lv, msg)); bad = bad or lv == "실패"
    tarname = "kit.tar.gz"; cfgname = "site-config.env"; rdir = REMOTE_TMP % host.user
    ok1, e1 = upload(host, args.kit, rdir, tarname); ok2, e2 = upload(host, args.config, rdir, cfgname)
    if not (ok1 and ok2):
        print("실패: 킷/설정 업로드 실패: %s" % (e1 or e2)); return EX_UNREACH
    r = ssh_run(host, ["sha256sum", "%s/%s" % (rdir, tarname)])
    if r.rc != 0 or r.out.split()[:1] != [sha256_file(args.kit)]:
        print("실패: 올린 킷의 sha256 이 로컬과 다릅니다(전송 오류)"); return EX_WARN
    print("성공: 킷 업로드·sha256 일치(%s/%s)" % (rdir, tarname))
    inter = sys.stdin.isatty() and sys.stdout.isatty()
    plan_cmd = ["sh", "-c", "mkdir -p {d}/kit && tar -xzf {d}/{t} -C {d}/kit --strip-components=1 && python3 {d}/kit/bin/devmaru-install --config {d}/{c} --plan --skip-dns --yes".format(d=rdir, t=tarname, c=cfgname)]
    rc, out = run_sudo(host, plan_cmd, inter)
    print("\n── 서버에서 devmaru-install --plan (아무것도 설치되지 않음) ──")
    for line in clean(out).splitlines()[-14:]:
        print("  " + line)
    if rc != 0:
        print("실패: 원격 계획이 실패했습니다(종료 코드 %s)" % rc); bad = True
    if sub == "plan":
        audit("install-plan", host.name, "plan", "fail" if bad else "ok")
        print("\n계획만 보여 드렸습니다. 서버에는 %s 에 올린 파일 외에 아무것도 설치되지 않았습니다." % rdir)
        return EX_WARN if bad else EX_OK
    # apply
    if bad:
        print("\n실패 항목이 있어 적용하지 않습니다. 위 내용을 해결한 뒤 다시 실행하세요."); audit("install-apply", host.name, "apply", "blocked"); return EX_WARN
    print("\n이 서버에 devmaru 를 **설치**합니다. 서버 이름 `%s` 을(를) 그대로 입력하세요." % host.name)
    try:
        typed = input("입력: ").strip()
    except EOFError:
        typed = ""
    if typed != host.name:
        print("취소했습니다. 아무것도 설치하지 않았습니다."); audit("install-apply", host.name, "apply", "cancel"); return EX_WARN
    skip = " --skip-dns" if args.skip_dns else ""
    launch = ["systemd-run", "--unit=" + REMOTE_UNIT, "--collect", "--property=StandardOutput=append:" + REMOTE_LOG, "--property=StandardError=inherit",
              "sh", "-c", "DEVMARU_LOCAL={d}/{t} bash {d}/kit/install.sh --config {d}/{c} --yes{s}; echo FLEET_EXIT=$?".format(d=rdir, t=tarname, c=cfgname, s=skip)]
    rc, out = run_sudo(host, launch, inter)
    if rc != 0:
        print("실패: 설치를 시작하지 못했습니다: %s" % one_line(out, 200)); audit("install-apply", host.name, "apply", "start-fail"); return EX_WARN
    save_install_state(host.name, {"unit": REMOTE_UNIT, "log": REMOTE_LOG, "started": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "kit_sha": sha256_file(args.kit)})
    audit("install-apply", host.name, "apply", "started")
    print("설치를 시작했습니다(서버에서 분리 실행 — 연결이 끊겨도 계속됩니다). 진행:")
    code, stage, failed = poll_install(host, load_install_state(host.name), timeout=args.timeout)
    return finish_install(host, code, stage, failed)


def finish_install(host, code, stage, failed):
    if code == 0:
        r = ssh_run(host, ["sudo", "-n", "/usr/local/sbin/%s-doctor" % host.prefix, "--json"])
        d = parse_json(r.out)
        res = "doctor %s(경고 %s)" % (d.get("status"), d.get("warnings")) if d else "doctor 는 sudo 권한이 필요해 확인하지 못했습니다(`%s status` 로 확인)" % TOOL
        print("성공: 설치가 끝났습니다 — %s" % res); audit("install-apply", host.name, "apply", "ok"); return EX_OK
    print("실패: 설치가 끝나지 않았습니다 — %s%s" % (stage or "?", " · " + failed if failed else ""))
    print("  원인 확인 후 이어서: `%s install resume %s`" % (TOOL, host.name)); audit("install-apply", host.name, "apply", "fail-%s" % code); return EX_WARN


def install_status(host, follow=False, timeout=7200):
    st = load_install_state(host.name)
    r = ssh_run(host, ["sh", "-c", "systemctl is-active %s 2>/dev/null; echo ---; tail -n 300 %s 2>/dev/null" % (REMOTE_UNIT, REMOTE_LOG)])
    if r.kind in ("unreachable", "timeout", "no_trust"):
        print("서버에 닿지 못했습니다: %s" % one_line(r.err)); return EX_UNREACH
    head, _, log = r.out.partition("---\n")
    stage, code, failed = stage_progress(log)
    print("서버 %s — 설치 작업 %s%s" % (host.name, head.strip() or "없음", " · 시작 " + st["started"] if st else ""))
    if stage:
        print("  마지막 단계: " + stage)
    if code is not None:
        print("  결과: 종료 코드 %s%s" % (code, " · " + failed if failed else "")); return EX_OK if code == 0 else EX_WARN
    if head.strip() == "active":
        if follow:
            print("  끝까지 따라갑니다(Ctrl-C 로 끊어도 서버에서는 계속됩니다):")
            code, stage, failed = poll_install(host, st, timeout=timeout)
            return finish_install(host, code, stage, failed)
        print("  진행 중입니다. 끝까지 따라가려면 `%s install status %s --follow`" % (TOOL, host.name)); return EX_OK
    if stage:
        print("  작업이 중단됐습니다(종료 기록 없음). 이어서: `%s install resume %s`" % (TOOL, host.name)); return EX_WARN
    print("  기록된 설치가 없습니다."); return EX_WARN


def install_resume(host, args):
    r = ssh_run(host, ["sh", "-c", "systemctl is-active %s 2>/dev/null; echo ---; tail -n 300 %s 2>/dev/null" % (REMOTE_UNIT, REMOTE_LOG)])
    head, _, log = r.out.partition("---\n")
    stage, code, failed = stage_progress(log)
    if head.strip() == "active":
        print("설치가 아직 진행 중입니다(%s). 끝난 뒤 실패했다면 다시 실행하세요." % (stage or "?")); return EX_WARN
    if code == 0 or (code is None and not stage):
        print("이어서 할 실패·중단된 설치가 없습니다(결과: %s)." % ("성공" if code == 0 else "기록 없음")); return EX_WARN
    print("직전 설치가 %s: %s%s" % ("실패했습니다" if code is not None else "중단됐습니다", stage or "?", " · " + failed if failed else ""))
    print("서버 이름 `%s` 을(를) 그대로 입력하면 실패한 단계부터 이어서 실행합니다(--resume)." % host.name)
    try:
        typed = input("입력: ").strip()
    except EOFError:
        typed = ""
    if typed != host.name:
        print("취소했습니다."); return EX_WARN
    inter = sys.stdin.isatty() and sys.stdout.isatty()
    rotate_log(host, REMOTE_LOG, inter)   # 직전 실패의 FLEET_EXIT 가 남아 있으면 이어서 하는 작업의 결과로 오인된다
    cmd = ["systemd-run", "--unit=" + REMOTE_UNIT, "--collect", "--property=StandardOutput=append:" + REMOTE_LOG, "--property=StandardError=inherit",
           "sh", "-c", "python3 /opt/devmaru-kit/bin/devmaru-install --config /etc/{p}/site.env --yes --resume --skip-dns; echo FLEET_EXIT=$?".format(p=host.prefix)]
    rc, out = run_sudo(host, cmd, inter)
    if rc != 0:
        print("실패: 이어서 시작하지 못했습니다: %s" % one_line(out, 200)); return EX_WARN
    audit("install-resume", host.name, "apply", "started")
    code, stage, failed = poll_install(host, None, timeout=args.timeout)
    return finish_install(host, code, stage, failed)


