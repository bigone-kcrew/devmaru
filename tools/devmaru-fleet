               "N8N_WORKFLOWS", "WORKSPACE_OTHERS", "SHARED_DEFAULT", "GOLDEN_VOICE", "GOLDEN_OFFICE", "TLS_MODE", "SSH_PORT", "SMB_TRANSPORTS",
