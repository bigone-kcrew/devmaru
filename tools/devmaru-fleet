def _fingerprints(scan_text):
    out = []
    for line in scan_text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        p = subprocess.run(["ssh-keygen", "-lf", "-"], input=line + "\n", stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, encoding="utf-8", errors="replace")
        out.append(clean(p.stdout).strip())
    return out


