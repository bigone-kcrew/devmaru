def sha256_file(path):
    import hashlib
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def signers_path():
    env = os.environ.get("DEVMARU_FLEET_SIGNERS")
    return Path(env) if env else config_dir() / "release-allowed-signers"


def verify_release(tarball, allow_unsigned=False, quiet=False):
    """sha256(필수) + 서명(ssh-keygen -Y verify). 서명이 없으면 --allow-unsigned 가 있어야 통과한다. (ok, 메시지 목록)"""
    msgs, ok = [], True
    t = Path(tarball)
    if not t.is_file():
        return False, ["실패: 파일이 없습니다: %s" % t]
    sumf = Path(str(t) + ".sha256")
    if not sumf.is_file():
        return False, ["실패: %s 가 없습니다(릴리스의 sha256 파일이 필요합니다)" % sumf.name]
    want = sumf.read_text(encoding="utf-8", errors="replace").split()[0].lower() if sumf.read_text(encoding="utf-8", errors="replace").split() else ""
    have = sha256_file(t)
    if want != have:
        return False, ["실패: sha256 불일치(파일 %s… ≠ 기록 %s…) — 받은 파일이 손상됐거나 바뀌었습니다" % (have[:12], want[:12])]
    msgs.append("성공: sha256 일치(%s…)" % have[:16])
    sig = Path(str(t) + ".sig"); signers = signers_path()
    if sig.is_file() and signers.is_file():
        with open(t, "rb") as f:
            p = subprocess.run(["ssh-keygen", "-Y", "verify", "-f", str(signers), "-I", SIGN_NS, "-n", SIGN_NS, "-s", str(sig)],
                               stdin=f, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if p.returncode == 0:
            msgs.append("성공: 서명 확인(%s)" % one_line(p.stdout.decode("utf-8", "replace"), 100))
        else:
            return False, msgs + ["실패: 서명이 올바르지 않습니다 — %s" % one_line(p.stderr.decode("utf-8", "replace"), 120)]
    else:
        why = "서명 파일(.sig) 없음" if not sig.is_file() else "신뢰하는 서명자 파일 없음(%s)" % signers
        if allow_unsigned:
            msgs.append("경고: 서명되지 않은 릴리스를 허용했습니다(%s)" % why)
        else:
            return False, msgs + ["실패: 서명을 확인할 수 없습니다(%s). 서명 없는 릴리스를 쓰려면 --allow-unsigned" % why]
    return ok, msgs


def read_install_config(path, host):
    """설치 설정 파일(KEY=값). 비밀은 설정 파일에 두지 않는다 — 비밀처럼 보이는 키는 거부."""
    errs, cfg = [], {}
    try:
        text = Path(path).read_text(encoding="utf-8")
    except OSError as e:
        raise InventoryError("설정 파일을 읽지 못했습니다: %s" % one_line(str(e)))
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r"^([A-Z][A-Z0-9_]*)=(.*)$", line)
        if not m:
            errs.append("%d행: KEY=값 형식이 아닙니다" % n); continue
        k, v = m.group(1), m.group(2)
        if SECRETISH_KEY.search(k):
            errs.append("%d행: %s — 비밀(비밀번호·토큰·키)은 설정 파일에 넣지 않습니다(서버에서 따로 설정)" % (n, k)); continue
        if k not in CONFIG_KEYS:
            errs.append("%d행: 알 수 없는 설정 키 %s" % (n, k)); continue
        try:
            parts = shlex.split(v)
        except ValueError:
            errs.append("%d행: 따옴표가 맞지 않습니다" % n); continue
        cfg[k] = " ".join(parts)
    for need in ("PFX", "BRAND", "DOMAIN", "ADMIN_USER", "ADMIN_EMAIL"):
        if not cfg.get(need):
            errs.append("필수 설정이 없습니다: %s" % need)
    if cfg.get("PFX") and cfg["PFX"] != host.prefix:
        errs.append("설정의 PFX(%s)가 인벤토리 접두어(%s)와 다릅니다" % (cfg["PFX"], host.prefix))
    if cfg.get("ADMIN_USER") and not USER_RE.match(cfg["ADMIN_USER"]):
        errs.append("ADMIN_USER 형식 오류")
    if errs:
        raise InventoryError("설치 설정 오류(%s):\n  - %s" % (path, "\n  - ".join(errs)))
    return cfg


