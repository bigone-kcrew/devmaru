def ssh_tty(host, remote, timeout=None):
    """대화형 sudo(비밀번호를 사람이 입력)용: 터미널을 그대로 연결한다. 도구는 비밀번호를 다루지 않는다."""
    opts = [o for o in SSH_OPTS if o != "-n"]
    cmd = ["ssh"] + ssh_config_args(host) + ["-t"] + opts + ["-p", str(host.port), "--", "%s@%s" % (host.user, host.address), remote_string(remote)]
    return subprocess.run(cmd, timeout=timeout).returncode


def run_sudo(host, argv, interactive):
    """sudo 가 비밀번호 없이 되면 그대로, 아니면 터미널이 있을 때만 `ssh -t`(사람이 입력). (rc, out)"""
    r = ssh_run(host, ["sudo", "-n"] + argv, timeout=3600)
    if r.kind != "no_sudo":
        return r.rc, r.out
    if not interactive:
        return 1, "sudo 비밀번호가 필요합니다. 터미널에서 직접 실행하거나, 이 서버 계정에 비밀번호 없는 sudo 를 설정하세요."
    return ssh_tty(host, ["sudo"] + argv), ""


def upload(host, local, remote_dir, remote_name):
    """ssh 로 파일을 올린다(권한 0600). remote_dir/remote_name 은 이 도구가 만든 고정 경로."""
    cmd = ["ssh"] + ssh_config_args(host) + [o for o in SSH_OPTS if o != "-n"] + ["-p", str(host.port), "--", "%s@%s" % (host.user, host.address),
           "umask 077; mkdir -p %s && cat > %s/%s" % (remote_dir, remote_dir, remote_name)]
    with open(local, "rb") as f:
        p = subprocess.run(cmd, stdin=f, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=1800)
    return p.returncode == 0, clean(p.stderr, 400)


def stage_progress(text):
    """설치 로그에서 마지막 단계·결과를 읽는다."""
    stage = None; exit_code = None; failed = None
    for line in clean(text).splitlines():
        m = re.match(r"^\[(\d+)/(\d+)\]\s+(.*)$", line.strip())
        if m:
            stage = "%s/%s %s" % (m.group(1), m.group(2), m.group(3))
        m = re.match(r"^FLEET_EXIT=(\d+)$", line.strip())
        if m:
            exit_code = int(m.group(1))
        if "설치 중단" in line or line.strip().startswith("ERROR"):
            failed = one_line(line, 100)
    return stage, exit_code, failed


