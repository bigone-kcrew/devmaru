#!/usr/bin/env python3
"""devmaru-fleet — 관리자 PC 에서 여러 devmaru 서버를 SSH 로 점검한다 (1단계: 읽기 전용).

  devmaru-fleet list                          인벤토리 서버 목록
  devmaru-fleet doctor                        관리자 PC 쪽 점검(ssh·호스트 키·키·인벤토리·Python)
  devmaru-fleet trust <서버>                  SSH 호스트 키 지문을 보여 주고, 서버 이름을 직접 입력하면 known_hosts 에 등록
  devmaru-fleet status [--hosts a,b] [--json] 서버별 상태(doctor·회원 READY/BUSY 집계·정비 락·킷 버전)
  devmaru-fleet check  [--hosts a,b] [--json] 갱신 가능 여부(update --check · golden check · service-update --all --check)
  devmaru-fleet watch --once [--hosts a,b]    status 를 한 번 모아 직전 결과와 비교, 달라진 것만 출력(cron/작업 스케줄러용)
  devmaru-fleet log [--tail N]                이 도구의 감사 로그

이 단계는 **아무것도 바꾸지 않는다**: 서버에서는 읽기 전용 명령(`--json`·`--check`·`--plan`·`status`)만 실행한다.
서버에는 새 프로그램을 설치하지 않는다. 비밀번호·키·sudo 비밀번호를 읽거나 저장하지 않는다(ssh-agent 와 시스템 ssh 를 쓴다).
서버 쪽은 `agent` 모듈의 제한 sudo(`sudo -n`, 허용 목록의 정확한 명령줄)가 필요하다. 없으면 «권한 없음» 으로 표시한다.

인벤토리: `~/.config/devmaru-fleet/hosts.toml`(Windows `%APPDATA%\\devmaru-fleet\\hosts.toml`, `DEVMARU_FLEET_INVENTORY` 로 변경).
Python 3.11 미만이면 같은 내용을 INI 형식(`hosts.ini`)으로 읽는다. 비밀은 넣지 않는다.

종료 코드: 0 정상(watch: 변화 없음) · 1 경고·변화·실패 있음 · 2 서버에 닿지 못함(불통·호스트 키 미등록 포함) · 64 사용법·인벤토리 오류.
"""
import argparse
import configparser
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

try:  # Python 3.11+
    import tomllib
except ImportError:  # pragma: no cover
    tomllib = None

TOOL = "devmaru-fleet"
TOOL_VERSION = "0.1.0"
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")
ADDR_RE = re.compile(r"^(?:[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?|\d{1,3}(?:\.\d{1,3}){3})$")
PFX_RE = re.compile(r"^[a-z][a-z0-9-]{0,15}$")
USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
GROUP_RE = re.compile(r"^[A-Za-z0-9_-]{1,32}$")
SSHCFG_RE = re.compile(r"^[A-Za-z0-9_./~:\\-]{1,200}$")
CTRL_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
MAX_OUT = 200_000
EX_OK, EX_WARN, EX_UNREACH, EX_USAGE = 0, 1, 2, 64


# ───────────────────────── 경로 (OS 별 기본값 한 곳) ─────────────────────────
def _is_windows():
    return os.name == "nt"


def config_dir():
    if _is_windows():
        return Path(os.environ.get("APPDATA", str(Path.home()))) / "devmaru-fleet"
    return Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "devmaru-fleet"


def state_dir():
    env = os.environ.get("DEVMARU_FLEET_STATE")
    if env:
        return Path(env)
    if _is_windows():
        return Path(os.environ.get("LOCALAPPDATA", str(Path.home()))) / "devmaru-fleet"
    return Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local" / "state"))) / "devmaru-fleet"


def inventory_path():
    env = os.environ.get("DEVMARU_FLEET_INVENTORY")
    if env:
        return Path(env)
    toml = config_dir() / "hosts.toml"
    ini = config_dir() / "hosts.ini"
    if tomllib is None and ini.exists():
        return ini
    return toml if toml.exists() or not ini.exists() else ini


# ───────────────────────── 출력 안전 ─────────────────────────
def clean(text, limit=MAX_OUT):
    """원격 출력은 신뢰하지 않는다: 깨진 UTF-8 은 대체, 제어 문자 제거, 길이 제한."""
    if isinstance(text, bytes):
        text = text.decode("utf-8", errors="replace")
    return CTRL_RE.sub("", text)[:limit]


def one_line(text, limit=120):
    return " ".join(clean(text, 4000).split())[:limit]


# ───────────────────────── 인벤토리 ─────────────────────────
class InventoryError(Exception):
    pass


class Host:
    def __init__(self, name, address, port=22, user="admin", prefix="devmaru", group="", canary=False, domain="", ssh_config=""):
        self.name, self.address, self.port, self.user = name, address, port, user
        self.prefix, self.group, self.canary, self.domain, self.ssh_config = prefix, group, canary, domain, ssh_config

    def known_hosts_name(self):
        return self.address if self.port == 22 else "[%s]:%d" % (self.address, self.port)


def _load_raw(path):
    if path.suffix == ".ini" or tomllib is None:
        cp = configparser.ConfigParser(interpolation=None)
        with open(path, encoding="utf-8") as f:
            cp.read_file(f)
        raw = {"defaults": dict(cp["defaults"]) if cp.has_section("defaults") else {}, "hosts": {}}
        for sec in cp.sections():
            if sec.startswith("hosts."):
                raw["hosts"][sec[len("hosts."):]] = dict(cp[sec])
        return raw
    with open(path, "rb") as f:
        return tomllib.load(f)


def _boolean(v):
    if isinstance(v, bool):
        return v
    return str(v).strip().lower() in ("1", "true", "yes", "on")


def load_inventory(path=None):
    path = path or inventory_path()
    if not path.exists():
        raise InventoryError("인벤토리 파일이 없습니다: %s\n예시는 docs/FLEET.md 를 보세요(서버 이름·주소·포트·접두어만, 비밀 없음)." % path)
    try:
        raw = _load_raw(path)
    except Exception as e:  # 문법 오류 등
        raise InventoryError("인벤토리를 읽지 못했습니다(%s): %s" % (path, one_line(str(e))))
    d = raw.get("defaults", {}) or {}
    hosts, errs = [], []
    table = raw.get("hosts", {}) or {}
    if not isinstance(table, dict) or not table:
        raise InventoryError("인벤토리에 [hosts.<이름>] 항목이 없습니다: %s" % path)
    for name, h in table.items():
        h = {**d, **(h or {})}
        e0 = len(errs)
        if not NAME_RE.match(str(name)):
            errs.append("서버 이름 형식 오류: %r (소문자·숫자·하이픈 1~32자)" % name)
        addr = str(h.get("address", ""))
        if not ADDR_RE.match(addr):
            errs.append("%s: address 형식 오류: %r" % (name, addr))
        try:
            port = int(h.get("port", 22))
            if not 1 <= port <= 65535:
                raise ValueError
        except (TypeError, ValueError):
            errs.append("%s: port 는 1~65535 정수여야 합니다" % name); port = 22
        user = str(h.get("user", "admin"))
        if not USER_RE.match(user):
            errs.append("%s: user 형식 오류: %r" % (name, user))
        prefix = str(h.get("prefix", "devmaru"))
        if not PFX_RE.match(prefix):
            errs.append("%s: prefix 형식 오류: %r" % (name, prefix))
        group = str(h.get("group", ""))
        if group and not GROUP_RE.match(group):
            errs.append("%s: group 형식 오류: %r" % (name, group))
        domain = str(h.get("domain", ""))
        if domain and not ADDR_RE.match(domain):
            errs.append("%s: domain 형식 오류: %r" % (name, domain))
        sshcfg = str(h.get("ssh_config", ""))
        if sshcfg and not SSHCFG_RE.match(sshcfg):
            errs.append("%s: ssh_config 경로 형식 오류: %r" % (name, sshcfg))
        if len(errs) == e0:
            hosts.append(Host(str(name), addr, port, user, prefix, group, _boolean(h.get("canary", False)), domain, sshcfg))
    if errs:
        raise InventoryError("인벤토리 오류:\n  - " + "\n  - ".join(errs))
    hosts.sort(key=lambda x: (not x.canary, x.name))  # canary 먼저
    return hosts


def select_hosts(hosts, spec):
    if not spec:
        return hosts
    want = [s.strip() for s in spec.split(",") if s.strip()]
    known = {h.name: h for h in hosts}
    bad = [w for w in want if w not in known]
    if bad:
        raise InventoryError("인벤토리에 없는 서버: %s" % ", ".join(bad))
    return [known[w] for w in want]


# ───────────────────────── 감사 로그 ─────────────────────────
def audit(kind, host, mode, rc):
    """시각 · 사용자 · 서버 · 명령 종류 · 계획/적용 · 종료 코드. 원격 출력·비밀은 기록하지 않는다."""
    try:
        d = state_dir(); d.mkdir(parents=True, exist_ok=True)
        p = d / "audit.log"
        line = "%s\t%s\t%s\t%s\t%s\t%s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S%z"), os.environ.get("USER") or os.environ.get("USERNAME") or "?", host, kind, mode, rc)
        with open(p, "a", encoding="utf-8") as f:
            f.write(line)
        if not _is_windows():
            os.chmod(p, 0o600)
    except OSError:
        pass  # 감사 로그를 못 써도 읽기 전용 점검은 계속한다


# ───────────────────────── SSH ─────────────────────────
class Result:
    def __init__(self, rc, out="", err="", kind="ok"):
        self.rc, self.out, self.err, self.kind = rc, out, err, kind  # kind: ok | unreachable | no_trust | no_sudo | timeout


SSH_OPTS = ["-n", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes", "-o", "ConnectTimeout=10",
            "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3", "-o", "LogLevel=ERROR"]


def ssh_config_args(host):
    return ["-F", os.path.expanduser(host.ssh_config)] if host.ssh_config else []


def known_hosts_file(host):
    """ssh 가 실제로 쓰는 known_hosts(UserKnownHostsFile) 첫 항목. `ssh -G` 로 읽고, 실패하면 ~/.ssh/known_hosts."""
    try:
        p = subprocess.run(["ssh"] + ssh_config_args(host) + ["-G", "-p", str(host.port), "--", "%s@%s" % (host.user, host.address)],
                           stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=15)
        for line in clean(p.stdout).splitlines():
            if line.lower().startswith("userknownhostsfile "):
                first = line.split(None, 1)[1].split()[0]
                return Path(os.path.expanduser(first))
    except (OSError, subprocess.SubprocessError):
        pass
    return Path.home() / ".ssh" / "known_hosts"


def remote_string(remote):
    """ssh 는 원격 인자를 공백으로 이어 붙여 원격 셸에 넘긴다 — 공백이 든 인자(sh -c 스크립트 등)가 깨지지 않게 토큰마다 인용해 한 문자열로 보낸다."""
    return " ".join(shlex.quote(str(a)) for a in remote)


def ssh_run(host, remote, timeout=90):
    """remote 는 고정된 토큰 목록(인자 배열) — 사용자 입력을 셸에 보간하지 않는다. prefix 는 인벤토리에서 정규식 검증을 거친다."""
    cmd = ["ssh"] + ssh_config_args(host) + SSH_OPTS + ["-p", str(host.port), "--", "%s@%s" % (host.user, host.address), remote_string(remote)]   # -- 는 목적지 앞(뒤에 두면 원격 명령의 첫 단어가 된다)
    try:
        p = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    except subprocess.TimeoutExpired:
        return Result(255, "", "시간 초과(%ds)" % timeout, "timeout")
    except FileNotFoundError:
        return Result(255, "", "ssh 실행 파일을 찾지 못했습니다", "unreachable")
    out, err = clean(p.stdout), clean(p.stderr, 4000)
    kind = "ok"
    if p.returncode == 255:
        if "REMOTE HOST IDENTIFICATION HAS CHANGED" in err or "Offending" in err:
            kind, err = "no_trust", "호스트 키가 바뀌었습니다(서버 교체이거나 중간자 공격일 수 있음) — 서버 관리자에게 확인하고, 확인 전에는 접속하지 마세요"
        elif "No ED25519 host key is known" in err or "No ECDSA host key is known" in err or "No RSA host key is known" in err or "Host key verification failed" in err:
            kind, err = "no_trust", "호스트 키가 등록되지 않았습니다 — `devmaru-fleet trust %s` 로 지문을 확인하고 등록하세요" % host.name
        else:
            kind = "unreachable"
    elif "a password is required" in err or "I'm afraid I can't do that" in err or "sudo: a terminal is required" in err:
        kind = "no_sudo"
    return Result(p.returncode, out, err, kind)


def sbin(host, cmd, *args):
    return ["sudo", "-n", "/usr/local/sbin/%s-%s" % (host.prefix, cmd)] + list(args)


def bin_(host, cmd, *args):
    return ["sudo", "-n", "/usr/local/bin/%s-%s" % (host.prefix, cmd)] + list(args)


def parse_json(text):
    try:
        d = json.loads(text.strip().splitlines()[-1] if text.strip() else "")
        return d if isinstance(d, dict) else None
    except (ValueError, IndexError):
        return None


# ───────────────────────── 서버 하나 수집 ─────────────────────────
def collect_status(host):
    """읽기 전용 명령 4개. 각각 정확한 명령줄이라 agent 모듈 허용 목록과 일치해야 한다."""
    s = {"name": host.name, "address": host.address, "group": host.group, "canary": host.canary, "state": "ok", "notes": []}
    r = ssh_run(host, ["cat", "/opt/devmaru-kit/VERSION"])
    if r.kind in ("unreachable", "no_trust", "timeout"):
        s["state"] = r.kind
        s["notes"].append(one_line(r.err) or r.kind)
        return s
    s["kit"] = one_line(r.out, 20) if r.rc == 0 else None

    r = ssh_run(host, sbin(host, "doctor", "--json"))
    if r.kind == "no_sudo":
        s["state"] = "no_sudo"; s["notes"].append("권한 없음: agent 모듈의 제한 sudo 가 필요합니다(sudo -n 거부)")
        return s
    d = parse_json(r.out)
    if d is None:
        s["state"] = "error"; s["notes"].append("doctor --json 응답을 읽지 못함(종료 코드 %s)" % r.rc)
    else:
        s["doctor"] = d.get("status")
        s["warnings"] = d.get("warnings", 0)
        s["fails"] = sum(1 for c in d.get("checks", []) if isinstance(c, dict) and c.get("status") == "fail")
        s["brand"] = one_line(str(d.get("brand", "")), 60)
        s["domain"] = one_line(str(d.get("domain", "")), 80)
        if host.domain and s["domain"] and s["domain"] != host.domain:
            s["state"] = "identity_mismatch"; s["notes"].append("서버 도메인(%s)이 인벤토리(%s)와 다릅니다" % (s["domain"], host.domain))
        elif d.get("status") != "pass" or s["fails"]:
            s["state"] = "fail"
        elif s["warnings"]:
            s["state"] = "warn"

    r = ssh_run(host, bin_(host, "member-update-all", "--json"))
    m = parse_json(r.out) if r.kind != "no_sudo" else None
    if m:
        s["members"] = m.get("summary", {})
        s["member_result"] = m.get("result")
        s["image"] = m.get("image")
    elif r.kind == "no_sudo":
        s["notes"].append("회원 집계 권한 없음")

    r = ssh_run(host, sbin(host, "maintenance", "status", "--json"))
    mt = parse_json(r.out) if r.kind != "no_sudo" else None
    if mt:
        s["maintenance"] = mt.get("state")
        if mt.get("state") == "busy":
            s["notes"].append("정비 작업 실행 중: " + one_line(str(mt.get("holder", "")), 60))
    else:
        s["notes"].append("정비 락 상태 없음(서버 키트가 1.3.0 선행 과제 이전 버전일 수 있음)")
    return s


def collect_check(host):
    c = {"name": host.name, "state": "ok", "notes": []}
    v = ssh_run(host, ["cat", "/opt/devmaru-kit/VERSION"])
    if v.kind in ("unreachable", "no_trust", "timeout"):
        c["state"] = v.kind; c["notes"].append(one_line(v.err)); return c
    c["kit"] = one_line(v.out, 20) if v.rc == 0 else None   # 현재 킷은 파일에서(update --check 는 릴리스 주소가 없으면 실패한다)
    r = ssh_run(host, sbin(host, "update", "--check"))
    if r.kind in ("unreachable", "no_trust", "timeout"):
        c["state"] = r.kind; c["notes"].append(one_line(r.err)); return c
    if r.kind == "no_sudo":
        c["state"] = "no_sudo"; c["notes"].append("권한 없음(agent 모듈 필요)"); return c
    m = re.search(r"현재 버전 (\S+) · 받을 릴리스", r.out)
    n = re.search(r"안내: (\d+\.\d+\.\d+) → (\d+\.\d+\.\d+)", r.out)
    c["kit"] = c.get("kit") or (m.group(1) if m else None)
    if n:
        c["update"] = n.group(2)
    elif "이미 최신" in r.out:
        c["update"] = None
    else:
        c["update"] = "unknown"; c["notes"].append("릴리스 조회 실패: " + one_line(r.out + r.err, 80))
    r = ssh_run(host, sbin(host, "golden", "check"))
    g = re.search(r"새것\s+(\d+)\s+·\s+움직임\s+(\d+)\s+·\s+같음\s+(\d+)\s+·\s+실패\s+(\d+)", r.out)
    c["golden_new"] = int(g.group(1)) if g else None
    if g and int(g.group(4)):
        c["notes"].append("golden check 실패 %s건" % g.group(4))
    r = ssh_run(host, sbin(host, "service-update", "--all", "--check"))
    c["service_update_rc"] = r.rc if r.kind == "ok" else None
    if c.get("update") not in (None,) or (c.get("golden_new") or 0) > 0:
        c["state"] = "updates"
    return c


def run_parallel(fn, hosts, parallel):
    if parallel <= 1 or len(hosts) <= 1:
        return [fn(h) for h in hosts]
    with ThreadPoolExecutor(max_workers=parallel) as ex:
        return list(ex.map(fn, hosts))


# ───────────────────────── 표시 ─────────────────────────
MARK = {"ok": "성공", "warn": "경고", "fail": "실패", "updates": "갱신", "no_sudo": "권한", "unreachable": "불통",
        "no_trust": "신뢰", "timeout": "불통", "error": "오류", "identity_mismatch": "불일치"}


def exit_for(rows):
    st = {r["state"] for r in rows}
    if st & {"unreachable", "no_trust", "timeout"}:
        return EX_UNREACH
    return EX_OK if st <= {"ok"} else EX_WARN


def print_status(rows):
    print("%-14s %-6s %-5s %-8s %-9s %-14s %s" % ("서버", "상태", "경고", "킷", "회원(R/B)", "정비", "비고"))
    for r in rows:
        mem = r.get("members") or {}
        rb = "%s/%s" % (mem.get("ready", "-"), mem.get("busy", "-")) if mem else "-"
        print("%-14s %-6s %-5s %-8s %-9s %-14s %s" % (r["name"] + ("*" if r.get("canary") else ""), MARK.get(r["state"], r["state"]), r.get("warnings", "-"),
              r.get("kit") or "-", rb, r.get("maintenance") or "-", "; ".join(r["notes"])[:90]))
    if any(r.get("canary") for r in rows):
        print("(* = canary)")


def print_check(rows):
    print("%-14s %-6s %-8s %-10s %-10s %s" % ("서버", "상태", "현재 킷", "새 킷", "Golden 새것", "비고"))
    for r in rows:
        u = r.get("update")
        print("%-14s %-6s %-8s %-10s %-10s %s" % (r["name"], MARK.get(r["state"], r["state"]), r.get("kit") or "-",
              "-" if u is None else u, "-" if r.get("golden_new") is None else r["golden_new"], "; ".join(r["notes"])[:80]))


