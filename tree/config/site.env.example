# @@BRAND@@ 설치 설정 — 설치기가 질문으로 만들거나 --config 로 받는다. 접두어는 첫 설치 때 한 번 정하며 이후 바꾸지 않는다.
PFX=devmaru                      # 명령·경로·이미지·네트워크 접두어(소문자 시작, 소문자·숫자 2~12자). 예: devmaru, myorg, team1
BRAND="My Lab"               # 화면에 보이는 서비스 이름
DOMAIN=example.org           # 기본 도메인
PORTAL_LABEL=portal          # 포털 호스트 라벨 → portal.<DOMAIN>
ADMIN_CIDRS="127.0.0.1/32"   # /ops · Cockpit 접근 허용 대역(공백 구분). 관리자 IP 를 추가한다
ADMIN_EMAIL=admin@example.org
MODULES="postgres caddy golden portal n8n files kordoc markitdown crawl4ai"   # 설치할 모듈
