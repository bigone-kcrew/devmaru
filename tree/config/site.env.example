# @@BRAND@@ 설치 설정 — 설치기가 질문으로 만들거나 --config 로 받는다. 접두어는 첫 설치 때 한 번 정하며 이후 바꾸지 않는다.
PFX=devmaru                      # 명령·경로·이미지·네트워크 접두어(소문자 시작, 소문자·숫자 2~12자). 예: devmaru, myorg, team1
BRAND="My Lab"               # 화면에 보이는 서비스 이름
DOMAIN=example.org           # 기본 도메인
PORTAL_LABEL=portal          # 포털 호스트 라벨 → portal.<DOMAIN>
ADMIN_CIDRS="127.0.0.1/32"   # /ops · Cockpit 접근 허용 대역(공백 구분). 관리자 IP 를 추가한다
ADMIN_EMAIL=admin@example.org
MODULES="postgres caddy golden portal n8n files kordoc markitdown crawl4ai"   # 설치할 모듈

# --- 회원 안내 전달 채널(docs/ONBOARDING.md) — 없으면 MAIL_MODE 에서 유도(none→screen · smtp→smtp screen · n8n→n8n screen)
# ONBOARD_CHANNELS="screen smtp link webhook print"   # 공백 구분·순서대로 시도. screen=화면 표시(마지막 보루)·smtp·n8n·link=1회 열람 링크·webhook·print=출력용 안내문
# ONBOARD_LINK_TTL_HOURS=24      # link: 유효 시간(1~168)
# ONBOARD_LINK_PORT=8431         # link: 127.0.0.1 포트(공개는 Caddy 의 /start/*)
# MAIL_LINK_ONLY=0               # smtp + link: 1 이면 메일에 비밀번호·QR 대신 링크만
# ONBOARD_WEBHOOK_FORMAT=generic # webhook: generic · slack · discord · telegram (비밀번호는 싣지 않는다)
# ONBOARD_WEBHOOK_INCLUDE_LINK=0 # 1: 알림에 1회 열람 링크도 싣는다(링크 = 비밀번호와 같은 가치 — 채널 구성원 전원이 열 수 있음). 기본 0
# ONBOARD_WEBHOOK_URL_FILE=/etc/<접두어>/secrets/onboard-webhook-url        # 주소는 설정 파일이 아니라 이 비밀 파일(0600)에
# ONBOARD_WEBHOOK_TELEGRAM_FILE=/etc/<접두어>/secrets/onboard-telegram.env  # telegram: TELEGRAM_BOT_TOKEN=… 와 TELEGRAM_CHAT_ID=… 두 줄
