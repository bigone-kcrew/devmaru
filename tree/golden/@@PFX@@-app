if os.environ.get("DB_NAME"):
    DATABASES = {"default": {"ENGINE": "django.db.backends.postgresql", "NAME": os.environ["DB_NAME"], "USER": os.environ.get("DB_USER", ""),
                             "HOST": os.environ.get("DB_HOST", "postgres"), "PORT": os.environ.get("DB_PORT", "5432"),
                             "OPTIONS": {"passfile": os.path.expanduser("~/.pgpass"), **_schema_opt()}}}
else:
