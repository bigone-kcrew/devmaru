def _schema_opt():
    """DB_SCHEMA 가 있으면 그 스키마를 먼저 쓴다(앱마다 스키마를 나눠 같은 DB 안에서 테이블 이름이 겹치지 않게 — @@PFX@@-app db schema <앱>)."""
    sc = os.environ.get("DB_SCHEMA", "")
    if not sc:
