#!/usr/bin/env bash
# @@PFX@@-app — 컨테이너 안에서 띄운 웹앱(Django·Flask·Node 등)을 https://<이름>.@@DOMAIN@@ 로 공개한다(허용 IP 만). 관리자 승인 없이 규칙 자동 승인, 1분 안에 반영.
#   @@PFX@@-app publish <이름> <포트> [--dir <앱 폴더>] [--basic] [--days N] [--start "<시작 명령>"]   공개 요청(앱은 0.0.0.0:<포트> 로 떠 있어야 함. --basic: Caddy 로그인 추가,
#                           --start: 컨테이너가 다시 만들어진 뒤 앱이 꺼져 있으면 서버가 이 명령으로 다시 시작)
#   @@PFX@@-app status [이름]    결과 보기        @@PFX@@-app list    내 요청 목록        @@PFX@@-app ports    내 포트 범위·규칙
#   @@PFX@@-app password <이름>  --basic 로그인 정보   @@PFX@@-app renew <이름> [--days N]  만료 연장        @@PFX@@-app off <이름>  공개 중지
#   @@PFX@@-app log <이름>       앱 로그(--start 로 시작한 것)    @@PFX@@-app template django|fastapi|node [폴더]  공개용 시작 골격 만들기(Flask 등 다른 프레임워크도 포트·시작 명령만 맞으면 됨)
#   @@PFX@@-app db status|dsn|schema <앱>|backup|psql   내 PostgreSQL(관리자가 발급, 암호는 ~/.pgpass 에서만 읽음 — 출력·파일·코드에 넣지 않는다)
# 공개하면 인터넷(허용 IP)에서 누구나 접속한다(--basic 이 아니면 로그인 없음). 공개 전에 사용자에게 무엇을 공개하는지 먼저 확인받는다.
set -euo pipefail
D=${AI_APP_DIR:-$HOME/.@@PFX@@/apps}
nm(){ [[ ${1:-} =~ ^[a-z][a-z0-9-]{1,30}$ && ! ${1:-} =~ -$ ]] || { echo "이름은 소문자로 시작하는 영문 소문자·숫자·하이픈 2~31자(끝에 - 불가): '${1:-}'" >&2; exit 2; }; }
have(){ [[ -f $D/$1.app ]] || { echo "요청 없음: $1 (@@PFX@@-app list)" >&2; exit 2; }; }
mk(){ mkdir -p "$D"; chmod 700 "$HOME/.@@PFX@@" "$D" 2>/dev/null || true; }
get(){ sed -n "s/^$2=//p" "$D/$1.app" | tail -1; }
# 앱 소스 위치 규칙: /workspace/<프로젝트>/app (앱이 여럿이면 app/<앱이름>) · 공용은 /shared/workspaces/<프로젝트>/app. publish/·.private/ 안은 안 된다.
ROOTS=${AI_APP_ROOTS:-/workspace|/shared/workspaces}; APP_DIR_RE="^($ROOTS)/[A-Za-z0-9_-]+/app(/[A-Za-z0-9._-]+)*\$"
check_app_dir(){ local p; p=$(realpath -e -- "$1" 2>/dev/null) || { echo "--dir 폴더가 없습니다: $1" >&2; return 1; }
  [[ -d $p && $p =~ $APP_DIR_RE ]] || { echo "--dir 는 /workspace/<프로젝트>/app(또는 그 아래) 폴더여야 합니다: $p" >&2; return 1; }
  case "$p/" in */publish/*|*/.private/*) echo "--dir 는 publish/ 나 .private/ 안일 수 없습니다: $p" >&2; return 1;; esac; echo "$p"; }
app_dir_default(){ [[ $PWD =~ $APP_DIR_RE ]] && echo "$PWD" || true; }
case "${1:-}" in
  publish) nm "${2:-}"; n=$2; port=${3:-}; [[ $port =~ ^[0-9]{4,5}$ ]] || { echo "포트 필요: @@PFX@@-app publish $n <포트>  (범위는 @@PFX@@-app ports)" >&2; exit 2; }
    shift 3; access=public; days=""; start=""; dir=""
    while (($#)); do case $1 in --basic) access=basic;; --days) days=${2:-}; shift;; --start) start=${2:-}; shift;; --dir) dir=${2:-}; shift;; *) echo "알 수 없는 옵션: $1" >&2; exit 2;; esac; shift; done
    [[ ${#start} -le 300 && $start != *$'\n'* ]] || { echo "--start 는 한 줄 300자 이하" >&2; exit 2; }
    [[ -z $days || $days =~ ^[0-9]{1,3}$ ]] || { echo "--days 는 숫자" >&2; exit 2; }
    [[ -n $dir ]] || dir=$(app_dir_default)
    if [[ -n $dir ]]; then dir=$(check_app_dir "$dir") || exit 2; fi
    mk; { echo "port=$port"; echo "access=$access"; [[ -n $days ]] && echo "days=$days"; if [[ -f $D/$n.app ]]; then r=$(get "$n" renewed); [[ -n $r ]] && echo "renewed=$r"; [[ -z $start ]] && start=$(get "$n" start); [[ -z $dir ]] && dir=$(get "$n" dir); fi; [[ -n $dir ]] && echo "dir=$dir"; [[ -n $start ]] && echo "start=$start"; true; } > "$D/$n.app.tmp"; mv -f "$D/$n.app.tmp" "$D/$n.app"
    if command -v ss >/dev/null; then
      ls=$(ss -H -ltn "sport = :$port" 2>/dev/null | awk '{print $4}' | head -3 | tr '\n' ' ')
      if [[ -z $ls ]]; then echo "참고: 지금은 $port 포트에서 듣는 프로그램이 없습니다(앱을 먼저 띄우세요)."
      elif [[ $ls != *"0.0.0.0:$port"* && $ls != *"*:$port"* && $ls != *"[::]:$port"* ]]; then echo "경고: 앱이 127.0.0.1 에서만 듣고 있습니다($ls). 0.0.0.0 으로 바꿔야 공개됩니다."; fi
    fi
    echo "요청했습니다: https://$n.@@DOMAIN@@${dir:+  (앱 폴더 $dir)}  (1분 안에 반영 · 결과는 @@PFX@@-app status $n)";;
  status) mk; if [[ -n ${2:-} ]]; then nm "$2"; if [[ -f $D/$2.status ]]; then cat "$D/$2.status"; elif [[ -f $D/$2.app ]]; then echo "아직 반영 전입니다(1분 안에)."; else echo "요청 없음: $2"; fi
         else any=0; for f in "$D"/*.app; do [[ -e $f ]] || continue; any=1; b=$(basename "$f" .app); echo "== $b"; if [[ -f $D/$b.status ]]; then cat "$D/$b.status"; else echo "아직 반영 전입니다(1분 안에)."; fi; done; ((any)) || echo "요청 없음 — @@PFX@@-app publish <이름> <포트>"; fi;;
  list) any=0; for f in "$D"/*.app; do [[ -e $f ]] || continue; any=1; b=$(basename "$f" .app); echo "$b  포트 $(get "$b" port)  $(get "$b" access)  https://$b.@@DOMAIN@@$(d=$(get "$b" dir); [[ -n $d ]] && echo "  폴더 $d")"; done; ((any)) || echo "요청 없음";;
  ports) if [[ -f $D/.ports ]]; then cat "$D/.ports"; else echo "아직 안내 파일이 없습니다(서버가 1분 안에 만듭니다)."; fi;;
  password) nm "${2:-}"; [[ -f $D/$2.secret ]] && cat "$D/$2.secret" || echo "암호 없음(--basic 로 공개한 앱만 있음)";;
  renew) nm "${2:-}"; have "$2"; n=$2; shift 2; days=""; while (($#)); do case $1 in --days) days=${2:-}; shift;; *) echo "알 수 없는 옵션: $1" >&2; exit 2;; esac; shift; done
    p=$(get "$n" port); a=$(get "$n" access); st=$(get "$n" start); dr=$(get "$n" dir); { echo "port=$p"; echo "access=$a"; [[ -n $dr ]] && echo "dir=$dr"; [[ -n $st ]] && echo "start=$st"; if [[ -n $days ]]; then echo "days=$days"; else d=$(get "$n" days); [[ -z $d ]] || echo "days=$d"; fi; echo "renewed=$(date +%s)"; } > "$D/$n.app.tmp"; mv -f "$D/$n.app.tmp" "$D/$n.app"
    echo "연장 요청했습니다(1분 안에 반영 · @@PFX@@-app status $n)";;
  off) nm "${2:-}"; have "$2"; rm -f "$D/$2.app" "$D/$2.status" "$D/$2.secret"; echo "공개 중지 요청: $2 (1분 안에 주소가 닫힙니다). 컨테이너 안의 앱 프로세스는 직접 종료하세요.";;
  log) nm "${2:-}"; [[ -f $D/$2.log ]] && tail -n "${3:-50}" "$D/$2.log" || echo "로그 없음(--start 로 시작한 앱만 기록)";;
  template) kind=${2:-}; dir=${3:-}
    case $kind in django|fastapi|node) ;; *) echo "사용: @@PFX@@-app template django|fastapi|node [폴더]  (프로젝트 폴더 안에서 폴더를 생략하면 ./app 에 만듭니다)" >&2; exit 2;; esac
    if [[ -z $dir ]]; then proj=$(printf '%s' "$PWD" | grep -oE "^($ROOTS)/[A-Za-z0-9_-]+" || true); [[ -n $proj ]] && dir=$proj/app; fi
    [[ -n $dir ]] || { echo "사용: @@PFX@@-app template django|fastapi|node [폴더]  (프로젝트 폴더 안에서 폴더를 생략하면 ./app 에 만듭니다)" >&2; exit 2; }
    [[ ! -e $dir || -z $(ls -A "$dir" 2>/dev/null) ]] || { echo "폴더가 비어 있어야 합니다: $dir" >&2; exit 2; }
    mkdir -p "$dir"; cd "$dir"; port=$(sed -n 's/.*포트 \([0-9]*\)-.*/\1/p' "$D/.ports" 2>/dev/null | head -1 || true); port=${port:-8100}
    printf '__pycache__/\n*.pyc\n.venv/\n.secret_key\n.env\nnode_modules/\nstaticfiles/\ndb.sqlite3\n' > .gitignore
    case $kind in
      django) mkdir -p config
        printf 'django>=5.2,<6\ngunicorn\nwhitenoise\npsycopg[binary]\n' > requirements.txt
        cat > manage.py <<'PY'
