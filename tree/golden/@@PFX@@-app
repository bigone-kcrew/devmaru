import os
import re
import secrets
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent.parent
APP_HOST = os.environ.get("APP_HOST", "")
DEBUG = os.environ.get("DEBUG", "0") == "1"

def _secret_key():
    if os.environ.get("SECRET_KEY"):
