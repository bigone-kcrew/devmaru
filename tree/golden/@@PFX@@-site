#!/usr/bin/env bash
# @@PFX@@-site — 정적 페이지 공개(허용 IP 만).
#   내 프로젝트   /workspace/<프로젝트>/publish/        →  https://<내ID>.@@DOMAIN@@/<프로젝트>/
#   공용 프로젝트 /shared/workspaces/<프로젝트>/publish/  →  https://@@PORTAL_HOST@@/<프로젝트>/
#   @@PFX@@-site init <프로젝트|폴더>   publish/ 폴더를 만든다(만드는 순간부터 공개 대상)     @@PFX@@-site check [프로젝트|폴더]  공개 전 점검(링크·비밀 파일·용량)
#   @@PFX@@-site list                  내 공개 현황(서버가 1분마다 갱신)                       @@PFX@@-site off <프로젝트|폴더>    공개 중지(파일은 그대로)
# 내 것인지 공용인지는 경로로 자동 판별한다(/shared/workspaces/ 아래면 공용). 이름만 주면 내 workspace 에 있으면 내 것, 공용에만 있으면 공용,
# 둘 다 있으면 폴더 경로를 줘야 한다. publish/ 에 둔 파일은 곧 인터넷(허용 IP)에 공개된다 — 링크·.env·키·토큰·개인정보는 두지 않는다.
# 파일을 고치면 바로 반영되고, 새 프로젝트를 만들거나 publish/ 를 지웠다 다시 만들면 최대 1분 뒤에 열린다. 끄려면 off(프로젝트 폴더에 .publish-off).
set -euo pipefail
W=${WORKSPACE:-/workspace}; SH=${AI_SITE_SHARED:-/shared/workspaces}; ME=$(id -un); DOM=@@DOMAIN@@; MAXMB=${AI_SITE_MAX_MB:-50}
APPS=${AI_APP_DIR:-$HOME/.@@PFX@@/apps}
SHARED_RESERVED=" ops skills tools api admin guide ai www static assets app apps docs dev test status mail portal paseo "
nm(){ [[ ${1:-} =~ ^[A-Za-z0-9_-]+$ ]] || { echo "프로젝트 이름은 영문·숫자·_·- 만 가능: '${1:-}'" >&2; exit 2; }; }
resolve(){   # 이름 또는 폴더 경로 → KIND(me|shared) PROJ BASE PD URL
  local a=${1:-} p rel
  [[ -n $a ]] || { echo "프로젝트 이름이나 폴더를 알려 주세요" >&2; exit 2; }
  if [[ $a == */* || $a == . || $a == .. ]]; then
    p=$(realpath -e -- "$a" 2>/dev/null) || { echo "없는 폴더: $a" >&2; exit 2; }
    case $p in "$W"/*) rel=${p#"$W"/}; KIND=me;; "$SH"/*) rel=${p#"$SH"/}; KIND=shared;; *) echo "내 workspace($W)나 공용($SH) 안의 프로젝트 폴더가 아닙니다: $p" >&2; exit 2;; esac
    PROJ=${rel%%/*}
  else
    PROJ=$a
    if [[ -d $W/$a && -d $SH/$a ]]; then echo "'$a' 가 내 workspace 와 공용에 모두 있습니다 — 폴더 경로로 알려 주세요(예: @@PFX@@-site check $SH/$a)" >&2; exit 2
    elif [[ -d $W/$a ]]; then KIND=me
    elif [[ -d $SH/$a ]]; then KIND=shared
    else echo "없는 프로젝트: $a ($W/$a, $SH/$a)" >&2; exit 2; fi
  fi
  nm "$PROJ"
  if [[ $KIND == me ]]; then BASE=$W/$PROJ; URL="https://$ME.$DOM/$PROJ/"; else BASE=$SH/$PROJ; URL="https://ai.$DOM/$PROJ/"; fi
  PD=$BASE/publish
}
shared_rules(){   # 공용은 이름 규칙·예약어를 서버와 같게 미리 본다(문제 수를 반환)
  [[ $KIND == shared ]] || return 0
  local n=0
  [[ $PROJ =~ ^[a-z][a-z0-9-]{1,30}$ ]] || { echo "공용 프로젝트 이름은 소문자로 시작하는 영문 소문자·숫자·하이픈 2~31자: $PROJ"; n=$((n+1)); }
  [[ $SHARED_RESERVED != *" $PROJ "* ]] || { echo "예약된 이름이라 공개되지 않습니다: $PROJ"; n=$((n+1)); }
  return $n
}
chk(){   # 점검: 문제 개수를 반환
  local d=$PD n=0 f mb
  [[ -d $d || -L $d ]] || { echo "publish 폴더 없음: $d"; return 1; }
  [[ ! -L $d ]] || { echo "publish 가 링크라 공개되지 않습니다(폴더여야 함): $d -> $(readlink "$d")"; return 1; }
  shared_rules || n=$((n+$?))
  while IFS= read -r f; do echo "링크(공개되지 않거나 위험): ${f#"$d"/} -> $(readlink "$f")"; n=$((n+1)); done < <(find "$d" -type l)
  while IFS= read -r f; do echo "비밀로 보이는 파일(서버가 404 로 막음): ${f#"$d"/}"; n=$((n+1)); done < <(find "$d" -type f \( -iname '.env*' -o -iname '*.env' -o -iname '*.pem' -o -iname '*.key' -o -iname 'id_*' -o -iname '*credential*' -o -iname '*secret*' -o -iname '*.sqlite*' -o -iname '*.db' -o -iname '*password*' -o -iname '*token*' -o -iname '*.p12' -o -iname '*.pfx' -o -iname '*.jks' -o -iname '*.kdbx' -o -iname '*.ppk' -o -iname '*.sql' -o -iname '*.tfstate' -o -iname '*apikey*' -o -iname '*api_key*' \))
  while IFS= read -r f; do echo "점(.) 파일(서버가 404 로 막음): ${f#"$d"/}"; done < <(find "$d" -mindepth 1 -name '.*' -not -type l)
  mb=$(du -sm "$d" | cut -f1); ((mb > MAXMB)) && { echo "용량 ${mb}MB > ${MAXMB}MB"; n=$((n+1)); }
  grep -rIlE '(src|href)="/[^/"]' "$d" 2>/dev/null | head -3 | sed "s#^$d/#절대경로(/…) 사용 — 상대경로로 바꿔야 /$PROJ/ 아래에서 열림: #" || true
  return $n
}
case "${1:-}" in
  init) resolve "${2:-}"
    [[ ! -L $PD ]] || { echo "publish 가 링크입니다 — 지우고 실제 폴더로 만드세요: $PD" >&2; exit 2; }
    shared_rules >&2 || exit 2
    mkdir -p "$PD"; rm -f "$BASE/.publish-off"
    echo "준비됨: $PD  →  $URL  (허용 IP 만, 파일을 두면 바로 공개 · 새 폴더는 최대 1분 뒤부터)"; echo "공개 전에: @@PFX@@-site check $PROJ";;
  check) if [[ -n ${2:-} ]]; then resolve "$2"; chk || { echo "→ 위 항목을 확인한 뒤 공개하세요(서버가 자동으로 막는 항목도 있지만 그것에 기대지 않습니다)."; exit 1; }; echo "문제 없음"
         else rc=0; for d in "$W"/*/publish "$SH"/*/publish; do [[ -d $d || -L $d ]] || continue; b=$(dirname "$d"); resolve "$b"; echo "== $KIND:$PROJ"; chk || rc=1; done; exit $rc; fi;;
  list) any=0
    if [[ -f $APPS/.site ]]; then grep -v '^#' "$APPS/.site" | sed 's/^공개 /공개  /; s/^거부 /거부  /; s/^공용 /공용  /' || true; any=1; fi
    for d in "$W"/*/publish; do [[ -d $d ]] || continue; p=$(basename "$(dirname "$d")")
      if [[ -f $APPS/.site ]] && grep -qE "^(공개|거부) $p( |$)" "$APPS/.site"; then continue; fi
      [[ ! -e $(dirname "$d")/.publish-off ]] || continue
      any=1; echo "대기  $p  (파일 $(find "$d" -type f | wc -l)개 · 서버가 1분 안에 공개 준비) https://$ME.$DOM/$p/"; done
    ((any)) || echo "공개 폴더 없음 — @@PFX@@-site init <프로젝트>";;
  off) resolve "${2:-}"; [[ -d $PD ]] || { echo "publish 없음: $PD" >&2; exit 2; }
    touch "$BASE/.publish-off"; echo "공개 중지: $URL (파일은 그대로 · 다시 공개: @@PFX@@-site init $PROJ · 반영은 최대 1분)";;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2;;
esac
