#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" -eq 0 ]]; then
    echo "오류: @@PFX@@-ssh-key-add는 root가 아닌 회원 계정으로 실행해야 합니다." >&2
    exit 1
fi

SSH_DIR="${HOME}/.ssh"
AUTH_KEYS="${SSH_DIR}/authorized_keys"

usage() {
    echo "사용법:"
    echo "  @@PFX@@-ssh-key-add [공개키-파일]"
    echo
    echo "예시:"
    echo "  @@PFX@@-ssh-key-add ~/.ssh/id_ed25519.pub"
    echo "  @@PFX@@-ssh-key-add"
    echo
    echo "파일을 지정하지 않으면 SSH 공개키를 직접 붙여넣을 수 있습니다."
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

if [[ $# -gt 1 ]]; then
    usage >&2
    exit 1
fi

if [[ $# -eq 1 ]]; then
    KEY_FILE="$1"

    if [[ ! -f "${KEY_FILE}" ]]; then
        echo "오류: SSH 공개키 파일을 찾을 수 없습니다: ${KEY_FILE}" >&2
        exit 1
    fi

    KEY="$(tr -d '\r\n' < "${KEY_FILE}")"
else
    if [[ ! -t 0 ]]; then
        echo "오류: 공개키 파일이 지정되지 않았고 입력을 받을 수 없는 환경입니다." >&2
        echo "사용법: @@PFX@@-ssh-key-add <공개키-파일>" >&2
        exit 1
    fi

    echo "SSH 공개키 한 줄을 붙여넣으세요."
    read -r -p "공개키: " KEY
fi

if [[ -z "${KEY}" ]]; then
    echo "오류: 입력된 SSH 공개키가 비어 있습니다." >&2
    exit 1
fi

KEY_TYPE="$(printf '%s\n' "${KEY}" | awk '{print $1}')"

case "${KEY_TYPE}" in
    ssh-ed25519|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)
        ;;
    *)
        echo "오류: 지원하지 않는 SSH 공개키 형식입니다: ${KEY_TYPE}" >&2
        exit 1
        ;;
esac

TMP="$(mktemp)"
trap 'rm -f "${TMP}"' EXIT

printf '%s\n' "${KEY}" > "${TMP}"

if ! ssh-keygen -lf "${TMP}" >/dev/null 2>&1; then
    echo "오류: 올바른 SSH 공개키가 아닙니다." >&2
    exit 1
fi

FINGERPRINT="$(ssh-keygen -lf "${TMP}" -E sha256 | awk '{print $2}')"

mkdir -p "${SSH_DIR}"
chmod 0700 "${SSH_DIR}"

touch "${AUTH_KEYS}"
chmod 0600 "${AUTH_KEYS}"

if grep -Fqx -- "${KEY}" "${AUTH_KEYS}"; then
    echo "이미 등록된 SSH 키입니다: ${FINGERPRINT}"
    exit 0
fi

printf '%s\n' "${KEY}" >> "${AUTH_KEYS}"

echo "SSH 키를 등록했습니다: ${FINGERPRINT}"
