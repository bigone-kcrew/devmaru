#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" -eq 0 ]]; then
    echo "오류: @@PFX@@-ssh-key-remove는 root가 아닌 회원 계정으로 실행해야 합니다." >&2
    exit 1
fi

AUTH_KEYS="${HOME}/.ssh/authorized_keys"

usage() {
    echo "사용법:"
    echo "  @@PFX@@-ssh-key-remove SHA256:<fingerprint>"
    echo
    echo "등록된 키의 fingerprint는 다음 명령으로 확인할 수 있습니다."
    echo "  @@PFX@@-ssh-key-list"
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

if [[ ! -f "${AUTH_KEYS}" ]]; then
    echo "등록된 SSH 키가 없습니다."
    exit 0
fi

if [[ $# -ne 1 ]]; then
    usage >&2
    exit 1
fi

TARGET="$1"
TMP_OUT="$(mktemp)"
TMP_KEY="$(mktemp)"
trap 'rm -f "${TMP_OUT}" "${TMP_KEY}"' EXIT

FOUND=0

while IFS= read -r KEY || [[ -n "${KEY}" ]]; do
    if [[ -z "${KEY}" || "${KEY}" == \#* ]]; then
        printf '%s\n' "${KEY}" >> "${TMP_OUT}"
        continue
    fi

    printf '%s\n' "${KEY}" > "${TMP_KEY}"

    FP="$(ssh-keygen -lf "${TMP_KEY}" -E sha256 2>/dev/null | awk '{print $2}' || true)"

    if [[ "${FP}" == "${TARGET}" ]]; then
        FOUND=1
        continue
    fi

    printf '%s\n' "${KEY}" >> "${TMP_OUT}"
done < "${AUTH_KEYS}"

if [[ "${FOUND}" -eq 0 ]]; then
    echo "오류: 해당 fingerprint의 SSH 키를 찾을 수 없습니다: ${TARGET}" >&2
    exit 1
fi

cat "${TMP_OUT}" > "${AUTH_KEYS}"
chmod 0600 "${AUTH_KEYS}"

echo "SSH 키를 삭제했습니다: ${TARGET}"
