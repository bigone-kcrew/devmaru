#!/usr/bin/env bash
# @@PFX@@-workspace-create — 새 프로젝트 폴더를 만든다(기본 템플릿 + Git 저장소).
#   @@PFX@@-workspace-create <프로젝트명> [--no-git]            내 workspace(/workspace/<프로젝트>) — 나와 관리자만 접근, .private/ 포함
#   @@PFX@@-workspace-create <프로젝트명> --shared [--no-git]   공유 작업공간(/shared/workspaces/<프로젝트>) — 멤버 전원이 읽고 쓴다
set -euo pipefail

BOOTSTRAP="${AI_WS_BOOTSTRAP:-/opt/@@PFX@@/bootstrap/workspace-base}"
PERSONAL_ROOT="${AI_WS_ROOT:-/workspace}"
SHARED_ROOT="${AI_SHARED_ROOT:-/shared/workspaces}"
AI_GROUP="${AI_WS_GROUP:-@@PFX@@}"

usage() {
  cat <<USAGE
사용법:
  @@PFX@@-workspace-create <프로젝트명> [--no-git]
  @@PFX@@-workspace-create <프로젝트명> --shared [--no-git] [--readers=all|ID,ID] [--writers=all|ID,ID]

예시:
  @@PFX@@-workspace-create my-project
  @@PFX@@-workspace-create research-demo --no-git
  @@PFX@@-workspace-create team-notes --shared

기본은 내 workspace(나와 관리자만 접근)에 만들고, --shared 는 @@BRAND@@ 회원 모두가 함께 쓰는 공유 작업공간(/shared/workspaces)에 만듭니다.
기본적으로 새 Git 저장소를 함께 만듭니다. 필요하지 않으면 --no-git 옵션을 사용하세요.
USAGE
}

PROJECT=""; GIT_INIT=1; SHARED=0; READERS=""; WRITERS=""
for a in "$@"; do
  case "$a" in
    -h|--help) usage; exit 0;;
    --no-git) GIT_INIT=0;;
    --shared) SHARED=1;;
    --readers=*) READERS="${a#--readers=}";;
    --writers=*) WRITERS="${a#--writers=}";;
    -*) echo "오류: 알 수 없는 옵션입니다: $a" >&2; usage; exit 1;;
    *) if [[ -z $PROJECT ]]; then PROJECT="$a"; else echo "오류: 프로젝트명은 하나만 쓸 수 있습니다: $a" >&2; usage; exit 1; fi;;
  esac
done
[[ -n $PROJECT ]] || { usage; exit 1; }

USERNAME="$(id -un)"
# 접근 정책: 상위 폴더의 default 그룹 권한을 따른다(<접두어>-access 가 설정): rwx=회원 쓰기, r-x=읽기만, ---=불가
pol_g() { local v; v=$(getfacl -p "$1" 2>/dev/null | awk -F: '$1=="default"&&$2=="group"&&$3==""{print $4; exit}'); echo "${v:0:3}"; }
if [[ $SHARED -eq 1 ]]; then
  ROOT="$SHARED_ROOT"; LABEL="공유"; CPATH="/shared/workspaces"
  PG=$(pol_g "$ROOT"); PG=${PG:-rwx}
else
  ROOT="$PERSONAL_ROOT"; LABEL="개인"; CPATH="/workspace"
  PG=$(pol_g "$ROOT"); PG=${PG:----}
fi
GACL="${PG%x}X"; DGACL="$PG"
case $PG in rwx) DMODE=2770; FMODE=0660;; r-x) DMODE=2750; FMODE=0640;; *) DMODE=2700; FMODE=0600;; esac

if [[ $EUID -eq 0 ]]; then
  echo "오류: root가 아닌 회원 계정으로 실행하세요." >&2
  exit 1
fi

if ! id "$USERNAME" >/dev/null 2>&1; then
  echo "오류: 사용자 계정을 찾을 수 없습니다: $USERNAME" >&2
  exit 1
fi

if ! getent group "$AI_GROUP" >/dev/null 2>&1; then
  echo "오류: @@BRAND@@ 그룹을 찾을 수 없습니다: $AI_GROUP" >&2
  exit 1
fi

if [[ ! -d "$BOOTSTRAP" ]]; then
  echo "오류: 작업공간 기본 템플릿을 찾을 수 없습니다: $BOOTSTRAP" >&2
  exit 1
fi

if [[ ! "$PROJECT" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "오류: 사용할 수 없는 프로젝트명입니다: $PROJECT" >&2
  echo "허용 문자: 영문자, 숫자, 점(.), 밑줄(_), 하이픈(-)" >&2
  exit 1
fi

PROJECT_DIR="${ROOT}/${PROJECT}"

if [[ ! -d "$ROOT" ]]; then
  echo "오류: ${LABEL} 작업공간 경로가 없습니다: $ROOT" >&2
  exit 1
fi

if [[ -e "$PROJECT_DIR" ]]; then
  echo "오류: 같은 이름의 프로젝트가 이미 있습니다: $PROJECT_DIR" >&2
  exit 1
fi

echo "===== ${LABEL} 작업공간 생성 ====="
echo "회원 ID   : $USERNAME"
echo "프로젝트  : $PROJECT"
echo "경로      : $PROJECT_DIR"

# 프로젝트별 접근(공유 전용): --readers/--writers = all | ID,ID  (회원 이름→uid 는 읽기 전용 목록에서 찾는다)
NA=""; ND=""
MAP="${AI_ACCESS_MAP:-/shared/.access/members.map}"
if [[ $SHARED -eq 1 && -r $MAP ]]; then   # 관리자 쓰기 ACL — cp -a 가 상속분을 지우므로 목록의 @admin uid 로 다시 건다
  ADMUID=$(awk '$1=="@admin"{print $2; exit}' "$MAP"); [[ -n $ADMUID ]] && { NA+=",u:$ADMUID:rwX"; ND+=",d:u:$ADMUID:rwx"; }
fi
if [[ -n $READERS$WRITERS ]]; then
  [[ $SHARED -eq 1 ]] || { echo "오류: --readers/--writers 는 --shared 와 함께 씁니다" >&2; exit 1; }
  MAP="${AI_ACCESS_MAP:-/shared/.access/members.map}"
  [[ -r $MAP ]] || { echo "오류: 회원 목록($MAP)을 읽을 수 없습니다 — 관리자에게 @@PFX@@-access apply 를 요청하세요" >&2; exit 1; }
  RD="${READERS:-all}"; WR="${WRITERS:-$([[ $PG = rwx ]] && echo "$RD" || echo none)}"
  [[ $WR = all ]] && RD=all
  uid_of() { awk -v n="$1" '$1==n{print $2; exit}' "$MAP"; }
  GP="---"; [[ $RD = all ]] && GP="r-x"; [[ $WR = all ]] && GP="rwx"
  declare -A PERM
  for n in ${RD//,/ }; do [[ $n = all ]] || PERM[$n]="r-x"; done
  for n in ${WR//,/ }; do case $n in all|none) ;; *) PERM[$n]="rwx";; esac; done
  for n in "${!PERM[@]}"; do
    [[ $n =~ ^[a-z][a-z0-9_-]{1,31}$ && -n $(uid_of "$n") ]] || { echo "오류: 회원을 찾을 수 없습니다: $n" >&2; exit 1; }
    NA+=",u:$(uid_of "$n"):${PERM[$n]%x}X"; ND+=",d:u:$(uid_of "$n"):${PERM[$n]}"
  done
  GACL="${GP%x}X"; DGACL="$GP"
  case $GP in rwx) DMODE=2770; FMODE=0660;; *) DMODE=2750; FMODE=0640;; esac
fi

mkdir "$PROJECT_DIR"
cp -a "${BOOTSTRAP}/." "$PROJECT_DIR/"

if [[ $SHARED -eq 0 ]]; then
  # 비밀·개인정보는 여기에(700). git 에는 올리지 않는다
  mkdir -p "$PROJECT_DIR/.private"
  grep -qx '\.private/' "$PROJECT_DIR/.gitignore" 2>/dev/null || printf '\n# Credentials and personal data (project-local)\n.private/\n' >> "$PROJECT_DIR/.gitignore"
fi

[[ -n $READERS$WRITERS ]] && printf 'readers=%s\nwriters=%s\n' "$RD" "$WR" > "$PROJECT_DIR/.@@PFX@@-access"
chown -R "${USERNAME}:${AI_GROUP}" "$PROJECT_DIR"

# chmod 를 먼저, setfacl 을 나중에 — 이름 붙은 ACL(관리자 등)이 있는 항목에 chmod 를 하면 mask 가 ---- 로 내려가므로 setfacl 이 mask 를 다시 계산해 바로잡는다
find "$PROJECT_DIR" -type d -exec chmod "$DMODE" {} +
find "$PROJECT_DIR" -type f -exec chmod "$FMODE" {} +

setfacl -R \
  -m "u::rwX,g::${GACL},o::---${NA}" \
  "$PROJECT_DIR"

find "$PROJECT_DIR" -type d -exec setfacl \
  -m "d:u::rwx,d:g::${DGACL},d:o::---${ND}" {} +

[[ $SHARED -eq 0 && -d "$PROJECT_DIR/.private" ]] && { chmod 2700 "$PROJECT_DIR/.private"; setfacl -m g::---,d:g::--- "$PROJECT_DIR/.private"; }

# 개인 프로젝트(F2): 상위 작업공간 루트의 default 이름 ACL 중 «관리자 사용자» 항목만 프로젝트에 남긴다.
#  - 허용 목록(AI_WS_ADMIN_USERS, 공백 구분, 기본 @@ADMIN_USER@@)의 user: 항목만 — group: 항목·다른 사용자(caddy·숫자 uid 등)는 상속분까지 지우고 절대 복사하지 않는다
#  - cp -a 가 최상위 접근 ACL 을 지워 관리자가 못 들어가는 문제를 관리자 항목 재적용으로 해결. 적용·검증에 실패하면 비-0 종료. 공유(--shared)는 그대로
if [[ $SHARED -eq 0 ]]; then
  ADM="${AI_WS_ADMIN_USERS:-doob}"
  acl_die() { echo "오류: $* — $PROJECT_DIR 의 ACL 이 의도와 다를 수 있으니 확인/삭제하세요" >&2; exit 1; }
  # getfacl 은 마스크가 좁으면 "default:user:NAME:rwx<TAB>#effective:r-x" 로 찍는다 — ':' 로 잘라 앞 칸만 쓰고 뒤 주석은 무시
  PACL=$(getfacl -p "$ROOT" 2>/dev/null) || acl_die "$ROOT 의 ACL 을 읽지 못했습니다"
  while read -r e; do
    [[ -n $e ]] || continue
    { setfacl -R -x "$e" "$PROJECT_DIR" && find "$PROJECT_DIR" -type d -exec setfacl -x "d:$e" {} +; } || acl_die "상위 default ACL 항목($e) 제거 실패"
  done < <(awk -F: -v list="$ADM" 'BEGIN{n=split(list,a," "); for(i=1;i<=n;i++) ok[a[i]]=1}
    $1=="default" && ($2=="user"||$2=="group") && $3!="" && !($2=="user" && ($3 in ok)) {print substr($2,1,1) ":" $3}' <<<"$PACL")
  for n in $ADM; do
    perm=$(awk -F'[:\t ]+' -v n="$n" '$1=="default" && $2=="user" && $3==n {print $4; exit}' <<<"$PACL")
    [[ -z $perm ]] && continue
    [[ $perm =~ ^[r-][w-][x-]$ ]] || acl_die "관리자($n) default ACL 을 해석하지 못했습니다: '$perm'"
    { setfacl -R -m "u:$n:${perm//x/X}" "$PROJECT_DIR" && find "$PROJECT_DIR" -type d -exec setfacl -m "d:u:$n:$perm" {} +; } || acl_die "관리자($n) ACL 적용 실패"
    getfacl -p "$PROJECT_DIR" | grep -q "^user:$n:" || acl_die "관리자($n) ACL 이 남아 있지 않습니다"
  done
  STRAY=$(getfacl -pR "$PROJECT_DIR" | awk -F: -v list="$ADM" 'BEGIN{n=split(list,a," "); for(i=1;i<=n;i++) ok[a[i]]=1}
    {o=($1=="default"); k=$(1+o); nm=$(2+o); if ((k=="user"||k=="group") && nm!="" && !(k=="user" && (nm in ok))) print}' | head -3)
  [[ -z $STRAY ]] || acl_die "허용 목록 밖 이름 ACL 이 남아 있습니다: $STRAY"
fi

if [[ $GIT_INIT -eq 1 ]]; then
  git -C "$PROJECT_DIR" init -q -b main
fi

echo
echo "${LABEL} 작업공간을 만들었습니다."
echo "현재 경로       : $PROJECT_DIR"
echo "컨테이너 경로   : ${CPATH}/$PROJECT"

if [[ $GIT_INIT -eq 1 ]]; then
  echo "Git 저장소      : 생성됨(main)"
else
  echo "Git 저장소      : 생성하지 않음"
fi

if [[ $SHARED -eq 1 ]]; then
  echo "주의            : 공유 폴더는 멤버 전원이 읽을 수 있습니다. 비밀·개인정보를 두지 마세요."
  [[ $PROJECT =~ ^[a-z][a-z0-9-]{1,30}$ ]] || echo "참고            : 이 이름은 공용 정적 공개(@@PORTAL_HOST@@/<이름>/) 규칙(소문자로 시작하는 소문자·숫자·하이픈 2~31자)에 맞지 않아 공개할 수 없습니다."
else
  echo "비밀·개인정보   : $PROJECT_DIR/.private/ (나와 관리자만 접근, git 제외)"
fi
