      || die "usage: kordoc-api seal-native <file> --image <seal-image> -o <output.hwpx> [--anchor <text>] [--occurrence <n>] [--size-mm <n>] [--mode <auto|overlap|right>] [--dx-mm <n>] [--dy-mm <n>]"

    file="$2"
    require_file "$file"

    image_file=""
    output=""
    anchor="(인)"
    occurrence="0"
    size_mm=""
    mode="auto"
    dx_mm=""
    dy_mm=""

    shift 2

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --image)
          [[ $# -ge 2 ]] || die "--image requires a file"
          image_file="$2"
          shift 2
          ;;

        -o|--output)
          [[ $# -ge 2 ]] || die "$1 requires a path"
          output="$2"
          shift 2
          ;;

        --anchor)
          [[ $# -ge 2 ]] || die "--anchor requires text"
          anchor="$2"
          shift 2
          ;;

        --occurrence)
          [[ $# -ge 2 ]] || die "--occurrence requires a non-negative integer"
          occurrence="$2"

          [[ "$occurrence" =~ ^[0-9]+$ ]] \
            || die "--occurrence must be a non-negative integer"

          shift 2
          ;;

        --size-mm)
          [[ $# -ge 2 ]] || die "--size-mm requires a number"
          size_mm="$2"

          awk -v n="$size_mm" \
            'BEGIN { exit !(n > 0) }' \
            || die "--size-mm must be greater than 0"

          shift 2
          ;;

        --mode)
          [[ $# -ge 2 ]] || die "--mode requires auto, overlap, or right"
          mode="$2"

          case "$mode" in
            auto|overlap|right)
              ;;
            *)
              die "invalid seal-native mode: $mode"
              ;;
          esac

          shift 2
          ;;

        --dx-mm)
          [[ $# -ge 2 ]] || die "--dx-mm requires a number"
          dx_mm="$2"

          awk -v n="$dx_mm" \
            'BEGIN { exit !(n == n+0) }' \
            || die "--dx-mm must be numeric"

          shift 2
          ;;

        --dy-mm)
          [[ $# -ge 2 ]] || die "--dy-mm requires a number"
          dy_mm="$2"

          awk -v n="$dy_mm" \
            'BEGIN { exit !(n == n+0) }' \
            || die "--dy-mm must be numeric"

          shift 2
          ;;

        *)
          die "unknown seal-native option: $1"
          ;;
      esac
    done

    [[ -n "$image_file" ]] \
      || die "seal-native requires --image <seal-image>"

    require_file "$image_file"
    require_output_path "$output" "seal-native"

    form_args=(
      -F "file=@${file}"
      -F "image=@${image_file}"
      --form-string "anchor=${anchor}"
      --form-string "occurrence=${occurrence}"
      --form-string "mode=${mode}"
    )

    if [[ -n "$size_mm" ]]; then
      form_args+=(
        --form-string "sizeMm=${size_mm}"
      )
    fi

    if [[ -n "$dx_mm" ]]; then
      form_args+=(
        --form-string "dxMm=${dx_mm}"
      )
    fi

    if [[ -n "$dy_mm" ]]; then
      form_args+=(
        --form-string "dyMm=${dy_mm}"
      )
    fi

    output_dir="$(dirname "$output")"
    tmp_output="$(mktemp "${output_dir}/.kordoc-api-seal-native.XXXXXX")"

    if ! meta="$(
      curl "${curl_common[@]}" \
        -X POST \
        "${form_args[@]}" \
        -o "$tmp_output" \
        -w $'%{http_code}\n%{content_type}' \
        "${KORDOC_API_BASE}/v1/document/seal/native"
    )"; then
      rm -f "$tmp_output"
      die "request failed: POST /v1/document/seal/native"
    fi

    http_code="$(printf '%s\n' "$meta" | sed -n '1p')"
    content_type="$(printf '%s\n' "$meta" | sed -n '2p')"

    if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
      cat "$tmp_output" >&2 || true
      echo >&2
      rm -f "$tmp_output"
      die "HTTP ${http_code}: POST /v1/document/seal/native"
    fi

    [[ -s "$tmp_output" ]] || {
      rm -f "$tmp_output"
      die "seal-native returned an empty document"
    }

    mv "$tmp_output" "$output"

    jq -n \
      --arg output "$(realpath "$output")" \
      --arg contentType "$content_type" \
      --argjson bytes "$(stat -c '%s' "$output")" \
      '{
        success: true,
        output: $output,
        contentType: $contentType,
        bytes: $bytes
      }'
    ;;

