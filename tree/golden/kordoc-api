          ;;

        --plain)
          [[ $# -ge 2 ]] \
            || die "--plain requires a value"

          plain="$2"

          case "$plain" in
            true|false)
              ;;
            *)
              die "invalid --plain value: $plain"
              ;;
          esac

          shift 2
          ;;

        --html-tables)
          [[ $# -ge 2 ]] \
            || die "--html-tables requires a value"

          html_tables="$2"

          case "$html_tables" in
            true|false)
              ;;
            *)
              die "invalid --html-tables value: $html_tables"
              ;;
          esac

          shift 2
          ;;

        *)
          if consume_common_option "$@"; then
            shift "$consumed"
          else
            die "unknown parse option: $1"
          fi
          ;;
      esac
    done

    [[ "$table_format_set" == 0 || "$html_tables" == false ]] \
      || die "--table-format 은 --html-tables true 와 같이 쓰지 않는다"

    request_json \
      POST \
      /v1/parse \
      -F "file=@${file}" \
      -F "ocr=${ocr}" \
      -F "includeBlocks=${include_blocks}" \
      -F "includeFieldPlaceholders=${include_field_placeholders}" \
      -F "plain=${plain}" \
      -F "htmlTables=${html_tables}" \
      ${common_form[@]+"${common_form[@]}"}
    ;;

  compare)
    [[ $# -ge 3 ]] \
      || die "usage: kordoc-api compare <fileA> <fileB> [--ocr <false|true|force>]"

    file_a="$2"
    file_b="$3"
    require_file "$file_a"
    require_file "$file_b"

    ocr="false"

    shift 3

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --ocr)
          [[ $# -ge 2 ]] || die "--ocr requires false, true, or force"
          ocr="$2"
          case "$ocr" in
            false|true|force) ;;
            *) die "invalid --ocr value: $ocr" ;;
          esac
          shift 2
          ;;

        *)
          die "unknown compare option: $1"
          ;;
      esac
    done

    request_json \
      POST \
      /v1/compare \
      -F "fileA=@${file_a}" \
      -F "fileB=@${file_b}" \
      -F "ocr=${ocr}"
    ;;

  lint)
    [[ $# -ge 2 ]] \
      || die "usage: kordoc-api lint <file|-> [--munche <true|false>] [--strict]"

    lint_src="$2"
    munche="false"
    strict="false"

    shift 2

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --munche)
          [[ $# -ge 2 ]] || die "--munche requires true or false"
          munche="$2"
          case "$munche" in
            true|false) ;;
            *) die "invalid --munche value: $munche" ;;
          esac
          shift 2
          ;;

        --strict)
          strict="true"
          shift
          ;;

        *)
          die "unknown lint option: $1"
          ;;
      esac
    done

    if [[ "$lint_src" != "-" ]]; then
      require_file "$lint_src"
      exec 3< "$lint_src"
    else
      exec 3<&0
    fi

    # 본문은 셸 명령줄에 펼치지 않고 stdin 으로 JSON 으로 만든다(긴 문서·특수문자 안전).
    lint_tmp="$(mktemp)"

    if ! lint_code="$(
      jq -Rs --argjson munche "$munche" '{text: ., munche: $munche}' <&3 \
        | curl "${curl_common[@]}" \
            -X POST \
            -H 'Content-Type: application/json' \
            --data-binary @- \
            -o "$lint_tmp" \
            -w '%{http_code}' \
            "${KORDOC_API_BASE}/v1/document/lint"
    )"; then
      rm -f "$lint_tmp"
      die "request failed: POST /v1/document/lint"
    fi

    exec 3<&-

    if [[ ! "$lint_code" =~ ^2[0-9][0-9]$ ]]; then
      [[ -s "$lint_tmp" ]] && { cat "$lint_tmp" >&2; echo >&2; }
      rm -f "$lint_tmp"
      die "HTTP ${lint_code}: POST /v1/document/lint"
    fi

    jq -e . "$lint_tmp" >/dev/null 2>&1 \
      || { cat "$lint_tmp" >&2; rm -f "$lint_tmp"; die "Kordoc returned invalid JSON"; }

    # ok:false 는 «표기 오류가 있다» 는 정상 결과다 — 항상 stdout 에 낸다.
    jq . "$lint_tmp"

    if [[ "$strict" == "true" ]] && jq -e '.ok == false' "$lint_tmp" >/dev/null; then
      rm -f "$lint_tmp"
      exit 1
    fi

    rm -f "$lint_tmp"
    ;;

  lint-full)
    [[ $# -ge 3 ]] \
      || die "usage: kordoc-api lint-full (--file <document> | --text-file <text> | --blocks <blocks.json>) [--munche|--slop|--logic|--numbers|--budget|--gate <true|false>] [--preset <name>]"

    shift
    lint_form=()
    lint_sources=0

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --file)
          [[ $# -ge 2 ]] || die "--file requires a document"
          require_file "$2"
          lint_form+=(-F "file=@${2}")
          lint_sources=$((lint_sources + 1))
          shift 2
          ;;

        --text-file)
          [[ $# -ge 2 ]] || die "--text-file requires a file"
          require_file "$2"
          lint_form+=(-F "text=<${2}")
          lint_sources=$((lint_sources + 1))
          shift 2
          ;;

        --blocks)
          [[ $# -ge 2 ]] || die "--blocks requires a JSON file"
          require_json_array "$2" "blocks"
          lint_form+=(-F "blocks=<${2}")
          lint_sources=$((lint_sources + 1))
          shift 2
          ;;

        --munche|--slop|--logic|--numbers|--budget|--gate)
          [[ $# -ge 2 ]] || die "$1 requires true or false"
          case "$2" in
            true|false) ;;
            *) die "invalid $1 value: $2" ;;
          esac
          lint_form+=(--form-string "${1#--}=${2}")
          shift 2
          ;;

        --preset)
          [[ $# -ge 2 ]] || die "--preset requires a name"
          lint_form+=(--form-string "preset=${2}")
          shift 2
          ;;

        *)
          die "unknown lint-full option: $1"
          ;;
      esac
    done

    (( lint_sources == 1 )) \
      || die "lint-full needs exactly one of --file, --text-file, --blocks"

    lint_tmp="$(mktemp)"

    if ! lint_code="$(
      curl "${curl_common[@]}" \
        -X POST \
        "${lint_form[@]}" \
        -o "$lint_tmp" \
        -w '%{http_code}' \
        "${KORDOC_API_BASE}/v1/document/lint/full"
    )"; then
      rm -f "$lint_tmp"
      die "request failed: POST /v1/document/lint/full"
    fi

    if [[ ! "$lint_code" =~ ^2[0-9][0-9]$ ]]; then
      [[ -s "$lint_tmp" ]] && { cat "$lint_tmp" >&2; echo >&2; }
      rm -f "$lint_tmp"
      die "HTTP ${lint_code}: POST /v1/document/lint/full"
    fi

    jq -e . "$lint_tmp" >/dev/null 2>&1 \
      || { cat "$lint_tmp" >&2; rm -f "$lint_tmp"; die "Kordoc returned invalid JSON"; }

    # 지적이 있는 결과도 정상 결과다 — 항상 stdout 에 낸다.
    jq . "$lint_tmp"
    rm -f "$lint_tmp"
    ;;

  -h|--help|help|"")
    usage
    ;;

  *)
    usage >&2
    die "unknown command: $command"
    ;;
esac
