        tmp_markdown="$(mktemp "${output_dir}/.kordoc-api-redact-md.XXXXXX")"
        jq -r '.maskedMarkdown' "$tmp_output" >"$tmp_markdown"
        mv "$tmp_markdown" "$output"

        hit_count="$(jq -r '.hitCount // 0' "$tmp_output")"
        rm -f "$tmp_output" "$headers"

        bytes="$(stat -c '%s' "$output")"

        jq -n \
          --arg output "$(realpath "$output")" \
          --arg hitCount "$hit_count" \
          --argjson bytes "$bytes" \
          '{
            success: true,
            output: $output,
            format: "markdown",
            bytes: $bytes,
            hitCount: ($hitCount | tonumber? // 0)
