    done

    require_output_path "$output" "profile-extract"

    output_dir="$(dirname "$output")"
    response="$(mktemp)"
    tmp_output="$(mktemp "${output_dir}/.kordoc-api-profile.XXXXXX")"

    if ! request_json \
      POST \
      /v1/document/profile/extract \
      -F "file=@${file}" \
      >"$response"
    then
      rm -f "$response" "$tmp_output"
      exit 1
    fi

    if ! jq -e '.profile | type == "object"' "$response" >/dev/null; then
      jq . "$response" >&2 || true
      rm -f "$response" "$tmp_output"
      die "Kordoc response does not contain a profile object"
    fi

    jq '.profile' "$response" >"$tmp_output"
    mv "$tmp_output" "$output"

    table_count="$(jq -r '.tableCount // 0' "$response")"
    rm -f "$response"

    jq -n \
      --arg output "$(realpath "$output")" \
      --arg tableCount "$table_count" \
      '{
