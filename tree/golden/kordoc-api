          die "unsupported built-in template: $template"
          ;;
      esac

      shift 3
    else
      file="$2"
      require_file "$file"
      shift 2
    fi

    values_file=""
    formats_file=""
    require_unique="false"
    mask_values="false"
    output_format="markdown"
    output=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --values)
          [[ $# -ge 2 ]] || die "--values requires a JSON file"
          values_file="$2"
          shift 2
          ;;

        --formats)
          [[ $# -ge 2 ]] || die "--formats requires a JSON file"
          formats_file="$2"
          shift 2
          ;;

        --require-unique)
          require_unique="true"
          shift
          ;;

        --mask-values)
          mask_values="true"
          shift
          ;;

        --format)
          [[ $# -ge 2 ]] || die "--format requires a value"
          output_format="$2"

          case "$output_format" in
            markdown|hwpx|hwpx-preserve)
              ;;
            *)
              die "invalid fill output format: $output_format"
              ;;
          esac

          shift 2
          ;;

        -o|--output)
          [[ $# -ge 2 ]] || die "$1 requires a path"
          output="$2"
          shift 2
          ;;

        *)
          die "unknown fill option: $1"
          ;;
      esac
    done

    [[ -n "$values_file" ]] \
      || die "fill requires --values <values.json>"

    require_json_object "$values_file" "values"

    if [[ -n "$formats_file" ]]; then
      require_json_object "$formats_file" "formats"
    fi

    form_args=(
      -F "values=<${values_file}"
      -F "outputFormat=${output_format}"
    )

    if [[ -n "$file" ]]; then
      form_args+=(
        -F "file=@${file}"
      )
    else
      form_args+=(
        -F "template=${template}"
      )
    fi

    if [[ -n "$formats_file" ]]; then
      form_args+=(
        -F "formats=<${formats_file}"
      )
    fi

    if [[ "$require_unique" == "true" ]]; then
      form_args+=(
        -F "requireUnique=true"
      )
    fi

    if [[ "$mask_values" == "true" ]]; then
      form_args+=(
        -F "maskValues=true"
      )
    fi

    if [[ "$output_format" == "markdown" ]]; then
      [[ -z "$output" ]] \
        || die "-o is only used with binary fill formats"

      request_json \
        POST \
        /v1/form/fill \
        "${form_args[@]}"

      exit 0
    fi

    require_output_path "$output" "fill"

    output_dir="$(dirname "$output")"
    tmp_output="$(mktemp "${output_dir}/.kordoc-api-fill.XXXXXX")"
    headers="$(mktemp)"

    if ! meta="$(
      curl "${curl_common[@]}" \
        -X POST \
        "${form_args[@]}" \
        -D "$headers" \
        -o "$tmp_output" \
        -w $'%{http_code}\n%{content_type}' \
        "${KORDOC_API_BASE}/v1/form/fill"
    )"; then
      if [[ -s "$tmp_output" ]]; then
        cat "$tmp_output" >&2 || true
        echo >&2
      fi

      rm -f "$tmp_output" "$headers"
      die "request failed: POST /v1/form/fill"
    fi

    http_code="$(printf '%s\n' "$meta" | sed -n '1p')"
    content_type="$(printf '%s\n' "$meta" | sed -n '2p')"

    if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
      cat "$tmp_output" >&2 || true
      echo >&2

      rm -f "$tmp_output" "$headers"
      die "HTTP ${http_code}: POST /v1/form/fill"
    fi

    if [[ ! -s "$tmp_output" ]]; then
      rm -f "$tmp_output" "$headers"
      die "Kordoc returned an empty filled document"
    fi

    case "${content_type%%;*}" in
      application/hwp+zip|application/zip|application/octet-stream)
        ;;
      *)
        file "$tmp_output" >&2 || true
        rm -f "$tmp_output" "$headers"
        die "unexpected Content-Type: ${content_type:-unknown}"
        ;;
    esac

    if ! file "$tmp_output" | grep -Eqi 'HWPX|Zip archive'; then
      file "$tmp_output" >&2 || true
      rm -f "$tmp_output" "$headers"
      die "filled response is not recognized as HWPX/ZIP"
    fi

    mv "$tmp_output" "$output"

    filled_count="$(header_value x-kordoc-filled-count "$headers")"
    rejected_count="$(header_value x-kordoc-rejected-count "$headers")"
    unmatched_count="$(header_value x-kordoc-unmatched-count "$headers")"
    response_mask="$(header_value x-kordoc-mask-values "$headers")"

    rm -f "$headers"

    bytes="$(stat -c '%s' "$output")"

    jq -n \
      --arg output "$(realpath "$output")" \
      --arg contentType "$content_type" \
      --arg filledCount "${filled_count:-0}" \
      --arg rejectedCount "${rejected_count:-0}" \
      --arg unmatchedCount "${unmatched_count:-0}" \
      --arg maskValues "${response_mask:-false}" \
      --argjson bytes "$bytes" \
      '{
        success: true,
        output: $output,
        contentType: $contentType,
        bytes: $bytes,
        filledCount: ($filledCount | tonumber? // 0),
        rejectedCount: ($rejectedCount | tonumber? // 0),
        unmatchedCount: ($unmatchedCount | tonumber? // 0),
        maskValues: ($maskValues == "true")
      }'
    ;;

  redact)
