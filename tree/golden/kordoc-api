  fill)
    [[ $# -ge 3 ]] \
      || die "usage: kordoc-api fill <file> --values <values.json> [options] OR kordoc-api fill --template <template> --values <values.json> [options]"

    file=""
    template=""

    if [[ "${2:-}" == "--template" ]]; then
      [[ $# -ge 4 ]] \
        || die "--template requires a template name"

      template="$3"

      case "$template" in
        gian|gian-simple|일반기안문|간이기안문)
          ;;
