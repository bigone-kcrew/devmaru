#!/usr/bin/env bash
set -Eeuo pipefail

KORDOC_API_BASE="${KORDOC_API_BASE:-http://kordoc:3400}"
KORDOC_API_TOKEN="${KORDOC_API_TOKEN:-}"
KORDOC_API_TIMEOUT="${KORDOC_API_TIMEOUT:-600}"

die() {
  echo "ERROR: $*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage:
  kordoc-api health
  kordoc-api version

  kordoc-api generate-hwpx <markdown-file> -o <output.hwpx> [--options <options.json>]
  kordoc-api generate-hwpx-advanced <markdown-file> -o <output.hwpx> [--options <options.json>] [--profile <profile.json>] [--template <template.hwpx>] [--image <image>]...

  kordoc-api render-native <file> -o <output> [--format <png|jpeg|svg|html|pdf>] [--pages <range>] [--max-width-px <200-4000>] [--highlight <text>]... [--reflow-mode <keep|charAll>]

  kordoc-api extract-tables <file> [--visual <none|non-tabular|non-tabular-and-uncertain|all>] [--format <png|jpeg>] [--padding-pt <0-100>] [--cells] [--output-dir <dir>]

  kordoc-api crop-regions <file> [--target <table|image|paragraph|shape>]... [--format <png|jpeg>] [--pages <range>] [--padding-pt <0-100>] [--output-dir <dir>]

  kordoc-api parse-pages <file> [--ocr <false|true|force>] [--table-format gfm]
  kordoc-api parse-table <file> [--ocr <false|true|force>] [--images <true|false>]
  kordoc-api parse-chunks <file> [--ocr <false|true|force>] [--granularity <section|block>] [--include-table-cells]

  kordoc-api patch <file> --markdown <markdown-file> -o <output.hwp|output.hwpx> [--options <options.json>]
  kordoc-api seal <file> --image <seal-image> --ops <ops.json> -o <output.hwpx>

  kordoc-api seal-native <file> --image <seal-image> -o <output.hwpx> [--anchor <text>] [--occurrence <n>] [--size-mm <n>] [--mode <auto|overlap|right>] [--dx-mm <n>] [--dy-mm <n>]

  kordoc-api patch-native <file> --markdown <markdown-file> -o <output.hwp|output.hwpx> [--no-structure]

  kordoc-api detect <file>
  kordoc-api metadata <file> [common parse options] [--table-format gfm]
  kordoc-api validate <file>
  kordoc-api compare <fileA> <fileB> [--ocr <false|true|force>]
  kordoc-api lint <file|-> [--munche <true|false>] [--strict]
  kordoc-api lint-full (--file <document> | --text-file <text> | --blocks <blocks.json>) [--munche|--slop|--logic|--numbers|--budget|--gate <true|false>] [--preset <name>]
  kordoc-api form-parse <file>
  kordoc-api profile-extract <reference.hwpx> -o <profile.json>

  kordoc-api fill <file> --values <values.json> [options]
  kordoc-api fill --template <gian|gian-simple|일반기안문|간이기안문> --values <values.json> [options]
  kordoc-api redact <file> [options]

  kordoc-api parse <file> [options]

Formats (auto-detected): HWP, HWPX, PDF, XLSX, XLS, DOCX, PPTX, images. PPTX: one slide = one page.

Fill options:
  --values <values.json>
      Required JSON object containing fill values.
      Values are read from the file and are not expanded into the shell command line.

  --formats <formats.json>
      Optional JSON object containing per-field format rules.

  --require-unique
      Reject scalar fields that match multiple locations.

  --mask-values
      Hide filled values from API response metadata.
      The actual document still receives the original values.

  --format <markdown|hwpx|hwpx-preserve>
      Output format. Default: markdown.
      Binary formats require -o.

  -o, --output <path>
      Required for hwpx and hwpx-preserve.

Redact options:
  --rules <rules.json>
      Optional JSON array of redaction rule names.

  --mask-char <character>
      Optional mask character.

  --dry-run
      Return the redaction report without modifying the document.

  -o, --output <path>
      Required unless --dry-run is used.
      HWP/HWPX produces a redacted document.
      Other supported formats produce redacted Markdown.

Parse options:
  --ocr <false|true|force>
      OCR mode. Default: false

  --ocr-rec <handwriting|auto|printed>
      OCR recognition model. Omit for the default: since kordoc 4.24.42 the service re-reads pages with
      clearly handwritten text (page confidence < .85) with the handwriting model by itself.
      handwriting = Korean handwriting/official-form model (kordoc 4.22.6+, ~15 MB, downloaded on first use).
      printed = default model only, never uses or downloads the handwriting model (REST API 1.11.0+).
      auto = more generous thresholds for switching pages to the handwriting model; downloads it up front (API 1.11.0+).
      Only has an effect together with --ocr true|force.

  --ocr-det <mobile|server|medium>
      OCR detection model (kordoc 4.22.0+). Default: mobile. server = PP-OCRv5 server det (88 MB,
      downloaded on first use). medium = PP-OCRv6 medium det (~62 MB, downloaded on first use; REST API 1.11.0+):
      for tilted, blurred, scanned or noisy pages. Only has an effect together with --ocr true|force.

  --ocr-det-long-side <32-4096>
      Long side of the OCR detection input in pixels (kordoc 4.22.0+). Default: 960.
      Only has an effect together with --ocr true|force.

  --ocr-lines <true|false|all>
      Full parse only (parse; ignored by other subcommands). Return the lines read by the built-in OCR as ocrLines[]
      in the JSON output (kordoc 4.24.4, REST API 1.10.0+; PDF and image input). One item per page:
      {pageNumber,width,height,scale,deskewAngle,lines:[{text,box:{x,y,w,h},confidence}]}. box is in OCR raster
      pixels, origin top-left, not PDF points (divide by scale). true = lines used to build blocks;
      all = also dropped low-confidence lines (dropped: true). Default off.
      Only has an effect together with --ocr true|force.

  --include-blocks <true|false>
      Include parsed block data. Default: true

  --include-field-placeholders <true|false>
      Keep the guidance text of unfilled form fields (kordoc 4.15.7+).
      Blank public-sector forms carry their meaning in that text. Default: false

  --plain <true|false>
      Drop image placeholders, link URLs, underline and bold markup and keep the
      text. Heading, list and table structure are unchanged. Default: false

  --html-tables <true|false>
      Emit every table as indented HTML instead of GFM pipe tables. Default: false

  --table-format <gfm>
      parse, metadata and parse-pages only (kordoc 4.19.0+). gfm = merged and nested tables
      also come out as GFM pipe tables, never HTML (a vertical merge repeats the value on
      every row; a nested table follows its parent with a parent_id comment). Sent only
      when given; without it the output is unchanged. Cannot be combined with
      --html-tables true. Only gfm is accepted.

Common parse options (parse, metadata, parse-pages, parse-chunks, parse-table):
  Sent only when given; otherwise the engine default applies.

  --pages <range>
      Page/section range, 1-based: 3, 1-3, 1,3,5-7. PDF: exact pages. HWP/HWPX: section
      approximation. PPTX: slides. A range outside the document returns an empty result
      with a PARTIAL_PARSE warning.

  --images <true|false>
      Extract image bytes. false = text-only callers (placeholders stay).

  --remove-header-footer <true|false>
      PDF: drop repeated header/footer blocks. Default true; false keeps repeated headings.

  --script-tags <true|false>
      Write superscript/subscript as <sup>/<sub>. Default depends on the format: on for
      HWPX/HWP/DOCX/PPTX, off for PDF (recommended for papers). false = plain text everywhere.

  --keep-trailing-empty-cols <true|false>
      Keep empty columns at the right edge of a table (input cells of forms).

  --layout-tables <visual|keep>
      Borderless frame tables (HWPX, HWP5, PDF). visual (default) = as seen; keep = original
      table structure (for round-trip patching and form filling).
      For the original structure of a form use: --layout-tables keep --keep-trailing-empty-cols true

  --classify-tables <true|false>
      Classify tables as data/layout/uncertain (blocks[].table.classification).

  --keep-empty-paragraphs <true|false>
      Keep empty paragraphs (HWPX).

  --formula-ocr <true|false>
      PDF formula OCR ($...$ / $$...$$). SLOW: 30-120 s per request. The models (~155 MB)
      are downloaded on first use if the server does not have them yet.

  --memos <true|false>
      HWPX/HWP5 (REST API 1.11.0+): also append the document's memos (Hancom "insert memo") to the end of the
      Markdown as a "메모" section. Default false. The memos[] field of the JSON result is returned either way.

  --qr-codes <true|false>
      Read QR codes inside images (all formats; REST API 1.11.0+). The values go to the image block's qr[] and to
      the line after the image placeholder in the Markdown. Default false. Works even with --images false.

  --drop-blank-images <true|false>
      Drop blank images (nearly one colour: empty plates, solid bands, faint gradients) from the image blocks,
      images and Markdown (REST API 1.11.0+). Default false. Only evaluated when image bytes are produced.

  --image-format <png|webp>
      Force every extracted image to one format: png or lossless webp (REST API 1.11.0+). Omit to keep the default
      (PNG for PDF images, the original bytes for other formats). Ignored with --images false.

  --image-placement <page-end|flow>
      PDF only (REST API 1.11.0+). page-end (default) = images are collected after the last block of their page.
      flow = images are placed in reading position between text blocks and image blocks get a bbox.

  --html-cell-links <true|false>
      Emit [text](URL), bare URLs and QR URLs inside HTML table cells as <a href> so merged/nested table cells are
      clickable (REST API 1.11.0+, kordoc 4.24.63+). Only http, https, mailto, tel and # links. Default false.
      Mostly useful together with --html-tables true or merged/nested tables.

  --dedupe-running-headers <true|false>
      Drop numbered running headers that an old HWP5 re-inserts on every page. Can also
      delete legitimately repeated numbering; default false.

  --inline-images <true|false>
      Inline images into the Markdown as base64 data URIs (HWP5 only). The response grows.

  --tables <true|false>
      PDF table detection. false = reading-order text only, for text-centred documents.

  --password-env <ENV_NAME> | --password-file <path>
      The open password of a protected HWPX or HWP3 document, taken from an environment
      variable (by NAME) or from a file (first line; keep it mode 600 and delete it after).
      The password is never put on the command line or in the process list. Use one of them.
      Example: KORDOC_PW='...' kordoc-api parse doc.hwpx --password-env KORDOC_PW

Lint:
  kordoc-api lint <file|-> checks Korean public-document notation (dates, times, amounts,
  attachments, symbols). --munche true also checks the gaejosik report style. The JSON
  result has ok/errors/warnings and the findings; ok:false is a normal result (exit 0).
  --strict exits with 1 when there is an error, like `kordoc lint`.

Environment:
  KORDOC_API_BASE
      Kordoc API base URL.
      Default: http://kordoc:3400

  KORDOC_API_TOKEN
      Optional Bearer token.

  KORDOC_API_TIMEOUT
      Request timeout in seconds.
      Default: 600
USAGE
}

curl_common=(
  --silent
  --show-error
  --connect-timeout 10
  --max-time "$KORDOC_API_TIMEOUT"
)

if [[ -n "$KORDOC_API_TOKEN" ]]; then
  curl_common+=(
    -H "Authorization: Bearer $KORDOC_API_TOKEN"
  )
fi

require_file() {
  local file="$1"

  [[ -f "$file" ]] \
    || die "file not found: $file"

  [[ -r "$file" ]] \
    || die "file is not readable: $file"
}

save_returned_files() {
  # $1 = 응답 JSON 파일, $2 = 출력 폴더. files[] 의 base64 를 폴더에 쓰고 저장 목록(JSON 배열)을 stdout 으로 낸다.
  local response="$1" dir="$2" count i name target saved="[]"

  mkdir -p "$dir" || die "cannot create output directory: $dir"
  count="$(jq '[.files[]?] | length' "$response")"

  for (( i = 0; i < count; i++ )); do
    name="$(jq -r ".files[$i].name" "$response")"
    [[ "$name" =~ ^[A-Za-z0-9._-]+$ && "$name" != .* ]] || die "unsafe file name from server: $name"
    target="${dir%/}/$name"
    [[ ! -e "$target" ]] || die "refusing to overwrite existing output: $target"
    jq -r ".files[$i].data" "$response" | base64 -d >"$target"
    [[ -s "$target" ]] || { rm -f "$target"; die "empty file from server: $name"; }
    saved="$(jq -c --arg o "$(realpath "$target")" --argjson b "$(stat -c '%s' "$target")" '. + [{output: $o, bytes: $b}]' <<<"$saved")"
  done

  printf '%s' "$saved"
}

semantic_ok() {
  jq -e '
    if type != "object" then
      true
    elif (has("success") and .success == false) then
      false
    elif (has("ok") and .ok == false) then
      false
    else
      true
    end
  ' >/dev/null
}

request_json() {
  local method="$1"
  local path="$2"
  shift 2

  local tmp
  local http_code

  tmp="$(mktemp)"

  if ! http_code="$(
    curl "${curl_common[@]}" \
      -X "$method" \
      "$@" \
      -o "$tmp" \
      -w '%{http_code}' \
      "${KORDOC_API_BASE}${path}"
  )"; then
    if [[ -s "$tmp" ]]; then
      cat "$tmp" >&2
      echo >&2
    fi

    rm -f "$tmp"
    die "request failed: ${method} ${path}"
  fi

  if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
    if [[ -s "$tmp" ]]; then
      cat "$tmp" >&2
      echo >&2
    fi

    rm -f "$tmp"
    die "HTTP ${http_code}: ${method} ${path}"
  fi

  if ! jq -e . "$tmp" >/dev/null 2>&1; then
    cat "$tmp" >&2 || true
    echo >&2

    rm -f "$tmp"
    die "Kordoc returned invalid JSON"
  fi

  if ! semantic_ok < "$tmp"; then
    jq . "$tmp" >&2

    rm -f "$tmp"
    die "Kordoc reported operation failure"
  fi

  jq . "$tmp"
  rm -f "$tmp"
}

require_json_object() {
  local file="$1"
  local label="$2"

  require_file "$file"

  jq -e 'type == "object"' "$file" >/dev/null \
    || die "${label} must be a JSON object: $file"
}

require_json_array() {
  local file="$1"
  local label="$2"

  require_file "$file"

  jq -e 'type == "array"' "$file" >/dev/null \
    || die "${label} must be a JSON array: $file"
}

require_output_path() {
  local output="$1"
  local operation="$2"
  local output_dir

  [[ -n "$output" ]] \
    || die "${operation} requires -o <output>"

  [[ ! -e "$output" ]] \
    || die "refusing to overwrite existing output: $output"

  output_dir="$(dirname "$output")"

  [[ -d "$output_dir" ]] \
    || die "output directory does not exist: $output_dir"
}

header_value() {
  local header="$1"
  local file="$2"

  grep -i "^${header}:" "$file" 2>/dev/null \
    | tail -n 1 \
    | cut -d: -f2- \
    | sed 's/^[[:space:]]*//;s/\r$//' \
    || true
}

# ---- 파싱 계열 공통 옵션 (API 1.5.0~, kordoc ParseOptions 나머지 전부) -------------------
# 값이 «주어진 것만» common_form 에 쌓는다. 안 주면 서버(엔진) 기본값이 쓰인다.
common_form=()
pwfile=""
password_set=0
trap 'rm -f "$pwfile"' EXIT
consumed=0
allow_table_format=0   # parse·metadata·parse-pages 만 1 로 올린다
table_format_set=0

consume_common_option() {
  # $@ = 남은 인자. 공통 옵션이면 common_form 에 쌓고 consumed=2 로 두고 0, 아니면 1 을 돌려준다.
  local opt="${1:-}" field kind val

  case "$opt" in
    --ocr-rec)                 field=ocrRec;               kind=ocrrec ;;
    --ocr-det)                 field=ocrDet;               kind=ocrdet ;;
    --ocr-det-long-side)       field=ocrDetLongSide;       kind=ocrlong ;;
    --ocr-lines)               field=ocrLines;             kind=ocrlines ;;
    --memos)                   field=memos;                kind=bool ;;
    --qr-codes)                field=qrCodes;              kind=bool ;;
    --drop-blank-images)       field=dropBlankImages;      kind=bool ;;
    --html-cell-links)         field=htmlCellLinks;        kind=bool ;;
    --image-format)            field=imageFormat;          kind=imgfmt ;;
    --image-placement)         field=imagePlacement;       kind=imgplace ;;
    --pages)                   field=pages;                kind=pages ;;
    --images)                  field=images;               kind=bool ;;
    --remove-header-footer)    field=removeHeaderFooter;   kind=bool ;;
    --script-tags)             field=scriptTags;           kind=bool ;;
    --keep-trailing-empty-cols) field=keepTrailingEmptyCols; kind=bool ;;
    --layout-tables)           field=layoutTables;         kind=layout ;;
    --classify-tables)         field=classifyTables;       kind=bool ;;
    --keep-empty-paragraphs)   field=keepEmptyParagraphs;  kind=bool ;;
    --formula-ocr)             field=formulaOcr;           kind=bool ;;
    --dedupe-running-headers)  field=dedupeRunningHeaders; kind=bool ;;
    --inline-images)           field=inlineImages;         kind=bool ;;
    --tables)                  field=tables;               kind=bool ;;
    --table-format)            [[ "$allow_table_format" == 1 ]] || return 1
                               field=tableFormat;          kind=tableformat ;;
    --password-env)            field=password;             kind=passenv ;;
    --password-file)           field=password;             kind=passfile ;;
    *) return 1 ;;
  esac

  [[ $# -ge 2 ]] || die "$opt requires a value"
  val="$2"

  case "$kind" in
    bool)
      [[ "$val" == true || "$val" == false ]] || die "invalid $opt value: $val (true|false)"
      ;;
    tableformat)
      [[ "$val" == gfm ]] || die "invalid $opt value: $val (gfm)"
      table_format_set=1
      ;;
    ocrrec)
      [[ "$val" == handwriting || "$val" == auto || "$val" == printed ]] || die "invalid $opt value: $val (handwriting|auto|printed)"
      ;;
    ocrdet)
      [[ "$val" == mobile || "$val" == server || "$val" == medium ]] || die "invalid $opt value: $val (mobile|server|medium)"
      ;;
    ocrlines)
      [[ "$val" == true || "$val" == false || "$val" == all ]] || die "invalid $opt value: $val (true|false|all)"
      ;;
    imgfmt)
      [[ "$val" == png || "$val" == webp ]] || die "invalid $opt value: $val (png|webp)"
      ;;
    imgplace)
      [[ "$val" == page-end || "$val" == flow ]] || die "invalid $opt value: $val (page-end|flow)"
      ;;
    ocrlong)
      if ! [[ "$val" =~ ^[0-9]{2,4}$ ]] || (( 10#$val < 32 || 10#$val > 4096 )); then
        die "invalid $opt value: $val (32-4096)"
      fi
      ;;
    layout)
      [[ "$val" == visual || "$val" == keep ]] || die "invalid $opt value: $val (visual|keep)"
      ;;
    pages)
      [[ "$val" =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] \
        || die "invalid $opt value: $val (예: 3, 1-3, 1,3,5-7)"
      ;;
    passenv|passfile)
      [[ "$password_set" == 0 ]] || die "--password-env 와 --password-file 은 하나만 쓴다"
      pwfile="$(mktemp)"
      chmod 600 "$pwfile"
      if [[ "$kind" == passenv ]]; then
        [[ "$val" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
          || die "--password-env 는 환경변수 «이름» 을 받는다 (암호 값을 명령줄에 쓰지 않는다)"
        [[ -n "${!val:-}" ]] || die "환경변수 $val 이 비어 있거나 없다"
        printf '%s' "${!val}" > "$pwfile"
      else
        require_file "$val"
        # 파일 끝의 줄바꿈은 암호가 아니다 — 명령 치환이 떼어 낸다
        printf '%s' "$(cat "$val")" > "$pwfile"
        [[ -s "$pwfile" ]] || die "암호 파일이 비어 있다: $val"
      fi
      password_set=1
      common_form+=( -F "password=<${pwfile}" )
      consumed=2
      return 0
      ;;
  esac

  common_form+=( -F "${field}=${val}" )
  consumed=2
  return 0
}

command="${1:-}"

case "$command" in
  health)
    [[ $# -eq 1 ]] || die "usage: kordoc-api health"
    request_json GET /health
    ;;

  version)
    [[ $# -eq 1 ]] || die "usage: kordoc-api version"
    request_json GET /version
    ;;

  generate-hwpx)
    [[ $# -ge 4 ]] \
      || die "usage: kordoc-api generate-hwpx <markdown-file> -o <output.hwpx> [--options <options.json>]"

    markdown_file="$2"
    require_file "$markdown_file"

    output=""
    options_file=""

    shift 2

    while [[ $# -gt 0 ]]; do
      case "$1" in
        -o|--output)
          [[ $# -ge 2 ]] || die "$1 requires a path"
          output="$2"
          shift 2
          ;;

        --options)
          [[ $# -ge 2 ]] || die "--options requires a JSON file"
          options_file="$2"
          shift 2
          ;;

        *)
          die "unknown generate-hwpx option: $1"
          ;;
      esac
    done

    [[ -n "$output" ]] \
      || die "generate-hwpx requires -o <output.hwpx>"

    [[ ! -e "$output" ]] \
      || die "refusing to overwrite existing output: $output"

    output_dir="$(dirname "$output")"
    [[ -d "$output_dir" ]] \
      || die "output directory does not exist: $output_dir"

    payload="$(mktemp)"
    tmp_output="$(mktemp "${output_dir}/.kordoc-api-hwpx.XXXXXX")"

    cleanup_generate() {
      rm -f "$payload" "$tmp_output"
    }

    if [[ -n "$options_file" ]]; then
      require_file "$options_file"

      if ! jq -e 'type == "object"' "$options_file" >/dev/null; then
        cleanup_generate
        die "options must be a JSON object: $options_file"
      fi

      jq -n \
        --rawfile markdown "$markdown_file" \
        --slurpfile opts "$options_file" \
        '{
          markdown: $markdown,
          options: $opts[0]
        }' > "$payload"
    else
      jq -n \
        --rawfile markdown "$markdown_file" \
        '{
          markdown: $markdown,
          options: {}
        }' > "$payload"
    fi

    if ! meta="$(
      curl "${curl_common[@]}" \
        -X POST \
        -H 'Content-Type: application/json' \
        --data-binary "@${payload}" \
        -o "$tmp_output" \
        -w $'%{http_code}\n%{content_type}' \
        "${KORDOC_API_BASE}/v1/document/generate/hwpx"
    )"; then
      if [[ -s "$tmp_output" ]]; then
        cat "$tmp_output" >&2 || true
        echo >&2
      fi

      cleanup_generate
      die "request failed: POST /v1/document/generate/hwpx"
    fi

    http_code="$(printf '%s\n' "$meta" | sed -n '1p')"
    content_type="$(printf '%s\n' "$meta" | sed -n '2p')"

    if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
      cat "$tmp_output" >&2 || true
      echo >&2

      cleanup_generate
      die "HTTP ${http_code}: POST /v1/document/generate/hwpx"
    fi

    if [[ ! -s "$tmp_output" ]]; then
      cleanup_generate
      die "Kordoc returned an empty HWPX"
    fi

    case "${content_type%%;*}" in
      application/hwp+zip|application/zip|application/octet-stream)
        ;;
      *)
        file "$tmp_output" >&2 || true
        cleanup_generate
        die "unexpected Content-Type: ${content_type:-unknown}"
        ;;
    esac

    if ! file "$tmp_output" | grep -Eqi 'HWPX|Zip archive'; then
      file "$tmp_output" >&2 || true
      cleanup_generate
      die "response is not recognized as HWPX/ZIP"
    fi

    mv "$tmp_output" "$output"
    rm -f "$payload"

    bytes="$(stat -c '%s' "$output")"

    jq -n \
      --arg output "$(realpath "$output")" \
      --arg contentType "$content_type" \
