        mv "$tmp_output" "$output"

        hit_count="$(header_value x-kordoc-redaction-hits "$headers")"
        skipped_count="$(header_value x-kordoc-redaction-skipped "$headers")"

        rm -f "$headers"

        bytes="$(stat -c '%s' "$output")"

        jq -n \
          --arg output "$(realpath "$output")" \
          --arg contentType "$content_type" \
          --arg hitCount "${hit_count:-0}" \
          --arg skippedCount "${skipped_count:-0}" \
          --argjson bytes "$bytes" \
          '{
            success: true,
            output: $output,
            contentType: $contentType,
            bytes: $bytes,
            hitCount: ($hitCount | tonumber? // 0),
            skippedCount: ($skippedCount | tonumber? // 0)
          }'
        ;;

      *)
        file "$tmp_output" >&2 || true
        rm -f "$tmp_output" "$headers"
        die "unexpected Content-Type: ${content_type:-unknown}"
        ;;
    esac
    ;;

