    output_dir="$(dirname "$output")"
    tmp_output="$(mktemp "${output_dir}/.kordoc-api-redact.XXXXXX")"
    headers="$(mktemp)"

    if ! meta="$(
      curl "${curl_common[@]}" \
        -X POST \
        "${form_args[@]}" \
        -D "$headers" \
        -o "$tmp_output" \
        -w $'%{http_code}\n%{content_type}' \
        "${KORDOC_API_BASE}/v1/document/redact"
    )"; then
      if [[ -s "$tmp_output" ]]; then
        cat "$tmp_output" >&2 || true
        echo >&2
      fi

      rm -f "$tmp_output" "$headers"
      die "request failed: POST /v1/document/redact"
    fi

    http_code="$(printf '%s\n' "$meta" | sed -n '1p')"
    content_type="$(printf '%s\n' "$meta" | sed -n '2p')"

    if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
      cat "$tmp_output" >&2 || true
      echo >&2

      rm -f "$tmp_output" "$headers"
      die "HTTP ${http_code}: POST /v1/document/redact"
    fi

    case "${content_type%%;*}" in
      application/json)
        if ! jq -e . "$tmp_output" >/dev/null 2>&1; then
          cat "$tmp_output" >&2 || true
          rm -f "$tmp_output" "$headers"
          die "Kordoc returned invalid JSON"
        fi

        if ! semantic_ok <"$tmp_output"; then
          jq . "$tmp_output" >&2
