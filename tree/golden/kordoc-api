  profile-extract)
    [[ $# -ge 4 ]] \
      || die "usage: kordoc-api profile-extract <reference.hwpx> -o <profile.json>"

    file="$2"
    require_file "$file"

    output=""
    shift 2

    while [[ $# -gt 0 ]]; do
      case "$1" in
