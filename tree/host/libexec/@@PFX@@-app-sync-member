#!/usr/bin/env python3
"""@@PFX@@-app-sync-member — «멤버 권한»으로 실행된다(@@PFX@@-app-sync 가 setpriv 로 부른다). root 가 멤버 폴더를 직접 만지지 않게 하려는 분리다.
  read <home>              ~/.@@PFX@@/apps/*.app 요청 목록을 JSON 으로 출력
  write <home> <파일명>     표준입력을 ~/.@@PFX@@/apps/<파일명> 에 쓴다(.status · .ports · .site 만, 링크는 거부)
  present <home>           ~/.@@PFX@@/apps 에 실제로 있는 .ports · *.status 파일 이름을 JSON 으로 출력(멤버를 지웠다 다시 만든 뒤 안내 파일 복구용)
  static <workspace>       workspace/<프로젝트>/publish 목록을 JSON 으로 출력(파일 수·크기·.publish-off 여부)
"""
import json, os, pwd, re, subprocess, sys

APP_FILE = re.compile(r'^([a-z][a-z0-9-]{1,30})\.app$')
WRITABLE = re.compile(r'^(\.ports|\.site|[a-z][a-z0-9-]{1,30}\.(status|secret))$')
PROJ = re.compile(r'^[A-Za-z0-9_-]+$')
KEYS = ('port', 'access', 'days', 'start', 'renewed', 'dir')
DIR_RE = re.compile(r'^/(workspace|shared/workspaces)/[A-Za-z0-9_-]+/app(/[A-Za-z0-9._-]+)*$')   # 앱 소스 폴더(위치 규칙)


def real_dir(p):
    try:
        st = os.lstat(p)
    except OSError:
        return False
    return os.path.isdir(p) and not os.path.islink(p) and st.st_mode & 0o170000 == 0o040000


def apps_dir(home):
    d = os.path.join(home, '.@@PFX@@', 'apps')
    return d if real_dir(os.path.join(home, '.@@PFX@@')) and real_dir(d) else None


def ensure_apps_dir(home):
    """~/.@@PFX@@ 이 진짜 폴더일 때만 apps 폴더를 만든다(0700). 링크면 만들지 않는다."""
    d = apps_dir(home)
    if d:
        return d
    base = os.path.join(home, '.@@PFX@@')
    if not real_dir(base):
        return None
    d = os.path.join(base, 'apps')
    if os.path.lexists(d):
        return None
    os.mkdir(d, 0o700)
    return d


def cmd_read(home):
    d = apps_dir(home)
    out = []
    if d:
        for fn in sorted(os.listdir(d)):
            m = APP_FILE.match(fn)
            if not m:
                continue
            p = os.path.join(d, fn)
            item = {'name': m.group(1), 'ok': True, 'error': '', 'port': None, 'access': 'public', 'days': None, 'start': '', 'renewed': '', 'dir': ''}
            try:
                fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)   # 링크·FIFO 로 바꿔치기해도 열기에서 막히지 않게
                with os.fdopen(fd, encoding='utf-8') as f:
                    st = os.fstat(f.fileno())
                    if st.st_mode & 0o170000 != 0o100000:
                        raise ValueError('일반 파일이 아님(링크 등)')
                    if st.st_size > 2048:
                        raise ValueError('요청 파일이 너무 큼(2KB 초과)')
                    for line in f:
                        line = line.strip()
                        if not line or line.startswith('#'):
                            continue
                        k, sep, v = line.partition('=')
                        k, v = k.strip(), v.strip()
                        if not sep or k not in KEYS:
                            raise ValueError(f'알 수 없는 줄: {line[:40]!r}')
                        if k in ('port', 'days'):
                            if not re.fullmatch(r'[0-9]{1,5}', v):
                                raise ValueError(f'{k} 는 숫자')
                            item[k] = int(v)
                        elif k == 'dir':
                            if not DIR_RE.match(v) or '/publish' in v + '/' or '/.private' in v + '/':
                                raise ValueError('dir 은 /workspace/<프로젝트>/app 아래만(publish·.private 불가)')
                            item[k] = v
                        else:
                            item[k] = v[:300]
            except (OSError, ValueError, UnicodeDecodeError) as e:
                item['ok'] = False
                item['error'] = str(e)
            out.append(item)
    print(json.dumps(out, ensure_ascii=False))


def cmd_write(home, name):
    if not WRITABLE.match(name):
        sys.exit('허용되지 않는 파일명')
    d = ensure_apps_dir(home)
    if not d:
        sys.exit('apps 폴더를 만들 수 없음(~/.@@PFX@@ 이 없거나 링크)')
    data = sys.stdin.buffer.read(4096)
    p = os.path.join(d, name)
    tmp = p + '.tmp'
    # FIFO 로 바꿔치기해도 열기에서 막히지 않게 O_NONBLOCK(읽기 쪽과 같다). 열린 뒤 일반 파일인지 다시 본다
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    except OSError as e:
        sys.exit('쓸 수 없음: %s' % e.strerror)
    with os.fdopen(fd, 'wb') as f:
        if os.fstat(f.fileno()).st_mode & 0o170000 != 0o100000:
            sys.exit('일반 파일이 아님(FIFO 등)')
        f.write(data)
    os.replace(tmp, p)


def cmd_present(home):
    d = apps_dir(home)
    out = []
    if d:
        for n in sorted(os.listdir(d)):
            if WRITABLE.match(n) and n.endswith(('.ports', '.status')):
                try:
                    st = os.lstat(os.path.join(d, n))
                except OSError:
                    continue
                if st.st_mode & 0o170000 == 0o100000:
                    out.append(n)
    print(json.dumps(out))


def caddy_uid():
    try:
        return pwd.getpwnam('caddy').pw_uid
    except KeyError:
        return 995


def cmd_static(ws):
    out = []
    if not real_dir(ws):
        print('[]')
        return
    for proj in sorted(os.listdir(ws)):
        pd = os.path.join(ws, proj)
        d = os.path.join(pd, 'publish')
        if not PROJ.match(proj) or not real_dir(pd) or not real_dir(d):
            continue
        files = size = 0
        for root, dirs, fns in os.walk(d, followlinks=False):
            dirs[:] = [x for x in dirs if not x.startswith('.')]
            for fn in fns:
                if fn.startswith('.'):
                    continue
                try:
                    st = os.lstat(os.path.join(root, fn))
                except OSError:
                    continue
                if st.st_mode & 0o170000 == 0o100000:
                    files += 1
                    size += st.st_size
        off = os.path.lexists(os.path.join(pd, '.publish-off'))
        out.append({'project': proj, 'files': files, 'bytes': size, 'off': off})   # 공개 여부는 root(@@PFX@@-app-sync)가 v3 상태·사본으로 판단한다(v1 caddy ACL 판단 제거)
    print(json.dumps(out, ensure_ascii=False))


if __name__ == '__main__':
    a = sys.argv[1:]
    if len(a) == 2 and a[0] == 'read':
        cmd_read(a[1])
    elif len(a) == 3 and a[0] == 'write':
        cmd_write(a[1], a[2])
    elif len(a) == 2 and a[0] == 'present':
        cmd_present(a[1])
    elif len(a) == 2 and a[0] == 'static':
        cmd_static(a[1])
    else:
        sys.exit(__doc__)
