#!/usr/bin/env python3
# @@PFX@@-admin-setup — 웹 관리 화면(admin 모듈) 운영 도구. 사용: sudo @@PFX@@-admin-setup status|totp-enroll|totp-reset|unlock|remove
#   비밀(TOTP 비밀·복구 코드)은 인자·환경변수로 받지 않고, 만든 값은 «터미널에 한 번만» 보여 준다(출력이 터미널이 아니면 만들지 않는다 — 로그·파일로 새지 않게).
#   TOTP 파일은 도우미가 읽는 단일 JSON(root 0600). 형식·쓰기는 admin_common 규약을 그대로 쓴다.
import os, shutil, subprocess, sys
PFX = "@@PFX@@"
sys.dont_write_bytecode = True
sys.path.insert(0, f"/usr/local/libexec/{PFX}-admin")
import admin_common as C   # noqa: E402

TOTP = f"/etc/{PFX}/secrets/admin-totp"
SITE = f"/etc/{PFX}/site.env"
UNITS = [f"{PFX}-admin-web.service", f"{PFX}-admin-helper.service"]

def die(msg, rc=1): print(f"실패: {msg}", file=sys.stderr); sys.exit(rc)

def site():
    d = {}
    try:
        for l in open(SITE, encoding="utf-8"):
            if "=" in l and not l.lstrip().startswith("#"): k, v = l.split("=", 1); d[k.strip()] = v.strip().strip("'\"")
    except OSError: pass
    return d

def enrolled(): return os.path.lexists(TOTP)

def active(u): return subprocess.run(["systemctl", "is-active", "--quiet", u]).returncode == 0

def status():
    s = site(); print(f"== {PFX}-admin-setup 상태")
    print(f"관리자 계정: {s.get('ADMIN_USER', '(site.env 에 없음)')}")
    for u in UNITS: print(f"{u}: {'동작 중' if active(u) else '중지'}")
    if not enrolled(): print("TOTP: 등록 안 됨 — sudo %s-admin-setup totp-enroll" % PFX); return
    try: d = C.load_totp_file(TOTP, uid=0); print(f"TOTP: 등록됨 · 남은 복구 코드 {len(d['recovery'])}개 · 파일 권한 정상")
    except (OSError, ValueError, PermissionError) as e: print(f"TOTP: 등록 파일에 문제가 있습니다({type(e).__name__}) — 권한은 root 0600 이어야 합니다")

def need_root():
    if os.geteuid() != 0: die("root 로 실행하세요(sudo)")

def enroll(replace):
    if not sys.stdout.isatty(): die("비밀을 한 번만 보여 주므로 터미널에서만 실행합니다(출력을 파일·파이프로 보내지 마세요)")
    s = site(); acct = s.get("ADMIN_USER", "admin"); brand = s.get("BRAND", PFX)
    secret = C.new_secret(); codes = C.new_recovery_codes()
    C.dump_totp_file(TOTP, secret, [C.hash_recovery(c, os.urandom(16)) for c in codes], 0, uid=0)   # 먼저 저장하고, 저장되면 보여 준다
    print("== TOTP 등록 — 아래 내용은 지금 한 번만 표시됩니다. 인증 앱에 등록하고 복구 코드는 따로 보관하세요.\n")
    uri = C.otpauth_uri(secret, acct, brand)
    print(f"otpauth 주소(인증 앱에 붙여 넣거나 아래 QR 을 스캔):\n  {uri}\n")
    qr = shutil.which("qrencode")
    if qr:   # 주소는 인자가 아니라 표준입력으로만 넘긴다(ps 에 비밀이 보이지 않게). 실패하면 글자 주소만 남는다
        sys.stdout.flush()
        try: subprocess.run([qr, "-t", "ANSIUTF8"], input=uri.encode(), check=False)
        except OSError: pass
        print()
    print("복구 코드(각각 1회용 — 인증 앱을 잃었을 때 로그인에만 쓸 수 있고 step-up 에는 못 씁니다):")
    for c in codes: print(f"  {c}")
    if replace: print("\n안내: 기존 비밀이 바뀌어 열려 있던 웹 세션은 모두 끊깁니다.")
    print("\n끝났습니다. 이 화면을 닫기 전에 저장했는지 확인하세요(다시 볼 수 없습니다).")

def confirm(phrase):
    print(f"계속하려면 다음 문구를 그대로 입력하세요: {phrase}")
    if input("> ").strip() != phrase: die("문구가 달라 취소했습니다", 2)

def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "status": return status()
    need_root()
    if cmd == "totp-enroll":
        if enrolled(): die(f"이미 등록돼 있습니다. 바꾸려면 sudo {PFX}-admin-setup totp-reset (등록된 인증 앱·복구 코드가 모두 무효가 됩니다)", 2)
        return enroll(False)
    if cmd == "totp-reset":
        if not enrolled(): die(f"등록된 TOTP 가 없습니다 — sudo {PFX}-admin-setup totp-enroll")
        confirm(f"RESET {PFX} TOTP"); return enroll(True)
    if cmd == "unlock":
        print("로그인 실패 잠금(IP·계정)은 도우미 메모리에만 있어 도우미를 다시 시작하면 풀립니다. 열려 있던 웹 세션도 모두 끊깁니다.")
        if "--restart" in argv[1:]:
            rc = subprocess.run(["systemctl", "restart", f"{PFX}-admin-helper.service"]).returncode
            print("성공: 도우미 재시작" if rc == 0 else "실패: 도우미 재시작 실패"); return rc
        print(f"실행할 명령: sudo systemctl restart {PFX}-admin-helper   (또는 이 명령에 --restart)"); return 0
    if cmd == "remove":
        confirm(f"REMOVE {PFX} ADMIN")
        for u in UNITS: subprocess.run(["systemctl", "disable", "--now", u], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if "--purge-totp" in argv[1:] and enrolled(): os.unlink(TOTP); print("TOTP 파일 삭제됨")
        print(f"성공: 서비스 중지·자동 시작 해제(TOTP 파일은 {'삭제' if '--purge-totp' in argv[1:] else '보존'})")
        print(f"완전히 끄려면 site.env 의 MODULES 에서 admin 을 빼고 sudo python3 /opt/devmaru-kit/bin/devmaru-install --config {SITE} --yes --only 50,54 를 실행하세요(유닛·PAM 파일·Caddy 블록이 제거됩니다)")
        return 0
    print(f"사용: {PFX}-admin-setup status | totp-enroll | totp-reset | unlock [--restart] | remove [--purge-totp]", file=sys.stderr); return 2

if __name__ == "__main__": sys.exit(main(sys.argv[1:]))
