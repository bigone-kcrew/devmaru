JS = r"""
(function(){var r=document.documentElement;function cur(){return r.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light')}
document.querySelectorAll('[data-theme-toggle]').forEach(function(b){b.addEventListener('click',function(){var n=cur()==='dark'?'light':'dark';r.setAttribute('data-theme',n);try{localStorage.setItem('adm-theme',n)}catch(e){}})})})();
document.querySelectorAll('header nav a').forEach(function(a){if(a.getAttribute('href')===location.pathname)a.setAttribute('aria-current','page')});
function paint(el,text){while(el.firstChild)el.removeChild(el.firstChild);text.split('\n').forEach(function(l,i,all){if(i===all.length-1&&l==='')return;var s=document.createElement('span');var c='ln';if(/^\[\d+\/\d+\]/.test(l))c+=' step';else if(/^(OK|성공)/.test(l))c+=' ok';else if(/^(경고|WARN)/.test(l))c+=' warn';else if(/^(실패|FAIL|오류|ERROR)/.test(l))c+=' err';else if(/^(=+|-+)$/.test(l.trim()))c+=' dim';s.className=c;s.textContent=l===''?' ':l;el.appendChild(s)})}
document.querySelectorAll('pre.log').forEach(function(p){paint(p,p.textContent)});
document.querySelectorAll('[data-copy]').forEach(function(b){b.addEventListener('click',function(){var t=document.getElementById(b.dataset.copy).textContent;if(navigator.clipboard){navigator.clipboard.writeText(t).then(function(){b.textContent='복사됨'},function(){b.textContent='복사 실패 - 직접 선택하세요'})}else{b.textContent='이 브라우저는 복사를 지원하지 않습니다 - 직접 선택하세요'}})});
document.querySelectorAll('[data-job]').forEach(function(box){var log=document.getElementById('joblog');var stop=setInterval(function(){fetch(box.dataset.job,{credentials:'same-origin',cache:'no-store'}).then(function(r){return r.ok?r.json():{state:'x'}}).then(function(j){if(j.state==='queued'||j.state==='running'){if(log&&typeof j.log==='string')paint(log,j.log)}else{clearInterval(stop);location.reload()}}).catch(function(){})},2000)});
document.querySelectorAll('input[data-focus]').forEach(function(e){e.focus()});
document.querySelectorAll('input[inputmode=numeric]').forEach(function(e){e.addEventListener('input',function(){e.value=e.value.replace(/[^0-9a-zA-Z-]/g,'')})});
