def err_text(r):
    e = r.get("error"); return ERR_TEXT.get(e, "처리하지 못했습니다.")

# ── HTTP ──
class H(BaseHTTPRequestHandler):
    timeout = 10          # 소켓 읽기 한 번의 제한. 요청 전체 시간은 아래 타이머가 따로 끊는다
    server_version = "adm"; sys_version = ""

    def setup(self):
        super().setup()
        self._dl = threading.Timer(CFG["deadline"], self._kill); self._dl.daemon = True; self._dl.start()
    def _kill(self):
        try: self.connection.shutdown(socket.SHUT_RDWR)
        except OSError: pass
    def finish(self):
        self._dl.cancel()
        try: super().finish()
        except OSError: pass
    def log_message(self, *a): pass

    # 직접 연결 상대가 127.0.0.1(Caddy)일 때만 전용 헤더를 믿는다. 아니면 헤더는 무시하고 연결 상대 주소를 쓴다. X-Forwarded-* 는 읽지 않는다.
    def who(self):
        peer = self.client_address[0]
        if peer != "127.0.0.1": return peer, "local"
        ip, via = peer, "local"
        try:
            v = ipaddress.ip_address(self.headers.get("X-Admin-Client-IP", "").strip())
            if "%" not in str(v): ip = str(v)
        except ValueError: pass
        w = self.headers.get("X-Admin-Via", "").strip()
        if w in VIA: via = w
        return ip, via

    def head(self, code, ctype, length, cookies=(), extra=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(length))
        self.send_header("Cache-Control", "public, max-age=86400" if ctype.startswith("font/") else "no-store")
        if not ctype.startswith("font/"): self.send_header("Pragma", "no-cache")
        self.send_header("Referrer-Policy", "same-origin")
        self.send_header("X-Robots-Tag", "noindex, nofollow, noarchive"); self.send_header("X-Content-Type-Options", "nosniff"); self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'")
        for c in cookies: self.send_header("Set-Cookie", c)
        for k, v in (extra or {}).items(): self.send_header(k, v)
        self.send_header("Connection", "close"); self.end_headers()

    def send(self, code, body=b"", ctype="text/html; charset=utf-8", cookies=(), extra=None):
        self.head(code, ctype, len(body), cookies, extra)
        if self.command != "HEAD": self.wfile.write(body)
        self.close_connection = True

    def simple(self, code, title, text, extra=None, cookies=()):
        self.send(code, page(title, f'<div class="card"><h1>{E(title)}</h1><p>{E(text)}</p></div>'), extra=extra, cookies=cookies)
    def redirect(self, to, cookies=()): self.send(303, b"", extra={"Location": to}, cookies=cookies)

    def cookie(self, name, rx):
        vals = []
        for h in self.headers.get_all("Cookie") or []:
            for part in h.split(";"):
                k, _, v = part.strip().partition("=")
                if k == name: vals.append(v)
        return vals[0] if len(vals) == 1 and rx.fullmatch(vals[0]) else ""   # 같은 이름이 여러 개면 없는 것으로 본다

    def set_cookie(self, name, value, age=None):
        return f"{name}={value}; Path=/; Secure; HttpOnly; SameSite=Strict" + (f"; Max-Age={age}" if age is not None else "")
    def clear(self, name): return self.set_cookie(name, "", 0)

    def read_form(self):
        if self.headers.get("Transfer-Encoding") is not None: return None
        if len(self.headers.get_all("Content-Length") or []) != 1: return None
        try: n = int(self.headers["Content-Length"])
        except ValueError: return None
        if n < 0 or n > MAX_BODY: return None
        if self.headers.get_content_type() != "application/x-www-form-urlencoded": return None
        raw = self.rfile.read(n)
        if len(raw) != n: return None
        try: q = parse_qs(raw.decode("utf-8"), keep_blank_values=True, max_num_fields=8)
        except (ValueError, UnicodeDecodeError): return None
        if any(len(v) != 1 for v in q.values()): return None
        return {k: v[0] for k, v in q.items()}

    def origin_ok(self):
        want = "https://" + self.headers.get("Host", "")
        o = self.headers.get("Origin")
        if o is None:
            r = self.headers.get("Referer")
            if not r: return False
            try: u = urlsplit(r); o = f"{u.scheme}://{u.netloc}"
            except ValueError: return False
        return o == want

    def route(self):
        try: self._route()
        except (OSError, ValueError) as e:
            log(f"요청 처리 중단 {type(e).__name__}"); self.close_connection = True
        except Exception as e:
            log(f"내부 오류 {type(e).__name__}")
            try: self.simple(500, "오류", "처리하지 못했습니다. 잠시 뒤에 다시 하세요.")
            except OSError: pass

    def _route(self):
        hosts = self.headers.get_all("Host") or []
        if len(hosts) != 1: return self.simple(400, "잘못된 요청", "Host 헤더가 올바르지 않습니다.")
        if hosts[0].lower() not in CFG["hosts"]: return self.simple(421, "허용되지 않는 주소", "이 주소로는 접속할 수 없습니다.")
        parts = self.requestline.split(); raw = parts[1] if len(parts) == 3 else ""
        path = raw.split("?", 1)[0]       # 쿼리는 쓰지 않는다. 경로는 원래 요청줄 그대로 정확히 비교한다(//·%2e 변형은 404)
        post = self.command == "POST"
        if path in STATIC:
            if post: return self.other()
            body, ctype = STATIC[path]
            return self.send(200, body, ctype)
        m = JOB_PATH.fullmatch(path)
        if m:
            if post and m.group(2) != "/secret" or not post and m.group(2) == "/secret": return self.other()
            fn = {"": self.job_get, "/status": self.job_json, "/secret": self.job_secret}[m.group(2)]
            return self.run(fn, post, m.group(1))
        m = ARCH_PATH.fullmatch(path)
        if m: return self.other() if post else self.run(self.archive_get, False, m.group(1), m.group(2))
        m = MEMBER_PATH.fullmatch(path)
        if m:      # 상세는 GET, 버튼(발급·폐기·상태·봉인·페어링)은 POST
            act = m.group(2)[1:]
            if post != bool(act): return self.other()
            return self.run(self.member_act, True, m.group(1), act) if act else self.run(self.member_get, False, m.group(1))
        table = {"/": (self.root, None), "/login": (self.login_get, self.login_post), "/logout": (None, self.logout_post),
                 "/members": (self.members, None), "/members/new": (self.new_get, self.new_post), "/stepup": (self.stepup_get, self.stepup_post)}
        if path not in table: return self.simple(404, "찾을 수 없음", "없는 주소입니다.")
        fn = table[path][1 if post else 0]
        if fn is None: return self.other()
        self.run(fn, post)

    def run(self, fn, post, *extra):
        ip, via = self.who(); form = None
        if post:
            if not self.origin_ok(): self.close_connection = True; return self.simple(403, "거부됨", "요청 출처가 올바르지 않습니다. 화면을 새로 열어 다시 하세요.")
            form = self.read_form()
            if form is None: self.close_connection = True; return self.simple(400, "잘못된 요청", "요청 형식이 올바르지 않거나 너무 큽니다.")
        self._dl.cancel()      # 요청을 다 받았다 — 이후는 도우미 처리 시간(느릴 수 있음)
        try: fn(ip, via, form, *extra)
        except HelperDown:
            log("도우미 연결 실패"); self.simple(503, "일시 중단", "관리 도우미에 연결할 수 없습니다. 서버 관리자에게 알리세요.")

    def other(self):
        self.simple(405, "허용되지 않는 요청", "GET · POST 만 받습니다.", {"Allow": "GET, POST"})

    # 세션 쿠키가 없거나 도우미가 no_session 이라고 하면 쿠키를 지우고 로그인 화면으로 보낸다
    def to_login(self): self.redirect("/login", [self.clear(SID_COOKIE)])

    def root(self, ip, via, form): self.redirect("/members")

    def login_get(self, ip, via, form, note=""):
        pre = self.cookie(PRE_COOKIE, PRE_RE); ck = []
        if not pre: pre = secrets.token_urlsafe(32); ck = [self.set_cookie(PRE_COOKIE, pre)]
        self.send(200, page("로그인", login_body(csrf_for(pre), note)), cookies=ck)

    def login_post(self, ip, via, form):
        pre = self.cookie(PRE_COOKIE, PRE_RE)
        if not csrf_ok(pre, form.get("csrf", "")): return self.simple(403, "거부됨", "화면이 오래되었습니다. 로그인 화면을 새로 열어 다시 하세요.")
        r = helper("login", ip, via, args={"user": form.get("user", ""), "password": form.get("password", ""), "code": form.get("code", "")})
        if r["ok"] and isinstance(r.get("result"), dict) and SID_RE.fullmatch(str(r["result"].get("sid", ""))):
            log(f"로그인 성공 ip={ip} via={via}")
            return self.redirect("/members", [self.set_cookie(SID_COOKIE, r["result"]["sid"]), self.clear(PRE_COOKIE)])
        e = r.get("error"); log(f"로그인 실패 ip={ip} via={via} error={e if e in ERR_TEXT or e in ('auth_failed', 'blocked') else '?'}")
        if e == "auth_failed": note = msg("비밀번호 또는 코드가 틀렸습니다.", True); code = 401
        elif e == "blocked": note = msg(f"시도가 너무 많습니다. {int(r.get('retry_after', 0)) // 60 + 1}분쯤 뒤에 다시 하세요.", True); code = 429
        else: note = msg(err_text(r), True); code = 400
        n = secrets.token_urlsafe(32)   # 실패 화면의 폼은 새 쿠키·새 토큰으로
        self.send(code, page("로그인", login_body(csrf_for(n), note)), cookies=[self.set_cookie(PRE_COOKIE, n)])

    def logout_post(self, ip, via, form):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        if not csrf_ok(sid, form.get("csrf", "")): return self.simple(403, "거부됨", "화면이 오래되었습니다. 새로 열어 다시 하세요.")
        try: helper("logout", ip, via, sid)
        except HelperDown: log("도우미 연결 실패")   # 그래도 쿠키는 지운다
        self.to_login()

    def members(self, ip, via, form):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        r = helper("member.list", ip, via, sid)
        if not r["ok"]:
            if r.get("error") == "no_session": return self.to_login()
            return self.send(502, page("회원", msg(err_text(r), True), nav_html(csrf_for(sid))))
        self.send(200, page("회원", members_body(r.get("result", {}).get("data"), self.life(ip, via, sid) or {}), nav_html(csrf_for(sid))))

    def life(self, ip, via, sid):
        """member.lifecycle → {id: 상태}. 읽지 못하면 None(목록·상세는 수명주기 없이 보인다)."""
        r = helper("member.lifecycle", ip, via, sid)
        d = r["result"].get("members") if r["ok"] and isinstance(r.get("result"), dict) else None
        return d if isinstance(d, dict) else None

    def member_get(self, ip, via, form, mid, note="", code=200):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        r = helper("member.detail", ip, via, sid, {"id": mid}); t = csrf_for(sid)
        m = r.get("result", {}).get("member") if r["ok"] and isinstance(r.get("result"), dict) else None
        if not isinstance(m, dict) or m.get("id") != mid:
            if r.get("error") == "no_session": return self.to_login()
            return self.send(404 if r.get("error") in ("no_member", "bad_id") else 502, page("회원", msg(err_text(r) if not r["ok"] else "회원 정보 형식을 알 수 없습니다.", True), nav_html(t)))
        life = self.life(ip, via, sid); rec = life_of(life, mid)
        a = helper("archive.list", ip, via, sid); rows = a["result"].get("archives") if a["ok"] and isinstance(a.get("result"), dict) else None      # 최종 삭제 화면과 «내려받기» 에 필요하다
        arch = [x for x in rows if isinstance(x, dict)] if isinstance(rows, list) else None
        self.send(code, page("회원 " + mid, detail_body(t, m, note, life, arch), nav_html(t)))

    def member_act(self, ip, via, form, mid, act):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        if not csrf_ok(sid, form.get("csrf", "")): return self.simple(403, "거부됨", "화면이 오래되었습니다. 새로 열어 다시 하세요.")
        if act == "archive-dl": return self.dl_grant(ip, via, form, mid, sid)
        if act in LIFE_ACTS: return self.life_act(ip, via, form, mid, act, sid)
        r = helper(ACTS[act], ip, via, sid, {"id": mid}); t = csrf_for(sid); res = r.get("result") if r["ok"] and isinstance(r.get("result"), dict) else {}
        if act == "link-issue" and JOB_ID.fullmatch(str(res.get("job", ""))):
            log("안내 링크 발급"); return self.redirect("/jobs/" + res["job"])      # 링크는 job.secret 한 번 표시 경로로만 보인다(이 응답·로그에는 없다)
        title = {"link-issue": "안내 링크 발급", "link-revoke": "안내 링크 폐기", "link-status": "안내 링크 상태", "seal": "봉인", "pair-refresh": "페어링 갱신"}[act]
        if r["ok"]:
            log(f"회원 작업 {act}")
            if act == "pair-refresh": return self.send(200, page(title, result_body(mid, title, msg("온보딩 파일을 갱신했습니다. 페어링 링크는 보안상 이 화면에 표시하지 않습니다(같은 링크가 다시 만들어진 것이며 무효화가 아닙니다)."), ""), nav_html(t)))
            if act == "link-issue": return self.send(502, page(title, result_body(mid, title, msg("도우미 응답을 해석하지 못했습니다.", True)), nav_html(t)))
            text = str(res.get("text", ""))
            return self.send(200, page(title, result_body(mid, title, msg("완료했습니다.") if act != "link-status" else "", text), nav_html(t)))
        e = r.get("error")
        if e == "no_session": return self.to_login()
        note = msg(err_text(r) + (" 재확인 화면에서 코드를 입력한 뒤 다시 하세요." if e == "stepup_required" else ""), True)
        if e == "stepup_required": note += '<p><a href="/stepup">재확인 화면으로</a></p>'
        detail = r.get("detail") if isinstance(r.get("detail"), str) else ""
        if "링크 서비스 계정" in detail: note += msg("이 서버는 1회 열람 링크 서비스를 켜지 않고 설치되었습니다(전달 채널에 link 없음). 켜려면 설치 설정의 ONBOARD_CHANNELS 에 link 를 넣고 53 단계를 다시 실행하세요(docs/ONBOARDING.md). 그때까지는 화면(screen) 전달을 쓰세요.")
        code = 404 if e in ("no_member", "bad_id") else 409 if e == "busy" else 400 if e in ("link_failed", "stepup_required") else 502
        self.send(code, page(title, result_body(mid, title, note, detail), nav_html(t)))

    def life_act(self, ip, via, form, mid, act, sid):
        """정지·재개·삭제·검증: 입력 검사 → (필요하면) 같은 폼의 코드로 step-up → op. 코드가 틀리거나 입력이 틀리면 op 는 부르지 않고 상세 화면으로 돌아가 오류를 보인다.
        인증 코드·정지 사유는 로그에 남기지 않고 화면에도 되돌려 쓰지 않는다."""
        def back(text, code=400): return self.member_get(ip, via, None, mid, msg(text, True), code)
        args = {"id": mid}
        if act == "suspend":
            reason = form.get("reason", "").strip()
            if len(reason) > 200 or re.search(r"[\x00-\x1f\x7f-\x9f]", reason): return back("사유는 200자 이하이고 줄바꿈 등 제어문자가 없어야 합니다.")
            if reason: args["reason"] = reason
        elif act in ("delete-final", "archive-verify"):
            arch = form.get("archive", "")
            if not ARCH_RE.fullmatch(arch) or arch.rsplit("-", 2)[0] != mid: return back("아카이브를 올바르게 선택하세요.")
            if act == "archive-verify": args = {"archive": arch}
            else:
                if form.get("confirm", "") != mid: return back("삭제 대상 ID 를 정확히 입력하세요.")
                args.update(archive=arch, confirm=mid)
        if act in STEP_ACTS:
            code = form.get("code", "")
            if not TOTP_RE.fullmatch(code): return back("인증 코드는 6자리 숫자입니다.")
            r = helper("stepup", ip, via, sid, {"code": code})
            if not r["ok"]:
                if r.get("error") == "no_session" or r.get("session_ended"): return self.to_login()
                return back(err_text(r), 401 if r.get("error") == "stepup_failed" else 400)
        r = helper(LIFE_ACTS[act], ip, via, sid, args)
        res = r.get("result") if r["ok"] and isinstance(r.get("result"), dict) else {}
        if JOB_ID.fullmatch(str(res.get("job", ""))):
            log(f"회원 작업 {act}"); return self.redirect("/jobs/" + res["job"])
        e = r.get("error")
        if e == "no_session": return self.to_login()
        text = err_text(r) + (" 재확인이 만료되었을 수 있습니다. 새 코드로 다시 하세요." if e == "stepup_required" else "")
        if e == "busy": text = "정비 작업이 실행 중입니다. 끝난 뒤 다시 하세요." if r.get("why") == "maint" else "다른 작업이 실행 중이고 대기 중인 작업도 있습니다. 끝난 뒤 다시 하세요."
        back(text, 404 if e in ("no_member", "bad_id") else 409 if e in ("busy", "wrong_state") else 400 if e in ("bad_request", "confirm_mismatch", "arch_mismatch", "stepup_required") else 502)

    def dl_grant(self, ip, via, form, mid, sid):
        """«내려받기» 폼: 입력 검사 → 같은 폼의 코드로 step-up → 허가 → 성공하면 GET /archive/<ARCH>/<파일> 로 보내 바로 시작. 코드는 로그·화면에 남기지 않는다."""
        def back(text, code=400): return self.member_get(ip, via, None, mid, msg(text, True), code)
        arch, file, code = form.get("archive", ""), form.get("file", ""), form.get("code", "")
        if not ARCH_RE.fullmatch(arch) or arch.rsplit("-", 2)[0] != mid or not DL_FILE.fullmatch(file): return back("내려받을 파일을 올바르게 선택하세요.")
        if not TOTP_RE.fullmatch(code): return back("인증 코드는 6자리 숫자입니다.")
        r = helper("stepup", ip, via, sid, {"code": code})
        if not r["ok"]:
            if r.get("error") == "no_session" or r.get("session_ended"): return self.to_login()
            return back(err_text(r), 401 if r.get("error") == "stepup_failed" else 400)
        r = helper("archive.download.grant", ip, via, sid, {"arch": arch, "file": file})
        if r["ok"]: log("내려받기 허가"); return self.redirect(f"/archive/{arch}/{file}")
        e = r.get("error")
        if e == "no_session": return self.to_login()
        back(err_text(r) + (" 재확인이 만료되었을 수 있습니다. 새 코드로 다시 하세요." if e == "stepup_required" else ""), 404 if e == "no_archive" else 400 if e in ("bad_request", "stepup_required") else 502)

    def archive_get(self, ip, via, form, arch, file):
        """GET /archive/<ARCH>/<파일>: 세션 쿠키 + 허가. 도우미가 연 fd 를 받아 256KB 씩 흘려 보낸다(메모리에 통째로 올리지 않는다). Range 한 개만 지원."""
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        rngs = self.headers.get_all("Range") or []; rng = rngs[0].strip() if len(rngs) == 1 else None
        def deny(code, text, extra=None): self.send(code, page("내려받기", msg(text, True) + '<p><a href="/members">회원 목록</a></p>', nav_html(csrf_for(sid))), extra=extra)
        if len(rngs) > 1 or (rng is not None and not re.fullmatch(r"[ -~]{1,64}", rng)): return deny(416, "요청한 범위를 처리할 수 없습니다.")
        if not DL_SEM.acquire(blocking=False): return deny(503, "내려받기가 이미 진행 중입니다. 끝난 뒤 다시 하세요.", {"Retry-After": "10"})
        fd = None
        try:
            r, fd = helper_fd("archive.download.open", ip, via, sid, dict({"arch": arch, "file": file}, **({"range": rng} if rng is not None else {})))
            res = r.get("result") if r["ok"] and isinstance(r.get("result"), dict) else None
            if res is None or fd is None:
                if fd is not None: os.close(fd); fd = None
                e = r.get("error")
                if e == "no_session": return self.to_login()
                if e == "range_invalid" and type(r.get("size")) is int: return deny(416, err_text(r), {"Content-Range": f"bytes */{r['size']}"})
                return deny(416 if e == "range_invalid" else 403 if e == "no_grant" else 404 if e == "no_archive" else 400 if e == "bad_request" else 502, err_text(r))
            size, a, b = res.get("size"), res.get("start"), res.get("end")
            if not all(type(v) is int for v in (size, a, b)) or not (0 <= a <= b + 1 <= size): return deny(502, "도우미 응답을 해석하지 못했습니다.")
            n, part = b - a + 1, res.get("partial") is True
            ex = {"Accept-Ranges": "bytes", "Content-Disposition": f'attachment; filename="{arch}-{file.replace("/", "_")}"'}
            if part: ex["Content-Range"] = f"bytes {a}-{b}/{size}"
            log(f"내려받기 시작 ip={ip}"); sent = 0
            try:
                self.head(206 if part else 200, "application/octet-stream", n, extra=ex); self.connection.settimeout(60)     # 느린 회선은 청크마다 60초까지 기다린다
                while sent < n:
                    c = os.pread(fd, min(DL_CHUNK, n - sent), a + sent)
                    if not c: break          # 파일이 줄었다 — 짧게 끊어 클라이언트가 실패를 알게 한다
                    self.wfile.write(c); sent += len(c)
            finally: log(f"내려받기 종료 보냄={sent}/{n}")      # 클라이언트가 끊어도 여기로 온다(OSError 는 route 가 처리)
            self.close_connection = True
        finally:
            if fd is not None: os.close(fd)
            DL_SEM.release()

    def stepup_get(self, ip, via, form, note=""):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        r = helper("session.check", ip, via, sid)
        if not r["ok"]: return self.to_login() if r.get("error") == "no_session" else self.send(502, page("재확인", msg(err_text(r), True), nav_html(csrf_for(sid))))
        t = csrf_for(sid)
        left = r.get("result", {}).get("stepup_remaining", 0)
        if isinstance(left, int) and left > 0: note += msg(f"재확인이 유효합니다(남은 {left}초).")
        self.send(200, page("재확인", stepup_body(t, note), nav_html(t)))

    def stepup_post(self, ip, via, form):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        if not csrf_ok(sid, form.get("csrf", "")): return self.simple(403, "거부됨", "화면이 오래되었습니다. 새로 열어 다시 하세요.")
        r = helper("stepup", ip, via, sid, {"code": form.get("code", "")})
        if r["ok"]: return self.stepup_get(ip, via, None, msg("재확인되었습니다. 120초 안에 작업을 진행하세요."))
        e = r.get("error")
        if e == "no_session" or r.get("session_ended"): return self.to_login()
        t = csrf_for(sid)
        note = msg("코드가 틀렸습니다. 방금 쓴 코드는 다시 쓸 수 없습니다. 3번 틀리면 로그아웃됩니다." if e == "stepup_failed" else err_text(r), True)
        self.send(401 if e == "stepup_failed" else 400, page("재확인", stepup_body(t, note), nav_html(t)))

    def new_get(self, ip, via, form, note="", id_="", email="", code=200):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        t = csrf_for(sid); self.send(code, page("회원 등록", new_body(t, note, id_, email), nav_html(t)))

    def new_post(self, ip, via, form):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        if not csrf_ok(sid, form.get("csrf", "")): return self.simple(403, "거부됨", "화면이 오래되었습니다. 새로 열어 다시 하세요.")
        id_, email = form.get("id", ""), form.get("email", "")
        if not ID_RE.fullmatch(id_): return self.new_get(ip, via, None, msg(id_reason(id_), True), id_, email, 400)    # 서버가 최종 검사하되, 이유는 웹이 설명한다
        r = helper("member.add", ip, via, sid, {"id": id_, "email": email})
        if r["ok"] and isinstance(r.get("result"), dict) and JOB_ID.fullmatch(str(r["result"].get("job", ""))):
            log(f"회원 등록 시작 ip={ip}"); return self.redirect("/jobs/" + r["result"]["job"])
        e = r.get("error")
        if e == "no_session": return self.to_login()
        if e == "bad_id": text = id_reason(id_)
        elif e == "busy": text = "정비 작업이 실행 중이라 등록을 시작하지 않았습니다. 끝난 뒤 다시 하세요." if r.get("why") == "maint" else "등록 작업이 이미 실행 중이고 대기 중인 작업도 있습니다. 끝난 뒤 다시 하세요."
        else: text = err_text(r)
        t = csrf_for(sid)
        self.send(409 if e == "busy" else 400 if e in ("bad_id", "reserved_id", "bad_email", "bad_request") else 502, page("회원 등록", new_body(t, msg(text, True), id_, email), nav_html(t)))

    def job_get(self, ip, via, form, jid):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        r = helper("job.status", ip, via, sid, {"job": jid})
        t = csrf_for(sid)
        if not r["ok"]:
            if r.get("error") == "no_session": return self.to_login()
            return self.send(404 if r.get("error") == "not_found" else 502, page("작업", msg(err_text(r), True), nav_html(t)))
        res = r.get("result", {}); self.send(200, page(JOBS.get(res.get("op"), ("회원 등록",))[0], job_body(t, jid, res), nav_html(t)))

    def job_json(self, ip, via, form, jid):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.send(401, b'{"state":"x"}', "application/json")
        r = helper("job.status", ip, via, sid, {"job": jid}); d = r.get("result") if r["ok"] and isinstance(r.get("result"), dict) else {}
        out = {"state": d.get("state", "x"), "log": d.get("log", "")}
        self.send(200 if r["ok"] else 401 if r.get("error") == "no_session" else 404, json.dumps(out).encode(), "application/json")

    def job_secret(self, ip, via, form, jid):
        sid = self.cookie(SID_COOKIE, SID_RE)
        if not sid: return self.to_login()
        if not csrf_ok(sid, form.get("csrf", "")): return self.simple(403, "거부됨", "화면이 오래되었습니다. 새로 열어 다시 하세요.")
        r = helper("job.secret", ip, via, sid, {"job": jid}); t = csrf_for(sid)
        if r["ok"] and isinstance(r.get("result"), dict) and isinstance(r["result"].get("secret"), str):
            log("비밀 1회 표시"); return self.send(200, page("비밀 표시", secret_body(r["result"]["secret"], r["result"].get("kind")), nav_html(t)))
        if r.get("error") == "no_session": return self.to_login()
        self.send(404, page("초기 비밀번호", msg(err_text(r), True), nav_html(t)))

    do_GET = do_POST = route
    do_HEAD = do_PUT = do_DELETE = do_PATCH = do_OPTIONS = other

class Server(ThreadingHTTPServer):
    daemon_threads = True
    request_queue_size = 128
    def __init__(self, *a, **k):
        super().__init__(*a, **k); self._sem = threading.BoundedSemaphore(MAX_CONN)
    def process_request(self, request, client_address):
        if not self._sem.acquire(blocking=False):
            try: request.settimeout(1); request.sendall(b"HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nRetry-After: 5\r\nConnection: close\r\n\r\n")
            except OSError: pass
            self.shutdown_request(request); return
        super().process_request(request, client_address)
    def process_request_thread(self, request, client_address):
        try: super().process_request_thread(request, client_address)
        finally: self._sem.release()
    def handle_error(self, request, client_address):
        log(f"연결 처리 오류 {type(sys.exc_info()[1]).__name__}")   # 기본 구현은 트레이스백을 찍는다

def main():
    ap = argparse.ArgumentParser(prog="@@PFX@@-admin-web")
    ap.add_argument("--port", type=int, default=8433)
    ap.add_argument("--socket", default=CFG["socket"])
    ap.add_argument("--allow-host", action="append", required=True, help="허용할 Host 값(포트 포함 그대로). 여러 번 지정")
    ap.add_argument("--deadline", type=float, default=CFG["deadline"], help="요청 하나를 받는 데 허용하는 총 시간(초)")
    a = ap.parse_args()
    CFG.update(socket=a.socket, hosts=tuple(h.strip().lower() for h in a.allow_host if h.strip()), deadline=a.deadline)
    srv = Server(("127.0.0.1", a.port), H)
    log(f"@@PFX@@-admin-web 시작 127.0.0.1:{srv.server_address[1]}")
    srv.serve_forever()

if __name__ == "__main__":
    main()
