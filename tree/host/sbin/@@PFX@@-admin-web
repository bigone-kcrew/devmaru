#!/usr/bin/env python3
# @@PFX@@-admin-web — 웹 관리 화면(T4 뼈대). 파이썬 표준 라이브러리만, 127.0.0.1 에서만 듣고 비특권 계정으로 돈다. 공개는 Caddy 가 한다.
# 구조(설계서 §A.1 B안): 인증·세션·step-up 은 root 도우미(@@PFX@@-admin-helper)가 판단한다. 이 프로그램은 화면과 중계만 하고,
# 세션이 유효한지 스스로 판단하지 않는다(쿠키 값을 도우미에 보내 그 답을 따른다). 비밀번호·코드·세션 ID 는 로그·오류 화면에 남기지 않는다.
import argparse, hashlib, hmac, html, ipaddress, json, os, re, secrets, socket, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit

BRAND = "@@BRAND@@"
SID_COOKIE = "__Host-@@PFX@@adm"     # 세션 ID(도우미가 발급)
PRE_COOKIE = "__Host-@@PFX@@lc"      # 로그인 전 CSRF 용 임의 값
SID_RE = re.compile(r"[A-Za-z0-9_-]{43}")
JOB_ID = re.compile(r"[A-Za-z0-9_-]{22}")
JOB_PATH = re.compile(r"/jobs/([A-Za-z0-9_-]{22})(|/status|/secret)")
PRE_RE = re.compile(r"[A-Za-z0-9_-]{43}")
VIA = ("public", "lan", "local")
MAX_BODY, MAX_CONN, MAX_REPLY = 4096, 32, 8 * 1024 * 1024
DL_CHUNK, DL_MAX = 256 * 1024, 2      # 내려받기: 한 번에 읽어 보내는 크기 · 동시 내려받기 상한
DL_SEM = threading.BoundedSemaphore(DL_MAX)
HELPER_WAIT = 135        # 도우미 응답 대기(프로토콜 §1: 130초 이상)
KEY = secrets.token_bytes(32)   # CSRF 토큰 서명키(재시작하면 열려 있던 폼만 무효)
CFG = {"socket": "/run/@@PFX@@-admin/helper.sock", "hosts": (), "deadline": 15.0}

def log(msg):
    print(msg, flush=True)   # journald 로 간다. 요청 줄·본문·쿠키·도우미 응답은 싣지 않는다(고정 문구와 ip 만)

# ── 도우미 호출 ──
class HelperDown(Exception): pass

def _call(op, ip, via, sid, args, fd_ok):
    """-> (응답 dict, 받은 fd 목록). fd_ok 일 때만 SCM_RIGHTS 를 받는다(archive.download.open). 오류면 받은 fd 는 닫는다."""
    o = {"op": op, "src_ip": ip, "via": via}
    if sid: o["sid"] = sid
    if args is not None: o["args"] = args
    s = socket.socket(socket.AF_UNIX); s.settimeout(HELPER_WAIT); fds = []
    try:
        s.connect(CFG["socket"]); s.sendall(json.dumps(o).encode() + b"\n")
        buf = b""
        while b"\n" not in buf and len(buf) <= MAX_REPLY:
            if fd_ok: c, f, _, _ = socket.recv_fds(s, 65536, 1); fds += f
            else: c = s.recv(65536)
            if not c: break
            buf += c
        r = json.loads(buf.split(b"\n", 1)[0].decode("utf-8"))
        if not isinstance(r, dict) or not isinstance(r.get("ok"), bool): raise ValueError
        return r, fds
    except (OSError, ValueError):
        for f in fds: os.close(f)
        raise HelperDown()
    finally:
        s.close()

def helper(op, ip, via, sid=None, args=None):
    return _call(op, ip, via, sid, args, False)[0]

def helper_fd(op, ip, via, sid, args):
    """-> (응답, fd 또는 None). fd 는 성공 응답에 정확히 하나만 있어야 한다(아니면 모두 닫고 HelperDown)."""
    r, fds = _call(op, ip, via, sid, args, True)
    if len(fds) > 1 or (fds and not r["ok"]):
        for f in fds: os.close(f)
        raise HelperDown()
    return r, (fds[0] if fds else None)

# ── CSRF: 세션 ID(또는 로그인 전 임의 쿠키)에 묶인 서명. 서버는 세션 상태를 갖지 않는다 ──
def csrf_for(cookie_value): return hmac.new(KEY, cookie_value.encode(), hashlib.sha256).hexdigest()[:40]
def csrf_ok(cookie_value, given): return bool(cookie_value) and hmac.compare_digest(csrf_for(cookie_value).encode(), given.encode("utf-8", "replace"))

