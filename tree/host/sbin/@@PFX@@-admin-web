THEME_JS = """\
try{var t=localStorage.getItem('adm-theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t)}catch(e){}
"""
E = lambda v: html.escape(str(v), quote=True)
FONT_PATH = "/usr/local/libexec/@@PFX@@-ui/Pretendard.woff2"
def _font():
    try:
        with open(FONT_PATH, "rb") as f: return f.read()
    except OSError: return b""
STATIC = {"/static/admin.css": (CSS.encode(), "text/css; charset=utf-8"), "/static/admin.js": (JS.encode(), "application/javascript; charset=utf-8"),
          "/static/theme.js": (THEME_JS.encode(), "application/javascript; charset=utf-8"), "/static/pretendard.woff2": (_font(), "font/woff2")}
def term(label, inner, cmd=None, live=False):
    """터미널 느낌의 블록: 윈도 막대 + 프롬프트 줄 + 출력(inner 는 이미 이스케이프된 <pre>)."""
    c = f'<div class="term-cmd"><b>$</b>{E(cmd)}</div>' if cmd else ""
    return f'<div class="term"><div class="term-bar"><i></i><i></i><i></i><span>{E(label)}</span></div>{c}{inner}</div>'

THEME_BTN = ('<button type="button" class="icon" data-theme-toggle aria-label="라이트/다크 전환" title="라이트/다크 전환">'
             '<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>'
             '<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg></button>')

def page(title, body, nav=""):
    return (f'<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
            f'<meta name="robots" content="noindex,nofollow"><title>{E(title)} · {E(BRAND)}</title><script src="/static/theme.js"></script><link rel="stylesheet" href="/static/admin.css">'
            f'<script src="/static/admin.js" defer></script></head><body><header><span class="brand"><i></i>{E(BRAND)} 관리</span><nav>{nav}{THEME_BTN}</nav></header>'
            f'<main>{body}</main></body></html>').encode()

def msg(text, err=False): return f'<p class="msg{" err" if err else ""}" role="alert">{E(text)}</p>'

def login_body(token, note=""):
    return (f'<div class="card"><h1>관리자 로그인</h1>{note}<form method="post" action="/login" autocomplete="off">'
            f'<input type="hidden" name="csrf" value="{E(token)}">'
            '<label for="u">사용자</label><input id="u" name="user" required maxlength="32" autocomplete="username" data-focus>'
            '<label for="p">비밀번호</label><input id="p" name="password" type="password" required maxlength="1024" autocomplete="current-password">'
            '<label for="c">인증 코드</label><input id="c" name="code" required maxlength="14" inputmode="numeric" autocomplete="one-time-code">'
            '<p class="hint">인증 앱의 6자리 코드 또는 복구 코드(xxxx-xxxx-xxxx)</p>'
            '<button type="submit">로그인</button></form></div>')

def nav_html(token):
    return ('<a href="/members">회원</a><a href="/members/new">회원 등록</a><a href="/stepup">재확인</a>'
            f'<form class="inline" method="post" action="/logout"><input type="hidden" name="csrf" value="{E(token)}"><button class="ghost" type="submit">로그아웃</button></form>')

# member.list 의 JSON 은 member-list 도구가 정한다. 목록에는 이메일을 보이지 않는다(상세에서만) — 열을 이름으로 골라 쓰므로 email 은 애초에 읽지 않는다.
MID = re.compile(r"[a-z][a-z0-9_-]{1,31}")
ACTS = {"link-issue": "member.link.issue", "link-revoke": "member.link.revoke", "link-status": "member.link.status", "seal": "member.seal", "pair-refresh": "member.pair.refresh"}
# 수명주기(정지·재개·삭제·아카이브 검증): 파괴적인 것은 같은 폼의 «인증 코드» 로 step-up 한 뒤 op 를 부른다
LIFE_ACTS = {"suspend": "member.suspend", "resume": "member.resume", "delete-request": "member.delete.request", "delete-cancel": "member.delete.cancel",
             "delete-final": "member.delete.final", "archive-verify": "archive.verify"}
STEP_ACTS = ("resume", "delete-request", "delete-cancel", "delete-final")
ARCH_RE = re.compile(r"[a-z][a-z0-9_-]{1,31}-[0-9]{8}-[0-9]{6}")
DL_FILE = re.compile(r"(?:data|home)\.tar\.zst|db-[A-Za-z0-9_]{1,63}\.dump|meta/(?!\.{1,2}$)(?!.*\.\.)[A-Za-z0-9._-]{1,100}")      # 도우미·member-archive 의 구성요소 이름 규칙
ARCH_PATH = re.compile(r"/archive/(" + ARCH_RE.pattern + r")/(" + DL_FILE.pattern + ")")
TOTP_RE = re.compile(r"[0-9]{6}")
MEMBER_PATH = re.compile(r"/member/([a-z][a-z0-9_-]{1,31})(|/link-issue|/link-revoke|/link-status|/seal|/pair-refresh|/suspend|/resume|/delete-request|/delete-cancel|/delete-final|/archive-verify|/archive-dl)")
def badge(text, cls=""): return f'<span class="badge {cls}">{E(text)}</span>'
def state_badge(m):
    st = m.get("state")
    if st is None: return badge("확인 실패")
    return badge("실행", "ok") if st == "running" else badge("없음") if st == "missing" else badge("정지")
def image_badge(m):
    v = m.get("image")
    return badge("CURRENT", "ok") if v == "CURRENT" else badge("OLD(갱신 필요)", "warn") if v == "OLD" else "-"
def limits_text(v):
    if not isinstance(v, dict) or not v: return "기본값"
    return " · ".join(f"{n} {v[k]}" for k, n in (("memory", "메모리"), ("swap", "스왑"), ("cpus", "CPU")) if isinstance(v.get(k), str))
def susp_badge(m): return badge("일시정지", "warn") if m.get("suspended") is True else "-"
def life_of(life, mid): return life.get(mid) if isinstance(life, dict) and isinstance(mid, str) and isinstance(life.get(mid), dict) else None
def life_badge(m, rec):
    """수명주기 배지: 삭제 가능 / 삭제 예정 D-n / 부분 정지 / 정지. 수명주기 정보가 없으면 member-list 의 suspended 만 본다."""
    if rec and rec.get("state") == "pending_delete":
        n = rec.get("days_left")
        return badge("삭제 가능", "bad") if rec.get("due") is True else badge(f"삭제 예정 D-{n}" if type(n) is int else "삭제 예정", "warn")
    if rec and rec.get("suspend_state") == "partial": return badge("부분 정지", "warn")
    if (rec and (rec.get("suspend_state") == "suspended" or rec.get("state") == "suspended")) or m.get("suspended") is True: return badge("정지", "warn")
    return "-"
def banner(life):
    """삭제 가능(기한이 지난 삭제 예정) 회원이 있으면 목록·상세 공통 안내."""
    due = sorted(k for k, v in life.items() if isinstance(v, dict) and v.get("state") == "pending_delete" and v.get("due") is True and MID.fullmatch(k)) if isinstance(life, dict) else []
    if not due: return ""
    return f'<p class="msg warn" role="alert"><b>삭제 가능 {len(due)}명</b> — ' + ", ".join(f'<a href="/member/{E(k)}">{E(k)}</a>' for k in due) + ' · 보관 기한이 지났습니다. 상세 화면에서 아카이브를 확인한 뒤 최종 삭제하세요.</p>'
def num(v): return str(v) if type(v) is int else "-"
def day(v): return v[:10] if isinstance(v, str) else "-"

def members_body(data, life=None):
    rows = data.get("members") if isinstance(data, dict) else data
    if not isinstance(rows, list) or not all(isinstance(r, dict) for r in rows): return msg("회원 목록 형식을 알 수 없습니다.", True)
    if not rows: return banner(life) + "<h1>회원</h1><p>등록된 회원이 없습니다.</p>"
    def idcell(r):
        v = r.get("id")
        return f'<a href="/member/{E(v)}">{E(v)}</a>' if isinstance(v, str) and MID.fullmatch(v) else E(v)      # 형식이 틀린 값은 링크로 만들지 않는다
    head = "".join(f"<th>{h}</th>" for h in ("ID", "생성일", "상태", "컨테이너", "이미지", "tmux", "한도", "정지 표시", "수명주기"))
    body = "".join(f'<tr><td>{idcell(r)}</td><td>{E(day(r.get("created")))}</td><td>{state_badge(r)}</td><td>{E(r.get("container") or "-")}</td><td>{image_badge(r)}</td>'
                   f'<td>{E(num(r.get("tmux")))}</td><td>{E(limits_text(r.get("limits")))}</td><td>{susp_badge(r)}</td><td>{life_badge(r, life_of(life, r.get("id")))}</td></tr>' for r in rows)
    return (banner(life) + f'<h1>회원 ({len(rows)}명)</h1><div class="scroll"><table><thead><tr>{head}</tr></thead><tbody>{body}</tbody></table></div>'
            '<p class="hint">ID 를 누르면 상세 화면(안내 링크·봉인·페어링)으로 갑니다. 목록은 최대 60초 전 값일 수 있습니다.</p>')

def act_form(token, mid, act, label, ghost=False):
    cls = ' class="ghost"' if ghost else ""
    return (f'<form class="inline" method="post" action="/member/{E(mid)}/{act}"><input type="hidden" name="csrf" value="{E(token)}">'
            f'<button type="submit"{cls}>{E(label)}</button></form>')

def onboarding_badges(m):
    """온보딩 상태 두 줄(봉인 여부·초기 비밀번호 대기). member-list 가 존재 여부만 알려 준다."""
    o = m.get("onboarding")
    if not isinstance(o, dict): return '<span class="badge">알 수 없음</span>', '<span class="badge">알 수 없음</span>'
    if not o.get("dir"): files = '<span class="badge">온보딩 폴더 없음</span>'
    elif o.get("sealed"): files = '<span class="badge ok">봉인됨</span> <span class="hint">페어링 파일이 지워졌습니다(README 만 남음)</span>'
    else: files = f'<span class="badge warn">페어링 파일 {E(num(o.get("files")))}개 남음</span> <span class="hint">전달을 마쳤으면 «봉인»을 누르세요</span>'
    pw = ('<span class="badge warn">서버에 보관 중</span> <span class="hint">초기 비밀번호 파일이 아직 있습니다(전달 전이거나 링크 재발급용)</span>' if o.get("password_pending")
          else '<span class="badge ok">없음</span> <span class="hint">서버에 파일이 없습니다(전달을 마쳤거나, 변경·재부팅으로 지워짐)</span>')
    return files, pw

def size_text(b): return f"{b / 1048576:.1f} MB" if type(b) is int else "-"

def life_form(token, mid, act, label, hint, fields="", step=True, cls="", btn="destructive", uid=""):
    """눌러서 여는 확인 상자(JavaScript 없이 details). 안에서 설명·입력·인증 코드를 받고 한 번의 POST 로 보낸다."""
    code = (f'<label for="{act}{uid}-code">인증 코드</label><input id="{act}{uid}-code" name="code" required maxlength="6" inputmode="numeric" pattern="[0-9]{{6}}" autocomplete="one-time-code">'
            '<p class="hint">인증 앱의 새 6자리 코드(방금 로그인에 쓴 코드는 다음 코드가 나올 때까지 쓸 수 없습니다)</p>') if step else ""
    return (f'<details class="act{cls}"><summary>{E(label)}</summary><form method="post" action="/member/{E(mid)}/{act}" autocomplete="off">'
            f'<input type="hidden" name="csrf" value="{E(token)}"><p class="hint">{E(hint)}</p>{fields}{code}<button type="submit" class="{btn} mt">{E(label)}</button></form></details>')

def archive_rows(archives):
    if not archives: return ""
    out = ""
    for a in archives:
        warn = "".join(f'<li>{E(x)}</li>' for x in a.get("skipped") or [])
        out += (f'<tr><td class="mono">{E(a.get("archive"))}</td><td>{E(day(a.get("created")))}</td><td>{E(size_text(a.get("bytes")))}</td><td>{E(len(a.get("components") or []))}개</td>'
                f'<td>{badge("완전", "ok") if a.get("complete") else badge("불완전", "warn")}{"<ul class=hint>" + warn + "</ul>" if warn else ""}</td></tr>')
    return ('<div class="scroll"><table><thead><tr><th>아카이브</th><th>생성일</th><th>크기</th><th>구성요소</th><th>상태·건너뛴 항목</th></tr></thead>'
            f'<tbody>{out}</tbody></table></div>')

def dl_section(token, mid, archives):
    """아카이브 구성요소별 «내려받기»(step-up 코드 칸이 있는 확인 상자). 구성요소 이름은 형식 검증을 통과한 것만."""
    out = ""
    for n, a in enumerate(x for x in archives or [] if x.get("member") == mid and isinstance(x.get("archive"), str) and ARCH_RE.fullmatch(x["archive"])):
        forms = "".join(life_form(token, mid, "archive-dl", "내려받기 " + c, "이 파일을 내려받습니다. 코드를 확인하면 바로 시작되며, 1시간 안에는 같은 주소로 이어받을 수 있습니다.",
                                  f'<input type="hidden" name="archive" value="{E(a["archive"])}"><input type="hidden" name="file" value="{E(c)}">', btn="secondary", uid=f"{n}-{k}")
                        for k, c in enumerate(a.get("components") or []) if isinstance(c, str) and DL_FILE.fullmatch(c))
        if forms: out += f'<p class="mono">{E(a["archive"])}</p><div class="actions">{forms}</div>'
    if not out: return ""
    return ('<h2>아카이브 내려받기</h2>' + out + '<p class="hint">파일마다 새 인증 코드가 필요합니다. 허가는 이 로그인 세션에서 1시간 유효하고(로그아웃하면 사라짐) 암호화하지 않은 원본 파일입니다 — 서버 밖으로 나가면 안전하게 보관하세요.</p>')

def life_section(token, mid, m, rec, archives):
    """정지·재개·삭제 버튼. 상태에 따라 보이는 것이 다르다(버튼이 보여도 도우미가 상태를 다시 검사한다)."""
    state = rec.get("state") if rec else None
    ss = rec.get("suspend_state") if rec else ("suspended" if m.get("suspended") is True else None)
    f, extra = [], ""
    if state == "pending_delete":
        f.append(life_form(token, mid, "delete-cancel", "삭제 취소", "삭제 예정을 취소하고 회원을 다시 사용할 수 있게 합니다(재개).", btn="secondary"))
        mine = [a for a in archives or [] if a.get("member") == mid]
        opts = {a["archive"] for a in mine if isinstance(a.get("archive"), str) and ARCH_RE.fullmatch(a["archive"])}
        if rec.get("archive"): opts.add(rec["archive"])
        extra = "<h2>최종 삭제</h2>" + (msg("보관 기한이 지났습니다. 아카이브를 확인한 뒤 삭제하세요. 최종 삭제는 되돌릴 수 없습니다.", True) if rec.get("due") is True
                else msg(f"삭제 가능까지 D-{rec['days_left']}" + (f" ({day(rec.get('delete_after'))})" if rec.get("delete_after") else "") + " 남았습니다. 기한이 지나기 전에는 최종 삭제를 할 수 없습니다." if type(rec.get("days_left")) is int else "아직 삭제 가능 기한이 아닙니다."))
        if archives is None and rec.get("due") is True: extra += msg("아카이브 목록을 읽지 못했습니다. 아래 선택지는 수명주기 상태에 기록된 아카이브뿐입니다.", True)
        if mine: extra += archive_rows(mine)
        if rec.get("due") is True and opts:
            ver = "".join(f'<form class="inline" method="post" action="/member/{E(mid)}/archive-verify"><input type="hidden" name="csrf" value="{E(token)}"><input type="hidden" name="archive" value="{E(a)}">'
                          f'<button type="submit" class="ghost">검증: {E(a)}</button></form> ' for a in sorted(opts))
            sel = "".join(f'<option value="{E(a)}"{" selected" if a == rec.get("archive") else ""}>{E(a)}</option>' for a in sorted(opts))
            fields = (f'<label for="fa">삭제에 쓸 아카이브</label><select id="fa" name="archive" required>{sel}</select>'
                      f'<label for="fc">삭제 대상 ID 를 그대로 입력</label><input id="fc" name="confirm" required maxlength="32" autocomplete="off" placeholder="{E(mid)}">')
            extra += ('<p class="hint">먼저 아카이브를 검증하세요(진행 화면에서 결과 확인).</p><div class="actions">' + ver + "</div>"
                      + '<div class="actions mt">' + life_form(token, mid, "delete-final", "최종 삭제", "계정·컨테이너·데이터를 삭제합니다. 되돌릴 수 없고 아카이브만 남습니다.", fields, cls=" danger") + "</div>")
        elif rec.get("due") is True: extra += msg("사용할 수 있는 아카이브가 없어 최종 삭제를 할 수 없습니다.", True)
        else: extra += '<div class="actions"><button type="button" disabled>최종 삭제(기한 전)</button></div>'
    elif state in ("active", "suspended", None) or ss in ("suspended", "partial"):
        if ss != "suspended":
            f.append(life_form(token, mid, "suspend", "정지 다시 시도" if ss == "partial" else "일시 정지", "계정·컨테이너·공개 서비스 접근을 막습니다. 재개로 되돌릴 수 있습니다.",
                               '<label for="rs">사유(선택, 200자 이하)</label><input id="rs" name="reason" maxlength="200">', step=False, btn="secondary"))
        if ss in ("suspended", "partial") or state == "suspended": f.append(life_form(token, mid, "resume", "재개", "정지 전 상태로 되돌립니다.", btn="secondary"))
        if state in ("active", "suspended"): f.append(life_form(token, mid, "delete-request", "삭제 요청", "정지 → 아카이브 → 7일 보관 후 관리자가 최종 삭제, 그 전에는 취소 가능", cls=" danger"))
    return f'<h2>정지·삭제</h2><div class="actions">{"".join(f)}</div>' + extra

def detail_body(token, m, note="", life=None, archives=None):
    mid = m.get("id", ""); rec = life_of(life, mid)
    kv = [("ID", E(mid)), ("이메일", E(m.get("email") or "-")), ("생성일", E(str(m.get("created") or "-").replace("T", " "))), ("상태", state_badge(m)), ("컨테이너", E(m.get("container") or "-")),
          ("이미지", image_badge(m)), ("tmux 세션 수", E(num(m.get("tmux")))), ("한도", E(limits_text(m.get("limits")))), ("정지 표시", susp_badge(m)), ("수명주기", life_badge(m, rec))]
    if rec:
        if rec.get("delete_after"): kv.append(("삭제 예정일", E(day(rec["delete_after"])) + (f" (D-{rec['days_left']})" if type(rec.get("days_left")) is int else "")))
        if rec.get("archive"): kv.append(("아카이브", f'<span class="mono">{E(rec["archive"])}</span>'))
        if rec.get("last_error"): kv.append(("마지막 오류", E(rec["last_error"])))
    kv += [("온보딩 파일", onboarding_badges(m)[0]), ("초기 비밀번호", onboarding_badges(m)[1])]
    dl = "".join(f"<dt>{k}</dt><dd>{v}</dd>" for k, v in kv)
    acts = "".join((act_form(token, mid, "link-issue", "안내 링크 발급"), act_form(token, mid, "link-status", "링크 상태", True), act_form(token, mid, "link-revoke", "링크 폐기", True),
                    act_form(token, mid, "seal", "봉인", True), act_form(token, mid, "pair-refresh", "페어링 갱신", True)))
    lifebox = life_section(token, mid, m, rec, archives) if life is not None else msg("수명주기 정보를 읽지 못해 정지·삭제 버튼을 숨겼습니다(도구가 없거나 응답 오류).")
    return (banner(life) + f'<h1>회원 {E(mid)}</h1>{note}<dl class="kv">{dl}</dl>{lifebox}{dl_section(token, mid, archives)}<h2>온보딩</h2><div class="actions">{acts}</div>'
            '<p class="hint">안내 링크: 1회 열람 링크를 새로 만듭니다(이전 링크는 폐기, 링크는 한 번만 표시). 봉인: 온보딩 폴더의 페어링 파일과 링크를 지웁니다. '
            '페어링 갱신: 같은 페어링 링크를 온보딩 파일로 다시 만듭니다(링크가 무효화되지는 않으며 이 화면에는 표시하지 않습니다).</p>'
            '<p><a href="/members">회원 목록</a></p>')

def result_body(mid, title, note, pre=""):
    box = term(title, f'<pre class="log">{E(pre)}</pre>', "@@PFX@@-member-" + {"링크 상태": "link status", "안내 링크 폐기": "link revoke", "봉인": "seal", "페어링 갱신": "pair-create"}.get(title, "link") + " " + mid) if pre else ""
    return f'<h1>{E(title)}</h1>{note}{box}<p><a href="/member/{E(mid)}">회원 {E(mid)} 로 돌아가기</a></p>'

def stepup_body(token, note=""):
    return (f'<h1>재확인</h1>{note}<p class="hint">파괴적인 작업 전에 인증 앱의 <b>새 6자리 코드</b>가 필요합니다. 방금 로그인에 쓴 코드는 쓸 수 없으니 다음 코드가 나올 때까지(최대 30초) 기다리세요. 확인은 120초 동안 유효하고 작업 한 번에 소비됩니다.</p>'
            f'<form method="post" action="/stepup" autocomplete="off" class="narrow"><input type="hidden" name="csrf" value="{E(token)}">'
            '<label for="c">인증 코드</label><input id="c" name="code" required maxlength="6" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" data-focus>'
            '<button type="submit" class="mt">확인</button></form>')

ID_RE = re.compile(r"[a-z][a-z0-9]{1,31}")
def id_reason(v):
    """등록 폼의 ID 가 규칙 밖일 때 이유(한국어). 사용자가 방금 입력한 값에 대한 설명이라 안전하게 보여 줄 수 있다."""
    if not v: return "ID 를 입력하세요."
    if not v.isascii(): return "ID 에는 영문 소문자와 숫자만 쓸 수 있습니다(한글·특수문자 불가)."
    if "-" in v or "_" in v: return "하이픈(-)과 밑줄(_)은 쓸 수 없습니다. 웹 공개·DB 와 맞지 않아 소문자와 숫자만 허용합니다."
    if any(c.isupper() for c in v): return "대문자는 쓸 수 없습니다. 소문자로 입력하세요."
    if not v[0].isalpha(): return "첫 글자는 영문 소문자여야 합니다."
    if len(v) < 2 or len(v) > 32: return "ID 는 2~32자여야 합니다."
    return "ID 는 영문 소문자로 시작하고 소문자·숫자만 쓸 수 있습니다(공백·기호 불가)."

def new_body(token, note="", id_="", email=""):
    return (f'<h1>회원 등록</h1>{note}<form method="post" action="/members/new" autocomplete="off" class="narrow"><input type="hidden" name="csrf" value="{E(token)}">'
            f'<label for="i">회원 ID</label><input id="i" name="id" required minlength="2" maxlength="32" pattern="[a-z][a-z0-9]{{1,31}}" value="{E(id_)}" data-focus>'
            '<p class="hint">영문 소문자로 시작, 소문자·숫자만 2~32자(하이픈·밑줄 불가). 입력 검사는 편의 기능이고 서버가 최종 검사합니다.</p>'
            f'<label for="e">이메일</label><input id="e" name="email" type="email" required maxlength="254" value="{E(email)}">'
            '<p class="hint">초기 안내가 이 주소로 전달됩니다. 등록에는 수십 초에서 몇 분이 걸립니다.</p>'
            '<button type="submit" class="mt">등록 시작</button></form>')

JOBS = {"member.suspend": ("일시 정지", "member-suspend suspend <id>"), "member.resume": ("재개", "member-suspend resume <id>"),
        "member.delete.request": ("삭제 요청", "member-lifecycle request-delete <id>"), "member.delete.cancel": ("삭제 취소", "member-lifecycle cancel <id>"),
        "member.delete.final": ("최종 삭제", "member-lifecycle final-delete <id> --archive <arch>"), "archive.verify": ("아카이브 검증", "member-archive verify <arch>")}
JOB_FAIL = {"member.suspend": "일부 단계가 실패해 «부분 정지» 일 수 있습니다. 같은 작업을 다시 실행하면 실패한 단계만 다시 시도합니다. 상세 화면에서 상태를 확인하세요.",
            "member.resume": "일부 단계가 실패했습니다. 같은 작업을 다시 실행하면 실패한 단계만 다시 시도합니다.",
            "member.delete.request": "삭제 요청이 끝나지 않았습니다. 회원은 정지 상태로 남고 삭제 예정으로 바뀌지 않았을 수 있습니다. 아래 로그와 상세 화면의 오류를 확인하세요.",
            "member.delete.cancel": "삭제 취소에 실패했습니다. 아래 로그를 확인하세요.", "member.delete.final": "최종 삭제에 실패했습니다. 일부만 지워졌을 수 있으니 아래 로그를 확인하세요.",
            "archive.verify": "아카이브 검증에 실패했습니다. 이 아카이브로는 최종 삭제를 하지 마세요."}
def life_job_body(r):
    """정지·재개·삭제·검증 job 화면(터미널 로그). 끝나면 상세로 돌아가는 링크."""
    op, st = r.get("op"), r.get("state"); title, cmd = JOBS[op]
    mem = r.get("member") if isinstance(r.get("member"), str) and MID.fullmatch(r.get("member")) else None
    back = (f'<p><a href="/member/{E(mem)}">회원 {E(mem)} 상세로 돌아가기</a> · ' if mem and not (op == "member.delete.final" and st == "done") else "<p>") + '<a href="/members">회원 목록</a></p>'
    logbox = term(cmd.split()[0], f'<pre id="joblog" class="log{" cursor" if st in ("queued", "running") else ""}">{E(r.get("log", ""))}</pre>', "@@PFX@@-" + cmd)
    if st in ("queued", "running"):
        return (f'<h1>{E(title)} 진행 중</h1><div data-job="/jobs/{E(r.get("id", ""))}/status"></div><p class="msg">{"앞선 작업이 끝나기를 기다리는 중입니다." if st == "queued" else "진행 중입니다. 이 화면은 자동으로 갱신됩니다(JavaScript 를 쓸 수 없으면 새로고침하세요)."}</p>{logbox}')
    if st == "failed":
        why = {"maint": "정비 작업이 실행 중이라 시작하지 못했습니다. 끝난 뒤 다시 하세요.", "timeout": "시간이 너무 오래 걸려 중단했습니다."}.get(r.get("why"), JOB_FAIL[op])
        return f'<h1>{E(title)} 실패</h1>{msg(why, True)}{logbox}{back}'
    return f'<h1>{E(title)} 완료</h1>{msg("완료했습니다.")}{logbox}{back}'

def job_body(token, jid, r):
    st, log = r.get("state"), E(r.get("log", ""))
    if r.get("op") in JOBS: return life_job_body(dict(r, id=jid))
    if r.get("kind") == "link":      # 안내 링크 발급 job(이미 끝난 상태로 만들어진다)
        if r.get("secret_ready"):
            return (f'<h1>안내 링크 발급 완료</h1><form method="post" action="/jobs/{E(jid)}/secret"><input type="hidden" name="csrf" value="{E(token)}">'
                    '<p class="msg err">안내 링크는 <b>한 번만</b> 표시됩니다. 표시하면 서버에서 지워지고, 새로고침·뒤로가기로는 다시 볼 수 없습니다. 10분이 지나도 지워집니다.</p>'
                    '<button type="submit">안내 링크 표시(한 번만)</button></form><p><a href="/members">회원 목록</a></p>')
        return f'<h1>안내 링크</h1>{msg("표시할 링크가 없습니다(이미 확인했거나 10분이 지났습니다). 다시 볼 수 없으니 필요하면 새로 발급하세요.")}<p><a href="/members">회원 목록</a></p>'
    logbox = term("member-add", f'<pre id="joblog" class="log{" cursor" if st in ("queued", "running") else ""}">{log}</pre>', "@@PFX@@-member-add <id> --email <mail>")
    if st in ("queued", "running"):
        return (f'<h1>회원 등록 진행 중</h1><div data-job="/jobs/{E(jid)}/status"></div>'
                f'<p class="msg">{"앞선 작업이 끝나기를 기다리는 중입니다." if st == "queued" else "등록 중입니다. 이 화면은 자동으로 갱신됩니다(JavaScript 를 쓸 수 없으면 새로고침하세요)."}</p>{logbox}')
    if st == "failed":
        why = {"maint": "정비 작업이 실행 중이라 시작하지 못했습니다. 끝난 뒤 다시 등록하세요.", "timeout": "시간이 너무 오래 걸려 중단했습니다."}.get(r.get("why"), "등록에 실패했습니다. 아래 로그를 확인하세요. 일부 단계가 이미 끝났을 수 있습니다.")
        if "이미 등록된 이메일" in r.get("log", ""): why = "이미 다른 회원이 쓰는 이메일입니다. 다른 이메일로 등록하세요(아직 아무것도 만들어지지 않았습니다)."
        return f'<h1>회원 등록 실패</h1>{msg(why, True)}{logbox}<p><a href="/members/new">다시 등록</a></p>'
    if r.get("secret_ready"):
        sec = (f'<form method="post" action="/jobs/{E(jid)}/secret"><input type="hidden" name="csrf" value="{E(token)}">'
               '<p class="msg err">초기 비밀번호는 <b>한 번만</b> 표시됩니다. 표시하면 서버에서 지워지고, 새로고침·뒤로가기로는 다시 볼 수 없습니다. 10분이 지나도 지워집니다.</p>'
               '<button type="submit">초기 비밀번호 표시(한 번만)</button></form>')
    else: sec = msg("표시할 초기 비밀번호가 없습니다(이미 확인했거나 10분이 지났습니다). 다시 볼 수 없습니다.")
    return f'<h1>회원 등록 완료</h1>{sec}<h2>진행 로그</h2>{logbox}<p><a href="/members">회원 목록</a></p>'

