#!/usr/bin/env bash
# @@PFX@@-agent-key (root) — 에이전트 계정(@@PFX@@-agent)의 SSH 공개키 관리. 키 파일은 root 소유라 에이전트가 스스로 고칠 수 없다.
#   @@PFX@@-agent-key add <공개키 파일|->     공개키 등록(- 는 표준입력). 포워딩 불가 옵션(restrict,pty)을 붙인다
#   @@PFX@@-agent-key remove <지문|주석>      등록 해제(SHA256:… 지문 또는 키 주석)
#   @@PFX@@-agent-key expire <YYYY-MM-DD|never>   계정 만료일
#   @@PFX@@-agent-key status                  등록된 키 지문·만료
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "실패: root 로 실행하세요(sudo)" >&2; exit 1; }
PFX=@@PFX@@; A=$PFX-agent; KEYS=/etc/$PFX/agent-authorized_keys
die(){ echo "실패: $*" >&2; exit 1; }
id "$A" >/dev/null 2>&1 && [ -f "$KEYS" ] || die "에이전트 계정이 없습니다. 먼저: sudo $PFX-agent-setup install"
fp(){ ssh-keygen -lf /dev/stdin <<<"$1" 2>/dev/null | awk '{print $2}'; }
cmd=${1:-status}; shift || true
case "$cmd" in
add)
  src=${1:-}; [ -n "$src" ] || die "사용: $PFX-agent-key add <공개키 파일|->"
  line=$( [ "$src" = - ] && cat || cat -- "$src" ) || die "읽지 못했습니다: $src"
  [ "$(printf '%s\n' "$line" | grep -c .)" = 1 ] || die "공개키는 한 줄이어야 합니다"
  line=$(printf '%s' "$line" | tr -d '\r')
  [[ $line =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp[0-9]+|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com)\  ]] || die "옵션이 붙었거나 공개키 형식이 아닙니다(ssh-ed25519 … 형식의 .pub 한 줄)"
  f=$(fp "$line"); [ -n "$f" ] || die "올바른 공개키가 아닙니다"
  while read -r l; do [ -n "$l" ] && [ "$(fp "${l#restrict,pty }")" = "$f" ] && { echo "안내: 이미 등록된 키입니다($f)"; exit 0; }; done < "$KEYS"
  printf 'restrict,pty %s\n' "$line" >> "$KEYS"; chmod 0644 "$KEYS"
  echo "성공: 키 등록 $f" ;;
remove)
  t=${1:-}; [ -n "$t" ] || die "사용: $PFX-agent-key remove <지문|주석>"
  tmp=$(mktemp); n=0
  while read -r l; do
    [ -n "$l" ] || continue; k=${l#restrict,pty }
    if [ "$(fp "$k")" = "$t" ] || [ "$(awk '{print $3}' <<<"$k")" = "$t" ]; then n=$((n+1)); else echo "$l" >> "$tmp"; fi
  done < "$KEYS"
  [ "$n" -gt 0 ] || { rm -f "$tmp"; die "일치하는 키가 없습니다: $t"; }
  install -m 0644 -o root -g root "$tmp" "$KEYS"; rm -f "$tmp"; echo "성공: 키 $n 개 삭제" ;;
expire)
  d=${1:-}; if [ "$d" = never ]; then chage -E -1 "$A"; echo "성공: 만료 없음"
  elif [[ $d =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && date -d "$d" >/dev/null 2>&1; then chage -E "$d" "$A"; echo "성공: 만료일 $d"
  else die "사용: $PFX-agent-key expire <YYYY-MM-DD|never>"; fi ;;
status)
  echo "만료: $(chage -l "$A" | awk -F': ' '/Account expires/{print $2}')"
  n=0; while read -r l; do [ -n "$l" ] || continue; n=$((n+1)); k=${l#restrict,pty }; echo "  키 $n: $(fp "$k") $(awk '{print $3}' <<<"$k")"; done < "$KEYS"
  [ "$n" = 0 ] && echo "  등록된 키 없음(로그인 불가)"; exit 0 ;;
*) die "사용: $PFX-agent-key add|remove|expire|status" ;;
esac
