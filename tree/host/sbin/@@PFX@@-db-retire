#!/usr/bin/env bash
# @@PFX@@-db-retire <멤버> — 멤버를 삭제할 때 PostgreSQL role 을 잠그고 «보관» 표시를 남긴다(데이터는 그대로). 90일 뒤 @@PFX@@-db-policy 가 덤프를 뜬 다음 정리한다.
#  같은 ID 로 다시 만들면 @@PFX@@-member-db-setup 이 보관 중인 role 을 되살린다. 멤버 role 이 아니면(슈퍼유저·보호 role) 아무것도 하지 않는다.
set -euo pipefail
PG="${PG_CONTAINER:-postgres}"; U="${1:-}"; TODAY="${AI_DB_TODAY:-$(date +%F)}"; PROTECTED="${AI_DB_PROTECTED_ROLES:-postgres n8n mem0 mem0_app}"
[[ $U =~ ^[a-zA-Z0-9_]+$ ]] || { echo "DB 없음(ID 에 하이픈 등) — 보관할 것 없음"; exit 0; }
for p in $PROTECTED; do [[ $U == "$p" ]] && { echo "보호된 role — 건너뜀: $U"; exit 0; }; done
q(){ docker exec "$PG" psql -U postgres -tAc "$1"; }
[[ $(q "select count(*) from pg_roles where rolname='$U'") == 1 ]] || { echo "DB role 없음 — 보관할 것 없음"; exit 0; }
[[ $(q "select count(*) from pg_roles where rolname='$U' and rolsuper") == 0 ]] || { echo "슈퍼유저 role — 건너뜀: $U"; exit 0; }
cm=$(q "select coalesce(shobj_description(oid,'pg_authid'),'') from pg_roles where rolname='$U'")
[[ $cm == retired:* ]] && { echo "이미 보관 중($cm)"; exit 0; }
docker exec "$PG" psql -U postgres -v ON_ERROR_STOP=1 -c "ALTER ROLE \"$U\" NOLOGIN" >/dev/null
q "select count(pg_terminate_backend(pid)) from pg_stat_activity where usename='$U'" >/dev/null
docker exec "$PG" psql -U postgres -v ON_ERROR_STOP=1 -c "COMMENT ON ROLE \"$U\" IS 'retired:$TODAY'" >/dev/null
echo "PostgreSQL 보관 시작: role $U 잠금(NOLOGIN) · DB 는 그대로 · $TODAY 부터 보관(90일 뒤 덤프 후 정리, 그 안에 같은 ID 로 다시 만들면 복구)"
