#!/usr/bin/env python3
"""SSH 비밀번호가 바뀌면 파일 서비스(SFTPGo)와 Samba(있으면) 비밀번호를 같은 값으로 맞춘다.
PAM(pam_exec expose_authtok)이 부른다. 새 비밀번호는 표준입력 한 줄로만 받고, 출력·로그에 남기지 않는다.
비밀번호 변경 자체는 막지 않는다(실패해도 종료 코드 0)."""
import http.client, json, os, re, shutil, subprocess, sys

PFX = "@@PFX@@"
user = os.environ.get("PAM_USER", "")
if os.environ.get("PAM_TYPE") != "password" or not re.fullmatch(r"[a-z][a-z0-9_-]{1,31}", user):
    sys.exit(0)
pw = sys.stdin.readline().rstrip("\n")
if not pw:                      # PAM 의 사전 점검 단계에는 비밀번호가 없다
    sys.exit(0)
if PFX not in subprocess.run(["id", "-nG", user], capture_output=True, text=True).stdout.split():
    sys.exit(0)                 # 회원만

try:
    key = open(f"/etc/{PFX}/secrets/sftpgo-provisioner-api-key").read().strip()
    c = http.client.HTTPConnection("127.0.0.1", 8080, timeout=10)
    h = {"X-SFTPGO-API-KEY": key}
    c.request("GET", f"/api/v2/users/{user}", headers=h)
    r = c.getresponse()
    if r.status == 200:
        u = json.loads(r.read())
        u["password"] = pw
        c.request("PUT", f"/api/v2/users/{user}", body=json.dumps(u), headers={**h, "Content-Type": "application/json"})
        c.getresponse().read()
except Exception as e:           # 파일 서비스가 없거나 멈춘 경우에도 비밀번호 변경은 진행된다
    print(f"{PFX}-files-password-sync: SFTPGo 동기화 건너뜀 ({type(e).__name__})", file=sys.stderr)

conf = f"/srv/{PFX}/samba/smb.conf"
if os.path.exists(conf) and shutil.which("smbpasswd"):
    subprocess.run(["smbpasswd", "-s", "-c", conf, user], input=f"{pw}\n{pw}\n", text=True, capture_output=True)
sys.exit(0)
