#!/bin/sh
set -eu

USER_NAME="${PAM_USER:-}"

[ -n "$USER_NAME" ] || exit 0

# 관리자 및 @@BRAND@@ 회원이 아닌 계정은 대상 아님.
[ "$USER_NAME" != "@@ADMIN_USER@@" ] || exit 0
[ -d "/srv/@@PFX@@/users/$USER_NAME" ] || exit 0

LAST_CHANGE="$(
  getent shadow "$USER_NAME" 2>/dev/null \
    | awk -F: '{print $3}'
)"

# chage -d 0 상태에서만 안내.
[ "$LAST_CHANGE" = "0" ] || exit 0

cat <<'NOTICE'

==================================================
 처음 로그인하셨습니다
==================================================

보안을 위해 임시 비밀번호를
본인이 사용할 새 비밀번호로 변경해야 합니다.

잠시 후 영문 안내가 나오면 아래처럼 입력하세요.

  Current password:
    -> 지금 로그인할 때 사용한 임시 비밀번호

  New password:
    -> 앞으로 사용할 새 비밀번호

  Retype new password:
    -> 새 비밀번호를 한 번 더 입력

※ 비밀번호 입력 중에는 화면에 글자나 * 표시가
   나타나지 않습니다. 정상입니다.

비밀번호 변경이 끝나면 @@BRAND@@ 개발환경으로
자동 연결됩니다.

==================================================

NOTICE

exit 0
