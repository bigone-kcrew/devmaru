#!/usr/bin/env bash
# @@PFX@@-golden — Golden(회원 개발환경 이미지) 운영 도구 모음. 자세한 흐름: docs/GOLDEN.md
#   @@PFX@@-golden check               현황 + 업스트림 신버전 대조(읽기 전용, sudo 불필요)
#   sudo @@PFX@@-golden rc [버전] [--plan]  RC 이미지를 만들고 selftest·canary 로 검증(여기서 멈춤 — 포인터·회원 컨테이너 불변)
#   @@PFX@@-golden progress <버전>     RC 빌드 진행 표시(읽기 전용)
#   sudo @@PFX@@-golden selftest <이미지> / canary <이미지> <버전>   단독 실행
#   sudo @@PFX@@-golden promote <버전> [--plan]   검증된 RC 를 stable 로 승격(포인터 이동 — 사람이 직접)
set -u
sub="${1:-}"
case "$sub" in
  check|rc|selftest|canary|promote|progress) shift; exec "/usr/local/sbin/@@PFX@@-golden-$sub" "$@";;
  *) sed -n 2,7p "$0" | sed 's/^# \{0,1\}//'; [ -z "$sub" ] || [ "$sub" = -h ] || [ "$sub" = --help ] || exit 2;;
esac
