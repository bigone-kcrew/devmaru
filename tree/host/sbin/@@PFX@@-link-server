#!/usr/bin/env python3
# @@PFX@@-link-server — 회원 안내 «1회 열람 링크» 서비스(파이썬 표준 라이브러리만, 127.0.0.1 에서만 듣는다. 공개는 Caddy 의 /start/* 가 한다).
#   GET  /start/<토큰>  확인 화면만 보여 준다. 링크를 소비하지 않는다(메신저·메일 보안 검사기가 먼저 열어도 링크가 죽지 않게).
#   POST /start/<토큰>  1회용 폼 토큰이 맞을 때만 소비하고 초기 비밀번호·Paseo QR·링크를 한 번 보여 준다.
# 이 서비스는 계정을 바꾸지 않는다(읽기만). 기록은 <접두어>-member-link 가 만든다. 토큰 원문은 어디에도 저장·기록하지 않고 sha256 해시만 쓴다.
import hashlib, hmac, html, ipaddress, json, os, re, secrets, socket, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SITE = "/etc/@@PFX@@/site.env"
STORE = "/run/@@PFX@@-link"
TOKEN_RE = re.compile(r"[A-Za-z0-9_-]{43,86}")
PATH_RE = re.compile(r"/start/([^/?#]+)(?:\?.*)?")   # 정확히 /start/<토큰> 만(끝 슬래시·// 변형·대소문자 변형은 404)
FAIL_LIMIT, FAIL_WINDOW = 10, 900   # IP 별: 15분 안에 10번 실패하면 가장 오래된 실패가 15분 지날 때까지 차단
FORM_TTL, MAX_BODY, SWEEP_SECS, MAX_FORMS = 600, 1024, 600, 8
DEADLINE, MAX_CONN = 15, 64   # 요청 하나의 총 시간(초) · 동시 연결 상한(넘으면 즉시 503)
CLIENT_IP_HEADER = "X-Onboard-Client-IP"   # Caddy 가 header_up 으로 덮어쓰는 전용 헤더(X-Forwarded-For 는 믿지 않는다)
BRAND = "@@BRAND@@"

def read_env(path):
    out = {}
    try:
        for line in open(path, encoding="utf-8"):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1); v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"": v = v[1:-1]
                out[k.strip()] = v
    except OSError:
        pass
    return out

def log(msg):
    print(msg, flush=True)   # journald 로 간다. 토큰 원문·비밀번호는 절대 싣지 않는다(해시 앞 8자만)

_lock = threading.Lock()
_fails = {}   # ip -> [시각...]
_gone = {}   # 링크 해시 -> ("used"|"expired", 시각)  안내 문구용(메모리·상한 5000). 토큰을 가진 사람에게만 의미가 있다
_forms = {}   # 링크 해시 -> [(폼 토큰, 만료)...] 최신 8개(미리보기 봇이 먼저 열어도 사람의 폼이 살아 있게). 메모리 상한 = 링크 수 x 8

def blocked(ip):
    now = time.time()
    with _lock:
        l = [t for t in _fails.get(ip, []) if now - t < FAIL_WINDOW]
        _fails[ip] = l
        return len(l) >= FAIL_LIMIT

def fail(ip):
    with _lock:
        if len(_fails) > 10000:   # 메모리 상한: 가장 오래된 절반을 버린다(그동안 차단이 풀릴 수 있음 — 알려진 한계)
            for k in sorted(_fails, key=lambda k: _fails[k][-1] if _fails[k] else 0)[:5000]: _fails.pop(k, None)
        _fails.setdefault(ip, []).append(time.time())

def link_hash(token): return hashlib.sha256(token.encode()).hexdigest()

def load(h):
    """(기록, 상태). 상태: "ok" · "expired" · None(없음/깨짐). 해시는 바이트로 상수 시간 대조한다."""
    try: rec = json.load(open(os.path.join(STORE, h + ".json"), encoding="utf-8"))
    except (OSError, ValueError): return None, None
    if not isinstance(rec, dict) or not hmac.compare_digest(str(rec.get("h", "")).encode("utf-8", "replace"), h.encode()): return None, None
    try: exp = float(rec.get("exp", 0))
    except (TypeError, ValueError): return None, None
    if exp < time.time(): return None, "expired"
    return rec, "ok"

def gone(h, why):
    with _lock:
        if len(_gone) > 5000:
            for k in sorted(_gone, key=lambda k: _gone[k][1])[:2500]: _gone.pop(k, None)
        _gone[h] = (why, time.time())

def take(h):
    """원자적 소비: 이름을 바꾸는 데 성공한 한 요청만 내용을 받는다."""
    src = os.path.join(STORE, h + ".json"); dst = os.path.join(STORE, f"{h}.{secrets.token_hex(4)}.taken")
    try: os.rename(src, dst)
    except OSError: return None
    try: rec = json.load(open(dst, encoding="utf-8"))
    except (OSError, ValueError): rec = None
    try: os.unlink(dst)
    except OSError: pass
    if not rec or float(rec.get("exp", 0)) < time.time(): return None
    gone(h, "used")
    return rec

def sweep():
    while True:
        time.sleep(SWEEP_SECS)
        now = time.time()
        try:
            for n in os.listdir(STORE):
                p = os.path.join(STORE, n)
                try:
                    if n.endswith((".taken", ".tmp")):
                        if now - os.stat(p).st_mtime > 60: os.unlink(p)
                    elif n.endswith(".json"):
                        if float(json.load(open(p, encoding="utf-8")).get("exp", 0)) < now: os.unlink(p); gone(n[:-5], "expired")
                except (OSError, ValueError): pass
        except OSError: pass
        with _lock:
            for k in list(_forms):
                _forms[k] = [x for x in _forms[k] if x[1] > now]
                if not _forms[k]: _forms.pop(k, None)
            for k in [k for k, l in _fails.items() if not l or now - l[-1] > FAIL_WINDOW]: _fails.pop(k, None)

FONT_PATH = "/usr/local/libexec/@@PFX@@-ui/Pretendard.woff2"
try:
    with open(FONT_PATH, "rb") as _f: FONT = _f.read()
except OSError: FONT = b""

CSS = ("@font-face{font-family:Pretendard;src:url(/start/pretendard.woff2) format('woff2');font-weight:100 900;font-display:swap}"
       ":root{--bg:#fff;--fg:#0a0a0b;--mu:#f4f4f5;--mf:#71717a;--bd:#e4e4e7;--pr:#18181b;--pf:#fafafa;--warn-bg:#fff7e6;--warn-bd:#f5c26b;--warn-fg:#7a4a00;--tb:#101014;--tf:#4ade80;--td:#3f6b4f;color-scheme:light}"
       "@media (prefers-color-scheme:dark){:root{--bg:#09090b;--fg:#fafafa;--mu:#27272a;--mf:#a1a1aa;--bd:#27272a;--pr:#fafafa;--pf:#18181b;--warn-bg:#2a2108;--warn-bd:#6b4e12;--warn-fg:#f3c76b;--tb:#050507;color-scheme:dark}}"
       "*{box-sizing:border-box}html{scrollbar-gutter:stable}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.65 Pretendard,system-ui,-apple-system,'Noto Sans KR','Malgun Gothic',sans-serif;letter-spacing:-.011em;word-break:keep-all;overflow-wrap:anywhere;-webkit-font-smoothing:antialiased}"
       "main{max-width:34rem;margin:0 auto;padding:2rem 1rem 3rem}.tag{font-size:.8rem;font-weight:600;color:var(--mf);letter-spacing:.02em;margin:0 0 .5rem}"
       "h1{font-size:1.6rem;line-height:1.3;letter-spacing:-.03em;margin:0 0 1.2rem}h2{font-size:1.05rem;margin:0 0 .5rem;letter-spacing:-.02em}"
       ".card{border:1px solid var(--bd);border-radius:12px;padding:1.2rem 1.3rem;margin:0 0 1rem;box-shadow:0 1px 2px #0000000d}"
       ".warn{background:var(--warn-bg);border:1px solid var(--warn-bd);color:var(--warn-fg);border-radius:10px;padding:.7rem .9rem;margin:0 0 1rem;font-size:.92rem}"
       "button{display:inline-flex;align-items:center;justify-content:center;width:100%;height:3rem;font:inherit;font-weight:600;cursor:pointer;color:var(--pf);background:var(--pr);border:0;border-radius:10px;box-shadow:0 1px 2px #0000001f;transition:opacity .15s,transform .08s}"
       "button:hover{opacity:.9}button:active{transform:translateY(1px) scale(.99)}button:focus-visible{outline:2px solid var(--fg);outline-offset:3px}"
       "ol.steps{list-style:none;margin:0;padding:0;counter-reset:s}ol.steps>li{counter-increment:s}"
       "ol.steps>li>h2:before{content:counter(s);display:inline-flex;align-items:center;justify-content:center;width:1.6rem;height:1.6rem;margin-right:.55rem;border-radius:50%;background:var(--pr);color:var(--pf);font-size:.85rem}"
       ".hint{color:var(--mf);font-size:.9rem;margin:.4rem 0 0}.qr{text-align:center;margin:.8rem 0}img{width:15rem;height:15rem;max-width:100%;image-rendering:pixelated;border:1px solid var(--bd);border-radius:10px;background:#fff;padding:.4rem}"
       ".term{background:var(--tb);border:1px solid var(--bd);border-radius:10px;overflow:hidden;margin:.6rem 0}.term-bar{display:flex;gap:.4rem;padding:.45rem .8rem;background:#ffffff0a;border-bottom:1px solid #ffffff14}"
       ".term-bar i{width:.6rem;height:.6rem;border-radius:50%;background:#ffffff2e}.term-bar i:nth-child(1){background:#ff5f57}.term-bar i:nth-child(2){background:#febc2e}.term-bar i:nth-child(3){background:#28c840}"
       ".term pre{margin:0;padding:.8rem 1rem;color:var(--tf);font:.95rem/1.7 ui-monospace,'D2Coding',SFMono-Regular,Menlo,Consolas,monospace;white-space:pre-wrap;word-break:break-all}.term pre b{color:#86efac;font-size:1.15rem;letter-spacing:.06em}.term pre span{color:var(--td)}"
       "code{font:.9rem ui-monospace,Menlo,Consolas,monospace;background:var(--mu);padding:.1rem .4rem;border-radius:5px;word-break:break-all}")

def page(nonce, title, body):
    return (f'<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
            f'<meta name="robots" content="noindex,nofollow"><title>{html.escape(title)}</title><style nonce="{nonce}">{CSS}</style></head>'
            f'<body><main><p class="tag">회원 안내</p><h1>{html.escape(title)}</h1>{body}</main></body></html>').encode()

def confirm_body(path, form):
    return ('<div class="warn">이 안내는 <b>한 번만</b> 보입니다. 열면 이 링크는 바로 사라지고 다시 볼 수 없습니다. '
            '비밀번호를 적거나 복사해 둘 준비가 되었을 때만 누르세요.</div>'
            f'<form method="post" action="{html.escape(path)}"><input type="hidden" name="f" value="{html.escape(form)}">'
            '<button type="submit">한 번만 보기 — 열기</button></form>')

def reveal_body(p):
    e = lambda k: html.escape(str(p.get(k, "")))
    steps = []
    if p.get("qr_png_b64"):
        qr = (f'<div class="qr"><img alt="Paseo 페어링 QR" src="data:image/png;base64,{html.escape(p["qr_png_b64"], quote=True)}"></div>'
              '<p class="hint">Paseo 앱에서 이 QR 을 스캔하면 바로 연결됩니다. 연결에는 아래 초기 비밀번호가 필요하지 않습니다.</p>')
        if p.get("pairing_url"): qr += f'<p class="hint">QR 을 쓸 수 없으면 Paseo 앱에 이 링크를 붙여 넣으세요(영구 자격증명처럼 다루세요):<br><code>{e("pairing_url")}</code></p>'
        steps.append(f'<li class="card"><h2>Paseo 앱으로 연결</h2>{qr}</li>')
    lines = f'<span># 회원 ID</span>\n{e("user")}\n<span># 초기 비밀번호</span>\n<b>{e("password")}</b>'
    if p.get("ssh"): lines += f'\n\n<span># 터미널 접속</span>\n$ {e("ssh")}'
    if p.get("portal"): lines += f'\n\n<span># 안내 페이지</span>\n{e("portal")}'
    steps.append('<li class="card"><h2>터미널(SSH)·파일 서비스를 쓸 때</h2>'
                 f'<div class="term"><div class="term-bar"><i></i><i></i><i></i></div><pre>{lines}</pre></div>'
                 '<p class="hint">Paseo 만 쓰신다면 이 비밀번호는 필요하지 않습니다. SSH 로 처음 로그인할 때 새 비밀번호로 <b>바꿔야</b> 하고, 바꾼 비밀번호는 파일 서비스에도 같이 적용됩니다.</p></li>')
    return (f'<p>{e("user")} 님의 개발환경 계정입니다.</p>'
            '<div class="warn">이 화면은 <b>한 번만</b> 보이고 다시 볼 수 없습니다. 지금 적어 두세요. 다른 사람과 공유하지 마세요.</div>'
            f'<ol class="steps">{"".join(steps)}</ol>')

class H(BaseHTTPRequestHandler):
    timeout = 10          # 소켓 읽기 한 번의 제한(느린 연결). 총 시간은 아래 DEADLINE 이 따로 끊는다
    server_version = "link"; sys_version = ""

    def setup(self):
        super().setup()   # slowloris: 바이트를 조금씩 흘려 소켓 제한을 계속 갱신해도 요청 전체가 DEADLINE 초를 넘기면 연결을 끊는다(헤더 읽기 포함)
        self._dl = threading.Timer(DEADLINE, self._kill); self._dl.daemon = True; self._dl.start()
    def _kill(self):
        try: self.connection.shutdown(socket.SHUT_RDWR)
        except OSError: pass
    def finish(self):
        self._dl.cancel()
        try: super().finish()
        except OSError: pass

    def log_message(self, *a): pass   # 기본 접근 로그는 요청 줄(토큰 포함)을 찍으므로 끈다

    def client(self):
        ip = self.client_address[0]
        if ip == "127.0.0.1":   # 신뢰하는 것은 우리 앞의 Caddy 가 덮어쓴 전용 헤더뿐. 없거나 형식이 틀리면 연결 상대 주소
            try: return str(ipaddress.ip_address(self.headers.get(CLIENT_IP_HEADER, "").strip()))
            except ValueError: pass
        return ip

    def send(self, code, body=b"", nonce="", extra=None, ctype="text/html; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "public, max-age=86400" if ctype.startswith("font/") else "no-store"); self.send_header("Pragma", "no-cache"); self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Robots-Tag", "noindex, nofollow, noarchive"); self.send_header("X-Content-Type-Options", "nosniff"); self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", f"default-src 'none'; img-src data:; font-src 'self'; style-src 'nonce-{nonce}'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'")
        for k, v in (extra or {}).items(): self.send_header(k, v)
        self.send_header("Connection", "close"); self.end_headers()
        if self.command != "HEAD": self.wfile.write(body)

    def msg(self, code, title, text, extra=None):
        n = secrets.token_urlsafe(12); self.send(code, page(n, title, f"<p>{html.escape(text)}</p>"), n, extra)

    def bad(self, ip, code=404, h=None):
        """실패로 센다. 문구는 가능한 만큼 구분한다: 이미 열림 · 기간 지남 · 그 밖(없는 링크)"""
        fail(ip)
        why = _gone.get(h, ("", 0))[0] if h else ""
        if why == "used": self.msg(code, "이미 열린 링크", "이 링크는 이미 열렸습니다. 본인이 연 것이 아니라면 다른 사람이 먼저 열었을 수 있으니 관리자에게 알리세요.")
        elif why == "expired": self.msg(code, "기간이 지난 링크", "이 링크는 유효 기간이 지났습니다. 관리자에게 새 링크를 요청하세요.")
        else: self.msg(code, "열 수 없는 링크", "링크가 없거나 이미 사용했거나 기간이 지났습니다. 관리자에게 새 링크를 요청하세요.")

    def route(self):
        try: self._route()
        except (OSError, ValueError) as e:   # 연결 끊김·잘못된 입력: 트레이스백 없이 형식만 기록한다
            log(f"요청 처리 중단 {type(e).__name__}")
            self.close_connection = True
        except Exception as e:
            log(f"내부 오류 {type(e).__name__}")
            try: self.msg(500, "오류", "처리하지 못했습니다. 잠시 뒤에 다시 하세요.")
            except OSError: pass

    def _route(self):
        # http.server 는 «//경로» 의 앞 슬래시를 하나로 줄여 self.path 에 넣는다 — 원래 요청줄의 경로로 검사해 //start/… 변형을 막는다
        parts = self.requestline.split(); raw = parts[1] if len(parts) == 3 else ""
        if raw == "/start/pretendard.woff2" and self.command in ("GET", "HEAD"):      # 글꼴 한 개(비밀 없음, 캐시 허용)
            return self.send(200, FONT, ctype="font/woff2")
        ip = self.client(); m = PATH_RE.fullmatch(raw)
        if not m: return self.msg(404, "찾을 수 없음", "없는 주소입니다.")
        if blocked(ip):
            log(f"차단 ip={ip}"); return self.msg(429, "잠시 후 다시", "시도가 너무 많습니다. 잠시 뒤에 다시 하세요.", {"Retry-After": str(FAIL_WINDOW)})
        token = m.group(1)
        if not TOKEN_RE.fullmatch(token): return self.bad(ip)
        h = link_hash(token)
        if self.command == "GET": return self.do_confirm(ip, h, token)
        return self.do_reveal(ip, h)

    def do_confirm(self, ip, h, token):
        rec, st = load(h)
        if not rec:
            if st == "expired": gone(h, "expired")
            log(f"무효 GET link={h[:8]} ip={ip}"); return self.bad(ip, 404, h)
        form = secrets.token_urlsafe(24)
        with _lock: _forms[h] = (_forms.get(h, []) + [(form, time.time() + FORM_TTL)])[-MAX_FORMS:]
        n = secrets.token_urlsafe(12)
        log(f"확인 화면 link={h[:8]} ip={ip}")
        self.send(200, page(n, f"{BRAND} 개발환경 안내", confirm_body(f"/start/{token}", form)), n)

    def do_reveal(self, ip, h):
        try: n = int(self.headers.get("Content-Length", ""))
        except ValueError: n = -1
        if n < 0 or n > MAX_BODY: self.close_connection = True; return self.msg(413, "요청이 너무 큼", "요청 본문이 허용 크기를 넘었습니다.")
        if "application/x-www-form-urlencoded" not in self.headers.get("Content-Type", ""): return self.bad(ip, 400, h)
        raw = self.rfile.read(n)   # 바이트 그대로 — 비ASCII 값이 와도 문자열 비교에서 예외가 나지 않게 모든 대조를 바이트로 한다
        form = next((p[2:] for p in raw.split(b"&") if p.startswith(b"f=")), b"")
        with _lock:
            now = time.time(); ok = False
            for x in _forms.get(h, []):   # 모두 대조한다(상수 시간 비교) — 맞는 것 하나만 지운다(1회용)
                if x[1] > now and hmac.compare_digest(x[0].encode(), form): ok = True; _forms[h] = [y for y in _forms[h] if y is not x]
        if not ok:
            log(f"폼 토큰 불일치 link={h[:8]} ip={ip}")
            rec, _ = load(h)
            if rec:   # 링크는 살아 있다 — 확인 화면(폼)이 오래되었거나 다른 창에서 새로 열린 것
                fail(ip); return self.msg(400, "다시 열어 주세요", "확인 화면이 오래되었거나 새로 고쳐졌습니다. 링크는 아직 사용되지 않았으니, 링크를 다시 열어 «열기» 를 눌러 주세요.")
            return self.bad(ip, 400, h)
        with _lock: _forms.pop(h, None)   # 이 링크의 나머지 폼 토큰도 버린다
        rec = take(h)
        if not rec: log(f"소비 실패 link={h[:8]} ip={ip}"); return self.bad(ip, 404, h)
        log(f"열람 완료 link={h[:8]} user={rec.get('user', '?')} ip={ip}")
        nn = secrets.token_urlsafe(12)
        self.send(200, page(nn, f"{BRAND} 개발환경 안내", reveal_body(rec.get("payload", {}))), nn)

    do_GET = do_POST = route
    def other(self):
        n = secrets.token_urlsafe(12); self.send(405, page(n, "허용되지 않는 요청", "<p>GET · POST 만 받습니다.</p>"), n, {"Allow": "GET, POST"})
    do_HEAD = do_PUT = do_DELETE = do_PATCH = do_OPTIONS = other

class Server(ThreadingHTTPServer):
    daemon_threads = True
    def __init__(self, *a, **k):
        super().__init__(*a, **k); self._sem = threading.BoundedSemaphore(MAX_CONN)
    def process_request(self, request, client_address):
        if not self._sem.acquire(blocking=False):   # 동시 연결 상한: 초과는 스레드를 만들지 않고 즉시 503
            try:
                request.settimeout(1); request.sendall(b"HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nRetry-After: 5\r\nConnection: close\r\n\r\n")
            except OSError: pass
            self.shutdown_request(request); return
        super().process_request(request, client_address)
    def process_request_thread(self, request, client_address):
        try: super().process_request_thread(request, client_address)
        finally: self._sem.release()
    def handle_error(self, request, client_address):
        log(f"연결 처리 오류 {type(sys.exc_info()[1]).__name__}")   # 기본 구현은 트레이스백(요청 정보 포함 가능)을 찍는다

def main():
    env = read_env(SITE)
    port = int(env.get("ONBOARD_LINK_PORT", "8431") or "8431")
    if not os.path.isdir(STORE): sys.exit(f"저장소가 없습니다: {STORE}")
    threading.Thread(target=sweep, daemon=True).start()
    srv = Server(("127.0.0.1", port), H)
    log(f"@@PFX@@-link-server 시작 127.0.0.1:{port}")
    srv.serve_forever()

if __name__ == "__main__":
    main()
