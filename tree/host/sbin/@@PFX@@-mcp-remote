#!/usr/bin/env python3
# @@PFX@@-mcp-remote (관리자, root) — 원격 MCP 서비스를 켜고 끈다. 기본은 꺼져 있고, 후보만 제공한다.
#   @@PFX@@-mcp-remote list | enable <이름> | disable <이름>
# 켜도 멤버는 서비스 쪽에서 토큰을 신청해 ~/.@@PFX@@/<이름>-token(600)에 두어야 등록된다(@@PFX@@-mcp-sync).
import json, os, sys, tempfile
D = "/opt/@@PFX@@/managed-mcp"; REG = f"{D}/remote-services.json"; CAND = f"{D}/remote-services.candidates.json"
def load(p, k):
    try: return json.load(open(p))[k]
    except Exception: return []
def save(items):
    fd, t = tempfile.mkstemp(dir=D); os.fchmod(fd, 0o644)
    with os.fdopen(fd, "w") as f: json.dump({"services": items}, f, ensure_ascii=False, indent=1)
    os.replace(t, REG)
if os.geteuid() != 0: sys.exit("run as root")
cmd, name = (sys.argv[1:] + ["", ""])[:2]
on = load(REG, "services"); cand = {c["name"]: c for c in load(CAND, "candidates")}
if cmd == "list":
    for n, c in cand.items(): print(f"{'ON ' if any(s['name']==n for s in on) else 'off'}  {n:10} {c['title']}\n       토큰: {c['token_help']}")
elif cmd == "enable" and name in cand:
    save([s for s in on if s["name"] != name] + [{k: cand[name][k] for k in ("name", "title", "url")}]); print(f"PASS: {name} 켬 — 허브가 다음 요청부터 사용")
elif cmd == "disable" and name:
    save([s for s in on if s["name"] != name]); print(f"PASS: {name} 끔")
else: sys.exit("usage: @@PFX@@-mcp-remote list | enable <이름> | disable <이름>")
