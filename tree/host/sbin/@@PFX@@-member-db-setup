#!/usr/bin/env bash
# @@PFX@@-member-db-setup (관리자) — 멤버 PostgreSQL 발급 + 암호를 «화면에 찍지 않고» 멤버 컨테이너의 ~/.pgpass(0600)에 직접 넣는다.
#   @@PFX@@-member-db-setup <멤버> [--db <DB 이름>] [--rotate] [--dry-run]
#   새 멤버: 네트워크 연결 · 역할(CREATEDB, 연결 20개 제한) · DB 생성 · PUBLIC CONNECT 회수 · .pgpass 주입 · 본인 DB 접속과 타 DB 차단 확인
#   이미 역할이 있는 멤버: 기본은 거부한다(암호를 바꾸면 기존 앱·작업이 끊길 수 있음). --rotate 를 주면 암호를 새로 정하고 .pgpass 에 넣는다.
# 암호는 변수로만 다루고 출력·로그에 남기지 않는다. 기존 @@PFX@@-member-db-add 는 건드리지 않는다.
set -euo pipefail
PG="${PG_CONTAINER:-postgres}"; NET="${DB_NET:-db-clients}"; PROTECTED_DBS="${PROTECTED_DBS:-$(grep -Eq "^MODULES=.*[ '\"]n8n[ '\"]" /etc/@@PFX@@/site.env 2>/dev/null && echo n8n || true)}"; LIMIT="${AI_DB_CONNLIMIT:-20}"
usage(){ echo "usage: @@PFX@@-member-db-setup <멤버> [--db <DB 이름>] [--rotate] [--dry-run]" >&2; exit 2; }
U=""; DB=""; ROT=0; DRY=0
while [ $# -gt 0 ]; do case $1 in --db) DB=${2:-}; shift 2;; --rotate) ROT=1; shift;; --dry-run) DRY=1; shift;; -h|--help) usage;; -*) echo "알 수 없는 옵션: $1" >&2; usage;; *) [ -n "$U" ] && usage; U=$1; shift;; esac; done
[ -n "$U" ] || usage; DB=${DB:-${U}_db}; C="dev-$U"
case "$U$DB" in *[!a-zA-Z0-9_]*) echo "ERROR: 이름은 영숫자와 밑줄만: $U / $DB" >&2; exit 1;; esac
q(){ docker exec "$PG" psql -U postgres -tAc "$1"; }
x(){ docker exec "$PG" psql -U postgres -v ON_ERROR_STOP=1 -c "$1" >/dev/null; }
xp(){ docker exec -i "$PG" psql -U postgres -v ON_ERROR_STOP=1 -q >/dev/null; }   # 암호가 든 문장은 명령줄(ps)에 올리지 않고 stdin 으로 보낸다
run(){ if [ "$DRY" = 1 ]; then echo "  [dry-run] $*"; else "$@"; fi; }
echo "===== PRECHECK ====="
docker inspect "$PG" >/dev/null 2>&1 || { echo "ERROR: 컨테이너 없음: $PG" >&2; exit 1; }
docker inspect "$C" >/dev/null 2>&1 || { echo "ERROR: 멤버 컨테이너 없음: $C" >&2; exit 1; }
docker network inspect "$NET" >/dev/null 2>&1 || { echo "ERROR: 네트워크 없음: $NET" >&2; exit 1; }
q 'select 1' >/dev/null || { echo "ERROR: postgres 응답 없음" >&2; exit 1; }
HAVE_ROLE=$(q "select count(*) from pg_roles where rolname='$U'"); HAVE_DB=$(q "select count(*) from pg_database where datname='$DB'")
RETIRED=0
if [ "$HAVE_DB" != 0 ]; then own=$(q "select pg_get_userbyid(datdba) from pg_database where datname='$DB'"); [ "$own" = "$U" ] || { echo "ERROR: DB $DB 가 이미 있고 소유자($own)가 $U 가 아닙니다 — 중단(다른 사람이 같은 이름을 먼저 만들었을 수 있음)" >&2; exit 1; }; fi
if [ "$HAVE_ROLE" != 0 ] && [ "$(q "select count(*) from pg_roles where rolname='$U' and shobj_description(oid,'pg_authid') like 'retired:%'")" != 0 ]; then
  RETIRED=1; ROT=1   # 삭제 뒤 보관 중인 role: 되살린다(새 암호를 정하고, DB 는 그대로)
  echo "보관 중인 role 입니다 — 되살립니다(새 암호 · 기존 DB 유지): $U"
fi
if [ "$HAVE_ROLE" != 0 ] && [ "$ROT" != 1 ]; then
  echo "이미 역할이 있습니다: $U — 암호를 바꾸면 기존 앱·작업이 끊길 수 있어 기본은 중단합니다." >&2
  echo "  암호를 새로 정하고 ~/.pgpass 에 넣으려면: @@PFX@@-member-db-setup $U --rotate" >&2; exit 1
fi
echo "PASS  member=$U role=$([ "$HAVE_ROLE" != 0 ] && echo 있음\(rotate\) || echo 새로) db=$DB($([ "$HAVE_DB" != 0 ] && echo 있음 || echo 새로))"
echo; echo "===== 1. NETWORK ====="
if docker inspect "$C" --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' | grep -qw "$NET"; then echo "SKIP  이미 $NET 에 연결됨"; else run docker network connect "$NET" "$C"; echo "OK    $C → $NET"; fi
echo; echo "===== 2. ROLE / DATABASE ====="
PW=$(head -c 32 /dev/urandom | base64 | tr -d '/+=' | cut -c1-24)
if [ "$DRY" = 1 ]; then echo "  [dry-run] ROLE $U ($([ "$HAVE_ROLE" != 0 ] && echo 암호 재설정 || echo 생성)) · CREATEDB · CONNECTION LIMIT $LIMIT · DB $DB"; else
  if [ "$HAVE_ROLE" = 0 ]; then printf '%s;\n' "CREATE ROLE \"$U\" LOGIN PASSWORD '$PW' CREATEDB CONNECTION LIMIT $LIMIT" | xp; else printf '%s;\n' "ALTER ROLE \"$U\" LOGIN PASSWORD '$PW' CONNECTION LIMIT $LIMIT" | xp; [ "$RETIRED" = 1 ] && x "COMMENT ON ROLE \"$U\" IS NULL"; fi
  [ "$HAVE_DB" = 0 ] && x "CREATE DATABASE \"$DB\" OWNER \"$U\""
  echo "OK    role=$U db=$DB connlimit=$LIMIT"; fi
echo; echo "===== 3. ISOLATION ====="
for d in $DB $PROTECTED_DBS; do
  [ "$DRY" = 1 ] && { echo "  [dry-run] REVOKE CONNECT ON DATABASE $d FROM PUBLIC"; continue; }
  x "REVOKE CONNECT ON DATABASE \"$d\" FROM PUBLIC"
  acl=$(q "select coalesce(array_to_string(datacl,','),'') from pg_database where datname='$d'")
  case "$acl" in *"=Tc/"*|"") echo "FAIL  $d — CONNECT 가 열려 있음: $acl" >&2; exit 1;; *) echo "OK    $d  $acl";; esac
done
[ "$DRY" = 1 ] && { echo; echo "[dry-run] ~/.pgpass 주입·검증은 건너뜀 — 아무것도 바꾸지 않았습니다."; exit 0; }
echo; echo "===== 4. ~/.pgpass 주입(암호는 화면에 나오지 않음) ====="
LINE="$PG:5432:*:$U:$PW"
printf '%s\n' "$LINE" | docker exec -i -u "$U" "$C" sh -c 'umask 077; f="$HOME/.pgpass"; t="$f.new"; { [ -f "$f" ] && grep -v "^'"$PG"':5432:\*:'"$U"':" "$f" || true; cat; } > "$t"; chmod 600 "$t"; mv -f "$t" "$f"'
unset PW LINE
echo "OK    ~$U/.pgpass (0600)"
echo; echo "===== 5. VERIFY(멤버 권한으로 .pgpass 를 써서 접속) ====="
own=$(docker exec -u "$U" "$C" psql -h "$PG" -U "$U" -d "$DB" -w -tAc 'select current_database()' 2>&1 | tail -1)
[ "$own" = "$DB" ] && echo "OK    본인 DB 접속: $own" || { echo "FAIL  본인 DB 접속 실패: $own" >&2; exit 1; }
for d in $PROTECTED_DBS; do
  out=$(docker exec -u "$U" "$C" psql -h "$PG" -U "$U" -d "$d" -w -tAc 'select 1' 2>&1 | tail -2 || true)
  case "$out" in *"does not have CONNECT privilege"*) echo "OK    $d 차단 확인";; *) echo "FAIL  $d 가 차단되지 않음: $out" >&2; exit 1;; esac
done
echo; echo "===== RESULT PASS ====="
echo "멤버는 컨테이너에서: @@PFX@@-app db status  (접속 정보는 ~/.pgpass, 암호는 어디에도 출력되지 않았습니다)"
