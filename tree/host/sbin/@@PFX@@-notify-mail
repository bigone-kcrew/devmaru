#!/usr/bin/env python3
# @@PFX@@-notify-mail (root) — 회원 등록 안내 메일을 SMTP 로 직접 보낸다(n8n 불필요, 파이썬 표준 라이브러리만).
#   @@PFX@@-notify-mail send --user <ID> --email <주소> --password-file <파일>   등록 안내(초기 비밀번호는 파일에서만 읽는다)
#   @@PFX@@-notify-mail --check                                          SMTP 연결·인증만 시험(메일은 보내지 않음)
#   @@PFX@@-notify-mail --test <주소>                                    시험 메일 1통
# 설정: /etc/@@PFX@@/secrets/smtp.env (0600) — SMTP_HOST SMTP_PORT SMTP_SECURITY(starttls|ssl|none) SMTP_USER SMTP_PASSWORD MAIL_FROM [SMTP_VERIFY=0]
# 비밀번호는 명령줄·로그에 남기지 않는다. 오류 메시지에서도 가린다.
import argparse, os, re, smtplib, ssl, sys
from email.message import EmailMessage

CONF = "/etc/@@PFX@@/secrets/smtp.env"
SITE = "/etc/@@PFX@@/site.env"
ONBOARD = "/srv/@@PFX@@/onboarding"
USER_RE = re.compile(r"^[a-z][a-z0-9_-]{1,31}$")
ADDR_RE = re.compile(r"^[^\s@<>,;\"']+@[^\s@<>,;\"']+\.[^\s@<>,;\"']+$")

def read_env(path):
    out = {}
    try:
        for line in open(path, encoding="utf-8"):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1); v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"": v = v[1:-1]
                out[k.strip()] = v
    except OSError:
        pass
    return out

def die(msg, secrets=()):
    for s in secrets:
        if s: msg = msg.replace(s, "***")
    print("실패: " + msg, file=sys.stderr); sys.exit(1)

def load_conf():
    if not os.path.exists(CONF): die(f"SMTP 설정이 없습니다({CONF}). 설치기의 mail 단계(52)를 실행하세요")
    if os.stat(CONF).st_mode & 0o077: die(f"{CONF} 권한이 너무 넓습니다(0600 이어야 함)")
    c = read_env(CONF)
    for k in ("SMTP_HOST", "MAIL_FROM"):
        if not c.get(k): die(f"{CONF} 에 {k} 가 없습니다")
    c.setdefault("SMTP_PORT", "587"); c.setdefault("SMTP_SECURITY", "starttls")
    if c["SMTP_SECURITY"] not in ("starttls", "ssl", "none"): die("SMTP_SECURITY 는 starttls · ssl · none 중 하나입니다")
    if not ADDR_RE.match(c["MAIL_FROM"]): die("MAIL_FROM 형식이 올바르지 않습니다")
    return c

def connect(c):
    ctx = ssl.create_default_context()
    if c.get("SMTP_VERIFY", "1") == "0": ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE   # 사설 인증서 릴레이용
    port = int(c["SMTP_PORT"])
    if c["SMTP_SECURITY"] == "ssl": s = smtplib.SMTP_SSL(c["SMTP_HOST"], port, timeout=30, context=ctx)
    else:
        s = smtplib.SMTP(c["SMTP_HOST"], port, timeout=30); s.ehlo()
        if c["SMTP_SECURITY"] == "starttls": s.starttls(context=ctx); s.ehlo()
    if c.get("SMTP_USER"): s.login(c["SMTP_USER"], c.get("SMTP_PASSWORD", ""))
    return s

def deliver(c, msg):
    pw = c.get("SMTP_PASSWORD", "")
    try:
        with connect(c) as s: s.send_message(msg)
    except Exception as e:   # 비밀번호가 들어갈 수 있는 모든 문자열에서 가린다
        die(f"{type(e).__name__}: {e}", (pw,))

def site_ssh():
    port = read_env(SITE).get("SSH_PORT", "22")
    return "ssh <ID>@@@SSH_HOST@@" + ("" if port == "22" else f" -p {port}")

def member_message(c, user, email, password):
    m = EmailMessage()
    m["Subject"] = "[@@BRAND@@] 개발환경 계정이 만들어졌습니다"; m["From"] = c["MAIL_FROM"]; m["To"] = email
    m.set_content(
        f"안녕하세요, {user} 님.\n\n@@BRAND@@ 개발환경 계정이 만들어졌습니다.\n\n"
        f"[로그인 정보]\n- 회원 ID: {user}\n- 초기 비밀번호: {password}\n"
        "  (첫 로그인 때 새 비밀번호로 바꿔야 합니다. 이 메일을 다른 사람에게 전달하지 마세요.)\n\n"
        "[첫 로그인]\n"
        f"- 터미널: {site_ssh().replace('<ID>', user)}\n"
        "- 안내 페이지: https://@@PORTAL_HOST@@/guide/ (처음 해야 할 일이 순서대로 적혀 있습니다)\n\n"
        "[Paseo 로 접속하기 — 터미널 없이]\n"
        "휴대폰·PC 의 Paseo 앱에서 첨부된 pairing.png(QR)를 스캔하면 자기 개발환경에 바로 연결됩니다.\n"
        "(이 QR 은 영구 자격증명처럼 다루세요. 다른 사람과 공유하지 마세요.)\n\n"
        "이 메일은 자동으로 발송되었습니다.\n")
    qr = os.path.join(ONBOARD, user, "pairing.png")
    if os.path.isfile(qr):
        m.add_attachment(open(qr, "rb").read(), maintype="image", subtype="png", filename="pairing.png")
    return m

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("action", nargs="?", choices=["send"]); ap.add_argument("--user"); ap.add_argument("--email"); ap.add_argument("--password-file")
    ap.add_argument("--check", action="store_true"); ap.add_argument("--test", metavar="주소")
    a = ap.parse_args()
    if os.geteuid() != 0: die("root 로 실행하세요(sudo)")
    c = load_conf()
    if a.check:
        pw = c.get("SMTP_PASSWORD", "")
        try: connect(c).quit()
        except Exception as e: die(f"{type(e).__name__}: {e}", (pw,))
        print(f"성공: SMTP 연결·인증 확인({c['SMTP_HOST']}:{c['SMTP_PORT']}, {c['SMTP_SECURITY']})"); return
    if a.test:
        if not ADDR_RE.match(a.test): die("받는 주소 형식이 올바르지 않습니다")
        m = EmailMessage(); m["Subject"] = "[@@BRAND@@] 메일 발송 시험"; m["From"] = c["MAIL_FROM"]; m["To"] = a.test
        m.set_content("@@BRAND@@ 서버의 메일 발송 설정이 정상입니다. (자동 시험 메일)\n")
        deliver(c, m); print(f"성공: 시험 메일을 보냈습니다 → {a.test}"); return
    if a.action != "send": ap.error("send 또는 --check · --test 중 하나가 필요합니다")
    if not (a.user and a.email and a.password_file): ap.error("send 에는 --user --email --password-file 이 모두 필요합니다")
    if not USER_RE.match(a.user): die("회원 ID 형식이 올바르지 않습니다")
    if not ADDR_RE.match(a.email): die("받는 주소 형식이 올바르지 않습니다")
    try: password = open(a.password_file, encoding="utf-8").read().rstrip("\r\n")
    except OSError as e: die(f"초기 비밀번호 파일을 읽을 수 없습니다: {e.strerror}")
    if not password: die("초기 비밀번호 파일이 비어 있습니다")
    deliver(c, member_message(c, a.user, a.email, password))
    print(f"성공: 안내 메일을 보냈습니다 → {a.email}")

if __name__ == "__main__":
    main()
