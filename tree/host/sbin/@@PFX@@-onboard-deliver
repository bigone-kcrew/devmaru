#!/usr/bin/env python3
# @@PFX@@-onboard-deliver (root) — 회원 등록 안내(초기 비밀번호 + Paseo 페어링)를 «전달 채널» 목록대로 전달한다. @@PFX@@-member-add 가 부른다.
#   @@PFX@@-onboard-deliver deliver --user <ID> --email <주소> --password-file <파일> [--secret-fd N]
#   @@PFX@@-onboard-deliver --check            채널 설정 점검(메시지는 보내지 않음)
#   @@PFX@@-onboard-deliver --test-webhook     webhook 시험 메시지 1건(비밀 없음)
# 채널(site.env 의 ONBOARD_CHANNELS, 공백 구분·순서대로): screen smtp n8n link webhook print
#   ONBOARD_CHANNELS 가 없으면 MAIL_MODE 에서 유도한다: none→screen · smtp→smtp screen · n8n→n8n screen.
# 규칙: 한 채널이 실패해도 다음 채널을 계속하고 회원 등록은 이미 끝나 있다. screen(화면 표시)은 목록의 어디에 있든(없어도)
#   «비밀(비밀번호·링크·QR)을 전달한 다른 채널이 하나도 성공하지 못했을 때» 마지막 보루로만 실행된다. webhook 은 비밀을 싣지 않으므로
#   «전달 성공» 으로 치지 않는다. link 는 발급한 URL 을 화면에 출력한다(관리자가 회원에게 전달).
# 비밀(비밀번호·링크 URL)은 --secret-fd(기본 표준 출력)에만 쓴다 — member-add 는 이것을 로그 파일 밖(터미널)으로 보낸다.
import argparse, base64, grp, html, json, os, pwd, re, stat, subprocess, sys, tempfile, time, urllib.error, urllib.request

SITE = "/etc/@@PFX@@/site.env"
SECRETS = "/etc/@@PFX@@/secrets"
ONBOARD = "/srv/@@PFX@@/onboarding"
MEMBER_LINK = "/usr/local/sbin/@@PFX@@-member-link"
NOTIFY_MAIL = "/usr/local/sbin/@@PFX@@-notify-mail"
SEAL = "/opt/@@PFX@@/scripts/@@PFX@@-onboarding-seal"
N8N_URL = "http://127.0.0.1:5678/webhook/@@PFX@@-member-onboarding"
N8N_TOKEN = SECRETS + "/onboarding-notify-token"
BRAND = "@@BRAND@@"
USER_RE = re.compile(r"[a-z][a-z0-9_-]{1,31}")   # fullmatch 로만 쓴다
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+")   # 괄호·주석·따옴표·비ASCII 불허
ROOT_UID = 0   # 온보딩 폴더·파일은 root 소유여야 읽는다(회원이 심은 파일·심볼릭 링크 방어)
PFX_GROUP = "@@PFX@@"
CHANNELS = ("screen", "smtp", "n8n", "link", "webhook", "print")
SECRET_CHANNELS = ("screen", "smtp", "n8n", "link", "print")   # 비밀을 전달하는 채널(webhook 은 제외)
FORMATS = ("generic", "slack", "discord", "telegram")

def read_env(path):
    out = {}
    try:
        for line in open(path, encoding="utf-8"):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1); v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"": v = v[1:-1]
                out[k.strip()] = v
    except OSError:
        pass
    return out

def check_dir(d):
    """온보딩 폴더: lstat 으로 심볼릭 링크 아님·root 소유·그룹/기타 쓰기 없음을 확인한다."""
    try: ds = os.lstat(d)
    except OSError: raise RuntimeError(f"온보딩 폴더가 없습니다({d})")
    if stat.S_ISLNK(ds.st_mode) or not stat.S_ISDIR(ds.st_mode) or ds.st_uid != ROOT_UID or ds.st_mode & 0o022:
        raise RuntimeError(f"온보딩 폴더가 안전하지 않습니다(root 소유가 아니거나 심볼릭 링크이거나 쓰기 권한이 넓음): {d}")

def safe_read(d, name, cap=262144):
    """O_NOFOLLOW 로 열고 fstat 로 «일반 파일·root 소유» 를 확인한 뒤 읽는다. 없으면 None, 위반이면 오류."""
    check_dir(d)
    try: fd = os.open(os.path.join(d, name), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError: return None
    except OSError as e: raise RuntimeError(f"온보딩 파일을 열 수 없습니다({name}: {e.strerror}) — 심볼릭 링크일 수 있습니다")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != ROOT_UID: raise RuntimeError(f"온보딩 파일이 일반 파일이 아니거나 root 소유가 아닙니다: {name}")
        b = os.read(fd, cap + 1)
    finally: os.close(fd)
    return None if len(b) > cap else b

def harden_files(d, group_read):
    """회원별 페어링 파일을 기본 root:root 0600 으로 조인다. n8n 채널(컨테이너가 PFX 그룹으로 읽음)일 때만 root:<접두어> 0640 을 유지한다."""
    try: gid = grp.getgrnam(PFX_GROUP).gr_gid if group_read else 0
    except KeyError: gid = 0
    mode = 0o640 if (group_read and gid) else 0o600
    try: check_dir(d)
    except RuntimeError as e: print(f"경고: {e} — 페어링 파일 권한을 조이지 못했습니다"); return
    for n in ("pairing-url.txt", "pairing.json", "pairing.png"):
        try: fd = os.open(os.path.join(d, n), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        except OSError as e:
            if not isinstance(e, FileNotFoundError): print(f"경고: {n} 을(를) 열 수 없어 건너뜁니다({e.strerror})")
            continue
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != ROOT_UID: print(f"경고: {n} 이(가) 일반 파일이 아니거나 root 소유가 아닙니다 — 건너뜁니다"); continue
            try: os.fchmod(fd, mode)
            except PermissionError as e: print(f"경고: {n} 모드를 바꾸지 못했습니다({e.strerror})")
            try: os.fchown(fd, -1, gid)   # 소유자는 이미 root(위에서 확인) — 그룹만 바꾼다
            except PermissionError as e: print(f"경고: {n} 그룹을 바꾸지 못했습니다({e.strerror})")
        finally: os.close(fd)

def personal_group_gid(env):
    """관리자 계정의 «개인 그룹»(이름 = 사용자 이름, 구성원이 그 사용자뿐, 다른 사용자의 기본 그룹도 아님)의 gid. 아니면 None."""
    try:
        a = pwd.getpwnam(env.get("ADMIN_USER", "")); g = grp.getgrgid(a.pw_gid)
    except KeyError: return None
    if a.pw_uid == 0 or g.gr_gid == 0 or g.gr_name != a.pw_name or set(g.gr_mem) - {a.pw_name}: return None
    if any(u.pw_gid == g.gr_gid and u.pw_uid != a.pw_uid for u in pwd.getpwall()): return None
    return g.gr_gid

def channel_list(env):
    """(채널 목록, 알 수 없는 이름 목록). ONBOARD_CHANNELS 가 없으면 MAIL_MODE 에서 유도(하위 호환)."""
    raw = env.get("ONBOARD_CHANNELS")
    if raw is None or not raw.strip():
        raw = {"smtp": "smtp screen", "n8n": "n8n screen"}.get(env.get("MAIL_MODE", "none"), "screen")
    out, bad = [], []
    for c in raw.split():
        if c in CHANNELS:
            if c not in out: out.append(c)
        else: bad.append(c)
    return out, bad

def secret_path(env, key, default):
    """비밀 파일 경로: /etc/@@PFX@@/secrets/ 아래만, root 전용(0600 계열)일 것."""
    p = os.path.realpath(env.get(key) or os.path.join(SECRETS, default))
    if not p.startswith(os.path.realpath(SECRETS) + os.sep): raise ValueError(f"{key} 는 {SECRETS}/ 아래 파일이어야 합니다")
    try: st = os.stat(p)
    except OSError: raise ValueError(f"비밀 파일이 없습니다({p})")
    if st.st_mode & 0o077: raise ValueError(f"{p} 권한이 너무 넓습니다(0600 이어야 함)")
    if st.st_uid not in (0, os.geteuid()): raise ValueError(f"{p} 소유자가 root 가 아닙니다")
    return p

def allow_http(env): return (os.environ.get("ONBOARD_WEBHOOK_ALLOW_HTTP") or env.get("ONBOARD_WEBHOOK_ALLOW_HTTP", "")) == "1"

def check_url(url, env):
    if not re.fullmatch(r"https://[^\s/]+[^\s]*", url) and not (allow_http(env) and re.fullmatch(r"http://[^\s/]+[^\s]*", url)):
        raise ValueError("webhook 주소는 https:// 여야 합니다(내부 시험용 http 는 ONBOARD_WEBHOOK_ALLOW_HTTP=1 로 명시)")

class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k): return None   # 리다이렉트는 따라가지 않는다(비밀 주소가 다른 곳으로 가지 않게)

def http_post(url, obj, headers=None):
    req = urllib.request.Request(url, data=json.dumps(obj, ensure_ascii=False).encode(), method="POST",
                                 headers={"Content-Type": "application/json; charset=utf-8", **(headers or {})})
    try:
        with urllib.request.build_opener(_NoRedirect).open(req, timeout=15) as r: return r.status
    except urllib.error.HTTPError as e: raise RuntimeError(f"HTTP {e.code}") from None   # 주소·토큰이 들어갈 수 있는 원문은 버린다
    except Exception as e: raise RuntimeError(type(e).__name__) from None

class Ctx:
    def __init__(self, a, env, secret_out):
        self.user, self.email, self.pwfile, self.env, self.out = a.user, a.email, a.password_file, env, secret_out
        self.password = ""; self.link = None; self.link_err = ""; self.ok = {}; self.notes = []
    def secret(self, text): self.out.write(text + "\n"); self.out.flush()   # 비밀이 들어가는 줄(로그 밖으로)
    def mask(self, s):
        for x in (self.password, (self.link or "").rsplit("/", 1)[-1]):
            if x: s = s.replace(x, "***")
        return s

def ch_screen(c):
    c.secret(f"  초기 비밀번호: {c.password}")
    if c.link: c.secret(f"  1회 열람 링크: {c.link}")
    print(f"안내: 아래 정보를 회원에게 직접 전달하세요 — 온보딩 파일: {ONBOARD}/{c.user}  (README.md · pairing-url.txt · pairing.png)")
    return "화면에 표시"

def ch_smtp(c):
    if not EMAIL_RE.fullmatch(c.email or ""): raise RuntimeError("회원 이메일 형식이 올바르지 않습니다")
    link_only = c.env.get("MAIL_LINK_ONLY", "0") == "1"
    if link_only:
        if not c.link: raise RuntimeError("MAIL_LINK_ONLY=1 인데 링크가 없어 메일을 보내지 않았습니다(link 채널 확인)")
        cmd = None   # 링크는 명령줄에 싣지 않는다(ps·/proc/*/cmdline 노출) — 0600 임시 파일로 넘긴다
    else: cmd = [NOTIFY_MAIL, "send", "--user", c.user, "--email", c.email, "--password-file", c.pwfile]
    if not os.access(NOTIFY_MAIL, os.X_OK): raise RuntimeError(f"{os.path.basename(NOTIFY_MAIL)} 명령이 없습니다")
    lf = None
    try:
        if cmd is None:
            fd, lf = tempfile.mkstemp(prefix=".link-", dir=SECRETS)   # 0600
            with os.fdopen(fd, "w", encoding="utf-8") as fh: fh.write(c.link + "\n")
            cmd = [NOTIFY_MAIL, "send", "--user", c.user, "--email", c.email, "--link-file", lf]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    finally:
        if lf:
            try: os.unlink(lf)
            except OSError: pass
    if r.returncode: raise RuntimeError("SMTP 로 메일을 보내지 못했습니다: " + c.mask((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else "원인 불명"))
    return "메일에 비밀번호 대신 링크를 보냈습니다" if link_only else "안내 메일을 보냈습니다"

def ch_n8n(c):
    try: tok = open(N8N_TOKEN, encoding="utf-8").read().strip()
    except OSError: raise RuntimeError(f"n8n 웹훅 토큰이 없습니다({N8N_TOKEN}) — sudo @@PFX@@-n8n-workflows install member-onboarding")
    http_post(N8N_URL, {"username": c.user, "email": c.email, "bootstrap_password": c.password}, {"X-Onboarding-Token": tok})
    return "n8n 웹훅 호출"

def ch_link(c):
    if not c.link: raise RuntimeError(c.link_err or "링크를 만들지 못했습니다")
    c.secret(f"  1회 열람 링크: {c.link}")
    print(f"안내: 링크는 {c.env.get('ONBOARD_LINK_TTL_HOURS', '24') or '24'}시간 안에 한 번만 열립니다. 회원에게 전달하세요(열면 확인 화면 → «열기» 를 눌러야 비밀번호가 보입니다)")
    return "1회 열람 링크 발급"

def include_link(env): return env.get("ONBOARD_WEBHOOK_INCLUDE_LINK", "0") == "1"

def webhook_text(c):
    if getattr(c, "notice", None): return c.notice   # 관리자 알림(회원 삭제 수명주기): 호출자가 넘긴 문구만(비밀 없음)
    t = f"[{BRAND}] 회원 계정이 만들어졌습니다: {c.user}"
    if c.link and include_link(c.env): return t + f"\n1회 열람 링크(한 번만 열림): {c.link}"
    return t + "\n초기 비밀번호·접속 안내는 관리자에게 받으세요(이 알림에는 비밀이 없습니다)."

def ch_webhook(c):
    env = c.env; fmt = env.get("ONBOARD_WEBHOOK_FORMAT", "generic") or "generic"
    if fmt not in FORMATS: raise RuntimeError(f"ONBOARD_WEBHOOK_FORMAT 은 {' · '.join(FORMATS)} 중 하나입니다")
    text = webhook_text(c)
    try:
        if fmt == "telegram":
            kv = read_env(secret_path(env, "ONBOARD_WEBHOOK_TELEGRAM_FILE", "onboard-telegram.env"))
            if not kv.get("TELEGRAM_BOT_TOKEN") or not kv.get("TELEGRAM_CHAT_ID"): raise ValueError("텔레그램 파일에 TELEGRAM_BOT_TOKEN · TELEGRAM_CHAT_ID 가 필요합니다")
            base = env.get("ONBOARD_WEBHOOK_TELEGRAM_API", "https://api.telegram.org").rstrip("/"); check_url(base, env)
            url, body = f"{base}/bot{kv['TELEGRAM_BOT_TOKEN']}/sendMessage", {"chat_id": kv["TELEGRAM_CHAT_ID"], "text": text, "disable_web_page_preview": True}
        else:
            url = open(secret_path(env, "ONBOARD_WEBHOOK_URL_FILE", "onboard-webhook-url"), encoding="utf-8").read().strip().splitlines()[0]; check_url(url, env)
            body = {"slack": {"text": text}, "discord": {"content": text}}.get(fmt) or {
                "event": "member.notice" if getattr(c, "notice", None) else "member.created", "member": c.user, "brand": BRAND, "message": text, "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                **({"link_url": c.link} if c.link and include_link(env) else {})}
    except (ValueError, IndexError) as e: raise RuntimeError(str(e) or "webhook 주소 파일이 비어 있습니다") from None
    http_post(url, body)
    return f"webhook({fmt}) 전송 — 비밀번호는 싣지 않음" + ("·1회 열람 링크 포함(ONBOARD_WEBHOOK_INCLUDE_LINK=1)" if c.link and include_link(env) else "")

def ch_print(c):
    d = os.path.join(ONBOARD, c.user); check_dir(d)
    port = c.env.get("SSH_PORT", "22"); e = html.escape
    ssh = f"ssh {c.user}@@@SSH_HOST@@" + ("" if port == "22" else f" -p {port}")
    png = safe_read(d, "pairing.png"); url = (safe_read(d, "pairing-url.txt", 4096) or b"").decode("utf-8", "replace").strip().splitlines()
    qr = (f'<p>Paseo 앱에서 이 QR 을 스캔하세요.</p><img alt="Paseo QR" src="data:image/png;base64,{base64.b64encode(png).decode()}">' if png
          else (f"<p>Paseo 앱에 이 링크를 붙여 넣으세요.</p><p class=m>{e(url[0])}</p>" if url else ""))
    doc = f"""<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>{e(BRAND)} 개발환경 안내 — {e(c.user)}</title>
<style>@page{{size:A4;margin:18mm}}body{{font:14pt/1.6 sans-serif;max-width:170mm;margin:0 auto}}h1{{font-size:20pt}}.m{{font:14pt monospace;word-break:break-all}}
.pw{{font:20pt monospace;border:2px solid #000;padding:4mm;display:inline-block}}img{{width:55mm;height:55mm;image-rendering:pixelated}}.w{{border-top:1px solid #000;margin-top:8mm;padding-top:3mm;font-size:11pt}}</style></head><body>
<h1>{e(BRAND)} 개발환경 계정 안내</h1>
<p>회원 ID: <span class="m">{e(c.user)}</span></p>
<p>초기 비밀번호:<br><span class="pw">{e(c.password)}</span></p>
<p>첫 로그인 때 새 비밀번호로 바꿔야 합니다.</p>
<h2>접속 방법</h2>
<ul><li>터미널: <span class="m">{e(ssh)}</span></li><li>안내 페이지: <span class="m">https://@@PORTAL_HOST@@/guide/</span></li></ul>
{qr}
<p class="w">이 종이에는 비밀번호와 접속 정보가 있습니다. 전달한 뒤에는 파쇄하고, 다른 사람에게 보여 주지 마세요.</p>
</body></html>
"""
    p = os.path.join(d, "print.html")
    try: os.unlink(p)   # 이전 것(또는 심어 둔 링크)은 지우고 새로 만든다 — 링크를 따라가지 않는다
    except FileNotFoundError: pass
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        gid = personal_group_gid(c.env)   # 관리자의 «개인 그룹» 일 때만 그 그룹에 읽기를 연다. 아니면 root 전용 0600
        try:
            if gid: os.fchown(fh.fileno(), -1, gid); os.fchmod(fh.fileno(), 0o640)   # 소유자는 만든 사람(root) 그대로
            else: os.fchmod(fh.fileno(), 0o600)
        except PermissionError: pass
        fh.write(doc)
    print(f"안내: 출력용 안내문 {p} — " + ("브라우저로 열어 인쇄(관리자 계정이 읽을 수 있음)" if gid else "root 전용이라 sudo 로 열거나 복사해 인쇄") + f". 전달 뒤 sudo @@PFX@@-onboarding-seal {c.user} 로 지우세요")
    return "출력용 안내문 생성"

RUN = {"screen": ch_screen, "smtp": ch_smtp, "n8n": ch_n8n, "link": ch_link, "webhook": ch_webhook, "print": ch_print}

def schedule_seal(c, secs):
    # 옛 예약(재발급 전)이 새 링크를 일찍 끝내지 않게 먼저 멈추고, 고유 이름으로 새로 예약한다
    subprocess.run(["systemctl", "stop", f"@@PFX@@-onboarding-seal-{c.user}.timer", f"@@PFX@@-onboarding-seal-{c.user}-*.timer"], capture_output=True)
    r = subprocess.run(["systemd-run", "--quiet", f"--on-active={secs}s", f"--unit=@@PFX@@-onboarding-seal-{c.user}-{int(time.time())}", SEAL, c.user], capture_output=True, text=True)
    if r.returncode: print(f"경고: 페어링 파일 삭제 예약에 실패했습니다 — 수동: sudo {SEAL} {c.user}")
    else: print(f"안내: 페어링 파일·초기 비밀번호 파일은 {secs // 3600 if secs >= 3600 else secs // 60}{'시간' if secs >= 3600 else '분'} 뒤 자동 삭제됩니다(예약)")

def deliver(a):
    env = read_env(SITE); chans, bad = channel_list(env)
    try: out = os.fdopen(a.secret_fd, "w", encoding="utf-8", closefd=False) if a.secret_fd != 1 else sys.stdout
    except OSError:   # 비밀을 표준 출력(등록 로그로 갈 수 있음)으로 돌리지 않는다 — 실패한다
        print(f"실패: --secret-fd {a.secret_fd} 이(가) 열려 있지 않습니다 — 비밀(비밀번호·링크)을 안전하게 출력할 곳이 없어 전달을 중단합니다", file=sys.stderr); return 1
    c = Ctx(a, env, out)
    for b in bad: print(f"경고: 알 수 없는 전달 채널 '{b}' 는 건너뜁니다(사용 가능: {' '.join(CHANNELS)})")
    try: c.password = open(a.password_file, encoding="utf-8").read().rstrip("\r\n")
    except OSError: pass
    if not c.password: print("경고: 초기 비밀번호 파일을 읽을 수 없어 전달 채널을 실행하지 못했습니다"); return 1
    harden_files(os.path.join(ONBOARD, c.user), "n8n" in chans)
    if "link" in chans:   # 링크는 먼저 만든다 — smtp(MAIL_LINK_ONLY)·webhook 이 목록에서 앞에 있어도 같은 링크를 쓴다
        r = subprocess.run([MEMBER_LINK, "issue", c.user, "--machine"], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip().startswith("https://"): c.link = r.stdout.strip().splitlines()[0]
        else: c.link_err = "링크 발급 실패: " + ((r.stderr or "").strip().splitlines() or ["원인 불명"])[-1].removeprefix("실패: ")
    def run(ch):
        try: note = RUN[ch](c); c.ok[ch] = True; print(f"성공: 전달 채널 {ch} — {note}")
        except Exception as e: c.ok[ch] = False; print(f"경고: 전달 채널 {ch} 실패 — {c.mask(str(e) or type(e).__name__)}")
    for ch in chans:
        if ch != "screen": run(ch)
    if not any(c.ok.get(x) for x in SECRET_CHANNELS if x != "screen"):   # 마지막 보루
        if len(chans) > 1 or chans[:1] != ["screen"]: print("안내: 비밀을 전달한 채널이 없어 화면 표시(screen)로 대신합니다")
        run("screen")
    # 뒷정리: 어떤 채널이 파일을 계속 써야 하는지에 따라 봉인 예약·비밀번호 파일 삭제를 정한다
    hand = c.ok.get("screen") or c.ok.get("print")
    if hand: print(f"안내: 전달을 마친 뒤 sudo {SEAL} {c.user} 로 파일을 정리하세요(초기 비밀번호 파일은 재부팅하면 사라집니다)")
    elif c.ok.get("link"):
        h = int(env.get("ONBOARD_LINK_TTL_HOURS", "24") or "24"); schedule_seal(c, h * 3600 + 60)
    elif c.ok.get("smtp") or c.ok.get("n8n"):
        try: os.unlink(a.password_file)
        except OSError: pass
        schedule_seal(c, 900)
    return 0

def check(env):
    chans, bad = channel_list(env); n = 0
    def say(ok, t):
        nonlocal n; n += (not ok); print(("성공: " if ok else "실패: ") + t)
    print("전달 채널: " + " ".join(chans) + ("" if env.get("ONBOARD_CHANNELS") else "  (ONBOARD_CHANNELS 없음 — MAIL_MODE=%s 에서 유도)" % (env.get("MAIL_MODE") or "none")))
    for b in bad: say(False, f"알 수 없는 채널 '{b}'")
    if "webhook" in chans:
        fmt = env.get("ONBOARD_WEBHOOK_FORMAT", "generic") or "generic"
        if fmt not in FORMATS: say(False, f"ONBOARD_WEBHOOK_FORMAT={fmt}")
        else:
            try:
                if fmt == "telegram":
                    kv = read_env(secret_path(env, "ONBOARD_WEBHOOK_TELEGRAM_FILE", "onboard-telegram.env"))
                    if not (kv.get("TELEGRAM_BOT_TOKEN") and kv.get("TELEGRAM_CHAT_ID")): raise ValueError("텔레그램 파일에 TELEGRAM_BOT_TOKEN · TELEGRAM_CHAT_ID 가 필요합니다")
                else: check_url(open(secret_path(env, "ONBOARD_WEBHOOK_URL_FILE", "onboard-webhook-url"), encoding="utf-8").read().strip().splitlines()[0], env)
                say(True, f"webhook({fmt}) 주소 형식·비밀 파일 권한")
            except (ValueError, IndexError) as e: say(False, "webhook: " + (str(e) or "주소 파일이 비어 있음"))
    if "link" in chans:
        r = subprocess.run([MEMBER_LINK, "--check"], capture_output=True, text=True)
        for l in r.stdout.strip().splitlines(): say(l.startswith("성공"), "link: " + l.split(": ", 1)[-1])
        if r.returncode and not r.stdout.strip(): say(False, "link: 점검을 실행하지 못했습니다")
    if "print" in chans: say(os.path.isdir(ONBOARD), f"print: 온보딩 폴더 {ONBOARD}")
    if "webhook" in chans and include_link(env): print("경고: webhook 에 1회 열람 링크를 싣습니다(ONBOARD_WEBHOOK_INCLUDE_LINK=1) — 채널 구성원 전원이 링크를 열 수 있습니다")
    if include_link(env) and "link" not in chans: say(False, "ONBOARD_WEBHOOK_INCLUDE_LINK=1 인데 link 채널이 꺼져 있습니다")
    if "smtp" in chans and env.get("MAIL_LINK_ONLY") == "1" and "link" not in chans: say(False, "MAIL_LINK_ONLY=1 인데 link 채널이 꺼져 있습니다(메일이 가지 않고 화면 표시로 대신됨)")
    return 1 if n else 0

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("action", nargs="?", choices=["deliver", "notice"]); ap.add_argument("--user"); ap.add_argument("--email", default=""); ap.add_argument("--password-file")
    ap.add_argument("--secret-fd", type=int, default=1); ap.add_argument("--check", action="store_true"); ap.add_argument("--test-webhook", action="store_true")
    a = ap.parse_args()
    if os.geteuid() != 0: print("실패: root 로 실행하세요(sudo)", file=sys.stderr); sys.exit(1)
    env = read_env(SITE)
    if a.check: sys.exit(check(env))
    if a.test_webhook:
        c = Ctx(argparse.Namespace(user="test-member", email="", password_file=""), env, sys.stdout)
        if include_link(env): print("경고: ONBOARD_WEBHOOK_INCLUDE_LINK=1 — 이 채널의 모든 구성원이 1회 열람 링크(= 초기 비밀번호와 같은 가치의 자격증명)를 볼 수 있습니다")
        try: print("성공: " + ch_webhook(c))
        except Exception as e: print("실패: " + str(e), file=sys.stderr); sys.exit(1)
        return
    if a.action == "notice":   # webhook 채널이 설정돼 있을 때만 보낸다(본문은 표준입력 2000자까지, 비밀 없음). 종료 코드 3 = webhook 채널 없음
        if "webhook" not in channel_list(env)[0]: print("webhook 채널이 설정되어 있지 않습니다", file=sys.stderr); sys.exit(3)
        text = sys.stdin.read(2001)
        if not text.strip() or len(text) > 2000: print("실패: 본문(표준입력)이 비었거나 2000자를 넘습니다", file=sys.stderr); sys.exit(1)
        c = Ctx(argparse.Namespace(user="", email="", password_file=""), env, sys.stdout); c.notice = text.strip()
        try: print("성공: " + ch_webhook(c))
        except Exception as e: print("실패: " + str(e), file=sys.stderr); sys.exit(1)
        return
    if a.action != "deliver": ap.error("deliver 또는 --check · --test-webhook 중 하나가 필요합니다")
    if not (a.user and a.password_file): ap.error("deliver 에는 --user --password-file 이 필요합니다")
    if not USER_RE.fullmatch(a.user): print("실패: 회원 ID 형식이 올바르지 않습니다", file=sys.stderr); sys.exit(1)
    if a.email and not EMAIL_RE.fullmatch(a.email): print("실패: 회원 이메일 형식이 올바르지 않습니다", file=sys.stderr); sys.exit(1)
    sys.exit(deliver(a))

if __name__ == "__main__":
    main()
