#!/usr/bin/env bash
# 멤버 사이트·공용 정적 공개 Caddy 설정 관리 (root). v3 최종본(P4) — @@PFX@@-site-switch · enable-shared.sh · @@PFX@@-site-shared-caddy 를 흡수했다.
#   @@PFX@@-site-caddy add <멤버>        <멤버>.@@DOMAIN@@ 블록 생성(→ 멤버 샌드박스 127.0.0.1:<state.json 의 포트>, 허용 IP 만). 포트가 없으면 @@PFX@@-site-sync 로 할당받는다
#   @@PFX@@-site-caddy remove <멤버>     블록 삭제(유닛 정지·포트 반환은 @@PFX@@-site-sync 가 한다 — 끝에 한 번 호출)
#   @@PFX@@-site-caddy shared on|off     공용 정적(@@PORTAL_HOST@@/<프로젝트>/) 켜기·끄기. on = ai 블록에 import 삽입 + 플래그, off = 플래그 삭제 + @@PFX@@-site-sync 호출
#   @@PFX@@-site-caddy shared-matchers   (내부용, @@PFX@@-site-sync 가 호출) 표준입력의 공용 프로젝트 이름 목록으로 @@PFX@@-shared.caddy 생성
#   @@PFX@@-site-caddy status            멤버별 블록 포트·state.json 일치 여부, 공용 on/off (읽기 전용)
# 환경: CADDY_DIR(기본 /etc/caddy) · DRY=1(검증만, reload·락·실제 @@PFX@@-site-sync·운영 플래그 없음) · AI_SITE_STATE(state.json) · AI_SITE_SYNC(동기화 명령)
#       · AI_SITE_SHARED_FLAG(공용 플래그, DRY 기본 $CADDY_DIR/site-v3.shared) · AI_SITE_SHARED_PORT(기본 18199) · AI_PASEO_LOCK
# 스스로 공용 락(/run/@@PFX@@-paseo-caddy.lock)을 잡으므로 flock 으로 감싸지 말 것. @@PFX@@-site-sync 는 락을 푼 뒤에 부른다(sync 가 shared-matchers 로 같은 락을 잡는다).
set -euo pipefail
CADDY_DIR=${CADDY_DIR:-/etc/caddy}; DOMAIN=@@DOMAIN@@; DRY=${DRY:-0}
STATE=${AI_SITE_STATE:-/var/lib/@@PFX@@/site-v3/state.json}; SPORT=${AI_SITE_SHARED_PORT:-18199}
if ((DRY)); then FLAG=${AI_SITE_SHARED_FLAG:-$CADDY_DIR/site-v3.shared}; else FLAG=${AI_SITE_SHARED_FLAG:-/etc/@@PFX@@/site-v3.shared}; fi
F=$CADDY_DIR/Caddyfile; SD=$CADDY_DIR/sites.d; SF=$CADDY_DIR/@@PFX@@-shared.caddy
act=${1:-}; m=${2:-}; sub=${2:-}
usage(){ sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
NAME_RE='^[a-z][a-z0-9-]{1,30}$'

lock(){ ((DRY)) || { exec 9>"${AI_PASEO_LOCK:-/run/@@PFX@@-paseo-caddy.lock}"; flock 9; }; }   # @@PFX@@-paseo-caddy · @@PFX@@-kr-guard 와 같은 락
unlock(){ exec 9>&-; }
# 상태 파일에서 멤버 포트(없으면 빈 값)
port_of(){ python3 -I -c "import json,sys; print(json.load(open(sys.argv[1])).get('ports',{}).get(sys.argv[2],''))" "$STATE" "$1" 2>/dev/null || true; }
run_sync(){   # DRY 에서는 AI_SITE_SYNC 를 명시했을 때만 부른다(운영 sync 를 건드리지 않게)
  ((!DRY)) || [[ -n ${AI_SITE_SYNC:-} ]] || return 0
  local c; read -ra c <<< "${AI_SITE_SYNC:-/usr/local/sbin/@@PFX@@-site-sync}"
  "${c[@]}" >/dev/null || echo "경고: @@PFX@@-site-sync 실패(다음 주기에 다시 처리됨)" >&2
}
validate(){   # 전체 Caddyfile 검증. DRY 는 로그 경로만 바꾼 복사본으로(@@ADMIN_USER@@ 은 운영 로그 파일을 못 연다)
  local V=$F out
  if ((DRY)); then V=$F.dryvalid; sed "s#/var/log/caddy/#$CADDY_DIR/#g" "$F" > "$V"; fi
  out=$(XDG_DATA_HOME=${TMPDIR:-/tmp}/@@PFX@@-site-caddy-xdg caddy validate --config "$V" --adapter caddyfile 2>&1) || { ((DRY)) && rm -f "$V"; echo "$out" | grep -iE "error|invalid" | head -5 >&2; return 1; }
  ((DRY)) && rm -f "$V"; return 0
}
backup(){   # Caddyfile 백업(최근 20개만 보관)
  B=$F.bak.pre-site-caddy-$(date +%Y%m%d-%H%M%S); cp -p "$F" "$B"
  ls -t "$F".bak.pre-site-caddy-* 2>/dev/null | tail -n +21 | xargs -r rm -f || true
}

# 공용 import 삽입(insert-ai-import.py 와 같은 로직): @@PORTAL_HOST@@ 블록의 포털 handle 바로 앞. 이미 있으면 변경 없음(멱등)
PY_INSERT=$(cat <<'PYEOF'
import re, sys
p, shared = sys.argv[1], sys.argv[2]
with open(p, encoding='utf-8', newline='') as f:
    text = f.read()
eol = '\r\n' if '\r\n' in text else '\n'
lines = text.split(eol)
if any(re.match(r'^[ \t]*import[ \t]+' + re.escape(shared) + r'[ \t]*$', l) for l in lines):
    print('이미 있음'); sys.exit(0)
start = next((i for i, l in enumerate(lines) if re.match(r'^' + re.escape('@@PORTAL_HOST@@') + r'[ \t]*\{[ \t]*$', l)), None)
if start is None:
    sys.exit('@@PORTAL_HOST@@ 블록을 찾지 못함')
depth, end = 0, None
for i in range(start, len(lines)):
    code = lines[i].split('#', 1)[0]
    depth += code.count('{') - code.count('}')
    if depth == 0:
        end = i; break
if end is None:
    sys.exit('@@PORTAL_HOST@@ 블록의 끝을 찾지 못함')
for i in range(start + 1, end):
    mm = re.match(r'^([ \t]*)handle[ \t]*\{[ \t]*$', lines[i])
    if mm and any('/srv/@@PFX@@/public/portal' in x for x in lines[i + 1:i + 8]):
        ind = mm.group(1)
        lines[i:i] = [f'{ind}# 공용 정적 프로젝트(@@PFX@@-site-caddy shared-matchers 가 만든다) — 포털보다 먼저 맞춘다', f'{ind}import {shared}', '']
        with open(p, 'w', encoding='utf-8', newline='') as f:
            f.write(eol.join(lines))
        print('삽입함'); sys.exit(0)
sys.exit('ai 블록 안에서 포털 handle 을 찾지 못함')
PYEOF
)

case $act in
add|remove)
  [[ $m =~ $NAME_RE ]] || { echo "사용: $0 add|remove <멤버>  (멤버: 소문자·숫자·하이픈, 2~31자)" >&2; exit 2; }
  MF=$SD/$m.caddy
  if [[ $act == add ]]; then
    # 기존 사이트 주소의 첫 라벨과 흔한 서비스 이름은 멤버 ID 로 쓸 수 없다(같은 이름이면 기존 사이트를 가리거나 헷갈린다)
    taken=$(grep -E '^[^[:space:]#].*\{[[:space:]]*$' "$F" | grep -oE "[a-z0-9-]+\.${DOMAIN//./\\.}" | sed "s/\.${DOMAIN//./\\.}\$//" | sort -u | tr '\n' ' ')
    for r in $taken www mail smtp imap pop ftp sftp ns ns1 ns2 admin root paseo ops portal static assets api app test; do
      [[ $m == "$r" ]] && { echo "예약된 이름이라 멤버 ID 로 공개 주소를 만들 수 없음: $m" >&2; exit 3; }
    done
    # 포트는 락 밖에서 정한다(sync 가 락을 잡을 수 있다). 없으면 sync 를 한 번 불러 할당받는다
    port=$(port_of "$m"); [[ -n $port ]] || { AI_SITE_ALSO=$m run_sync; port=$(port_of "$m"); }   # 블록이 아직 없는 신규 멤버도 이번 회차에 포트를 받게 이름을 넘긴다
    [[ $port =~ ^[0-9]+$ ]] || { echo "멤버 포트를 알 수 없음($STATE 의 ports[$m]) — @@PFX@@-site-sync 로 할당되지 않았다" >&2; exit 4; }
  else
    [[ -f $MF ]] || { echo "멤버 블록이 없음: $MF" >&2; exit 3; }
  fi
  lock
  mkdir -p "$SD"; backup
  had=0; [[ -f $MF ]] && { had=1; cp -p "$MF" "$MF.prev"; }
  undo(){ cp -p "$B" "$F"; if ((had)); then mv -f "$MF.prev" "$MF"; else rm -f "$MF"; fi; echo "실패 — 원복함(백업: $B)" >&2; exit 1; }
  trap 'undo' ERR
  if [[ $act == add ]]; then
    grep -qF "$CADDY_DIR/geo-allow.caddy" "$F" || { echo "Caddyfile 에 geo-allow.caddy import 가 없음(geo_allow 스니펫 필요)" >&2; false; }
    printf '%s\n' "# @@PFX@@-site-caddy: $m (자동 생성 — 직접 수정하지 말 것)" "$m.$DOMAIN {" "	import access_log" "	import geo_allow" "	handle @allowed {" \
      "		reverse_proxy 127.0.0.1:$port" "	}" "	respond 403" "}" > "$MF.new"
    mv -f "$MF.new" "$MF"; chmod 644 "$MF"
  else
    rm -f "$MF"
  fi
  grep -qF "$SD/*.caddy" "$F" || printf '%s\n' "" "# 멤버 사이트 공개(@@PFX@@-site-caddy) — <멤버>.$DOMAIN, 허용 IP 만 허용, 멤버 샌드박스로 프록시" "import $SD/*.caddy" >> "$F"
  validate
  ((DRY)) || systemctl reload caddy
  trap - ERR; rm -f "$MF.prev"
  unlock
  [[ $act == remove ]] && run_sync   # 유닛 정지·포트 반환은 sync 가 처리한다
  if ((DRY)); then echo "DRY: 검증 통과, reload 안 함($act $m, $MF)"; else echo "$act $m 완료 — $m.$DOMAIN (백업: $B)"; fi;;

shared)
  case $sub in
  on)
    lock; backup
    made=0; [[ -f $SF ]] || { echo '# @@PFX@@-site-caddy shared-matchers (자동 생성 — 직접 수정하지 말 것)' > "$SF"; chmod 644 "$SF"; made=1; }   # import 대상이 없으면 reload 가 실패한다
    undo(){ cp -p "$B" "$F"; ((made)) && rm -f "$SF"; echo "실패 — Caddyfile 원복(백업: $B)" >&2; exit 1; }
    trap 'undo' ERR
    python3 -I -c "$PY_INSERT" "$F" "$SF"
    validate
    ((DRY)) || systemctl reload caddy
    trap - ERR
    mkdir -p "$(dirname "$FLAG")"; : > "$FLAG"; chmod 644 "$FLAG"
    unlock; run_sync
    echo "공용 정적 켬(플래그 $FLAG)$( ((DRY)) && echo ' — DRY: reload 안 함')";;
  off)
    rm -f "$FLAG"; run_sync   # 샌드박스·매처 정리는 sync 가 한다(ai 블록의 빈 import 는 무해하므로 남긴다)
    echo "공용 정적 끔(플래그 삭제, 정리는 @@PFX@@-site-sync 가 한다)";;
  *) usage;;
  esac;;

shared-matchers)
  # @@PFX@@-site-shared-caddy 와 같은 규칙: 이름 ^[a-z][a-z0-9-]{1,30}$ · 최대 10개 · 매처 이름의 하이픈은 밑줄 · 포트 18199 · 실패 시 원복
  names=()
  while IFS= read -r n; do
    [[ -z $n ]] && continue
    [[ $n =~ $NAME_RE ]] || { echo "이름 규칙 위반: $n" >&2; exit 2; }
    names+=("$n")
  done
  ((${#names[@]} <= 10)) || { echo "공용 프로젝트는 최대 10개: ${#names[@]}" >&2; exit 2; }
  # 주석 처리된 행이나 부분 일치는 인정하지 않는다(행 전체가 «import <파일>» 이어야 한다)
  awk -v s="import $SF" '{ sub(/\r$/, ""); gsub(/^[ \t]+|[ \t]+$/, ""); if ($0 == s) f = 1 } END { exit !f }' "$F" || { echo "Caddyfile 의 ai 블록에 'import $SF' 가 없다(@@PFX@@-site-caddy shared on 이 넣는다)" >&2; exit 3; }
  lock
  had=0; [[ -f $SF ]] && { had=1; cp -p "$SF" "$SF.prev"; }
  undo(){ if ((had)); then mv -f "$SF.prev" "$SF"; else rm -f "$SF"; fi; echo "실패 — 원복함" >&2; exit 1; }
  trap 'undo' ERR
  {
    echo "# @@PFX@@-site-caddy shared-matchers (자동 생성 — 직접 수정하지 말 것)"
    for n in "${names[@]}"; do
      printf '@shared_%s path /%s /%s/*\nhandle @shared_%s {\n\treverse_proxy 127.0.0.1:%s\n}\n' "${n//-/_}" "$n" "$n" "${n//-/_}" "$SPORT"
    done
  } > "$SF.new"
  mv -f "$SF.new" "$SF"; chmod 644 "$SF"
  validate
  if ((DRY)); then trap - ERR; rm -f "$SF.prev"; echo "DRY: 검증 통과(${#names[@]}개), reload 안 함"; exit 0; fi
  systemctl reload caddy
  trap - ERR; rm -f "$SF.prev"
  echo "공용 정적 ${#names[@]}개 반영: ${names[*]:-없음}";;

status)
  for f in "$SD"/*.caddy; do
    [[ -e $f ]] || continue; mm=$(basename "$f" .caddy)
    bp=$(grep -oE 'reverse_proxy 127\.0\.0\.1:[0-9]+' "$f" | head -1 | grep -oE '[0-9]+$' || true); sp=$(port_of "$mm")
    if [[ -z $sp ]]; then s="state 에 포트 없음"; elif [[ $bp == "$sp" ]]; then s="일치"; else s="불일치(state 포트 $sp)"; fi
    echo "$mm  블록 포트 ${bp:-없음}  $s"
  done
  echo "공용: $([[ -f $FLAG ]] && echo on || echo off)  (ai 블록 import: $(awk -v s="import $SF" '{ sub(/\r$/, ""); gsub(/^[ \t]+|[ \t]+$/, ""); if ($0 == s) f = 1 } END { exit !f }' "$F" 2>/dev/null && echo 있음 || echo 없음))";;

*) usage;;
esac
