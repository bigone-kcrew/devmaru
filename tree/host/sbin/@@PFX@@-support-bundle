#!/usr/bin/env bash
# @@PFX@@-support-bundle — 문제 진단용 묶음(tar.gz, 권한 0600)을 만든다. 읽기 전용(서비스·설정·회원 데이터를 바꾸지 않는다).
#   sudo @@PFX@@-support-bundle [--out <폴더>] [--lines N]     (기본 폴더 /root · 로그 꼬리 N=200)
#   sudo @@PFX@@-support-bundle --selftest                     마스킹 자체 시험만 한다(가짜 토큰이 지워지는지)
# 포함: doctor --json · site.env · 모듈 · 설치 로그 꼬리 · state.json · docker ps/이미지 태그 · 디스크·메모리 · OS·커널 · 킷 버전 · 서비스 컨테이너 로그 꼬리
# 제외: *.env · secrets · 토큰 · 페어링 링크 · 회원 대화 · workspace · DB 내용 · 회원 개발환경(dev-*) 컨테이너 로그
# 모든 텍스트는 비밀 패턴 마스킹을 거치고, 묶기 전에 토큰 패턴이 0건인지 다시 검사한다(남아 있으면 묶지 않는다).
set -uo pipefail
umask 077
PFX=@@PFX@@; SITE=/etc/$PFX/site.env; OUT=/root; N=200; ST=0
while [ $# -gt 0 ]; do case "$1" in
  --out) OUT=${2:-}; shift;; --lines) N=${2:-}; shift;; --selftest) ST=1;;
  *) echo "실패: 알 수 없는 인자: $1" >&2; exit 2;; esac; shift; done
[[ "$N" =~ ^[0-9]+$ ]] || { echo "실패: --lines 는 정수" >&2; exit 2; }

# ── 마스킹: 값만 지우고 구조(키 이름)는 남긴다 ──
HIGH='-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{24,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{30,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{5,}|[0-9a-fA-F]{40,}|(offer|pairing)[=#][A-Za-z0-9_%.~+/=-]{16,}|[a-z]+://[^/[:space:]:@]+:[^/[:space:]@]+@'
mask(){ sed -E \
  -e 's/-----BEGIN [A-Z ]*PRIVATE KEY-----.*/[MASKED:private-key]/' \
  -e 's#([a-z]+://)[^/[:space:]:@]+:[^/[:space:]@]+@#\1[MASKED]@#g' \
  -e 's/gh[pousr]_[A-Za-z0-9]{30,}/[MASKED:token]/g; s/github_pat_[A-Za-z0-9_]{30,}/[MASKED:token]/g' \
  -e 's/(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{24,}/\1[MASKED:token]/g; s/xox[baprs]-[A-Za-z0-9-]{10,}/[MASKED:token]/g' \
  -e 's/AIza[0-9A-Za-z_-]{30,}/[MASKED:token]/g; s/AKIA[0-9A-Z]{16}/[MASKED:token]/g' \
  -e 's/eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{5,}/[MASKED:jwt]/g' \
  -e 's/(offer|pairing)([=#])[A-Za-z0-9_%.~+\/=-]{16,}/\1\2[MASKED:link]/g' \
  -e 's/[0-9a-fA-F]{40,}/[MASKED:hex]/g' \
  -e 's/([Bb]earer|[Bb]asic)[[:space:]]+[A-Za-z0-9._~+\/=-]{8,}/\1 [MASKED]/g' \
  -e 's/([A-Za-z0-9_.-]*(PASS|PASSWORD|PASSWD|SECRET|TOKEN|KEY|CREDENTIAL|AUTH)[A-Za-z0-9_.-]*[[:space:]]*[=:][[:space:]]*)("[^"]*"|'"'"'[^'"'"']*'"'"'|[^[:space:],;"]+)/\1[MASKED]/Ig' \
  -e 's/[A-Za-z0-9._%+-]+@([A-Za-z0-9.-]+\.[A-Za-z]{2,})/[MASKED:email]@\1/g'; }

selftest(){ local t r; t=$(mktemp); r=0
  { printf 'gh%s_%s\n' p "$(printf 'a%.0s' $(seq 36))"; printf 'sk-%s\n' "$(printf 'b%.0s' $(seq 30))"
    printf 'AKIA%s\n' "$(printf 'C%.0s' $(seq 16))"; printf 'eyJ%s.%s.%s\n' "$(printf 'd%.0s' $(seq 12))" "$(printf 'e%.0s' $(seq 12))" "$(printf 'f%.0s' $(seq 8))"
    echo 'POSTGRES_PASSWORD=hunter2-fake'; echo 'api_key: "fake-value-123"'; echo 'Authorization: Bearer abcdef1234567890xyz'
    echo 'url=postgres://user:fakepw@db:5432/x'; echo "link=https://app.example/#offer=$(printf 'g%.0s' $(seq 30))"
    echo "sha $(printf 'a1%.0s' $(seq 32))"; } > "$t"
  mask < "$t" > "$t.m"
  grep -qE -e "$HIGH" "$t.m" && { echo "실패: 마스킹 후에도 토큰 패턴이 남음"; r=1; }
  grep -qE 'hunter2-fake|fake-value-123|fakepw|abcdef1234567890xyz' "$t.m" && { echo "실패: 마스킹 후에도 가짜 비밀 값이 남음"; r=1; }
  grep -qE -e "$HIGH" "$t" || { echo "실패: 검사기 자체 시험(원본에서 패턴을 못 찾음)"; r=1; }
  rm -f "$t" "$t.m"; [ "$r" = 0 ] && echo "성공: 마스킹 자체 시험 통과(가짜 토큰·비밀번호·링크 모두 마스킹)"; return $r; }

selftest || exit 1
[ "$ST" = 1 ] && exit 0
[ "$(id -u)" = 0 ] || { echo "실패: root 로 실행해야 합니다 (sudo $PFX-support-bundle)" >&2; exit 1; }
[ -d "$OUT" ] || { echo "실패: 출력 폴더 없음: $OUT" >&2; exit 1; }

W=$(mktemp -d); trap 'rm -rf "$W"' EXIT; D=$W/$PFX-support; mkdir -p "$D"
put(){ local f=$1; shift; { "$@" 2>&1 || true; } | mask > "$D/$f"; }       # put <파일> <명령...>
putf(){ local f=$1 src=$2; [ -r "$src" ] && mask < "$src" > "$D/$f" || echo "(없음: $src)" > "$D/$f"; }
tailf(){ local f=$1 src=$2; [ -r "$src" ] && tail -n "$N" "$src" | mask > "$D/$f" || echo "(없음: $src)" > "$D/$f"; }

{ echo "생성: $(date '+%F %T %z')"; echo "접두어: $PFX"; echo "킷 버전: $(cat /opt/devmaru-kit/VERSION 2>/dev/null || echo 알 수 없음)"
  echo "호스트: $(hostname)"; } > "$D/00-summary.txt"
put 10-os.txt bash -c 'cat /etc/os-release; echo; uname -a; echo; uptime; echo; nproc'
put 11-memory-disk.txt bash -c 'free -h; echo; df -hT / /srv /var/lib 2>/dev/null; echo; docker system df'
put 20-doctor.json "/usr/local/sbin/$PFX-doctor" --json
putf 30-site.env "$SITE"
sed -n 's/^MODULES=//p' "$SITE" 2>/dev/null | tr -d "\"'" | tail -1 > "$D/31-modules.txt"
tailf 40-install.log.tail "/var/log/$PFX-install.log"
putf 41-state.json "/var/lib/$PFX/install/state.json"
tailf 42-golden-build.log.tail "/var/log/$PFX-golden-build.log"
put 50-docker-ps.txt docker ps -a --format '{{.Names}}\t{{.Image}}\t{{.Status}}'
put 51-docker-images.txt docker images --format '{{.Repository}}:{{.Tag}}\t{{.Size}}\t{{.CreatedSince}}'
put 52-docker-health.txt bash -c 'for c in $(docker ps -a --format "{{.Names}}"); do printf "%s\t" "$c"; docker inspect -f "{{.State.Status}} health={{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}} restarts={{.RestartCount}} oom={{.State.OOMKilled}}" "$c"; done'
mkdir -p "$D/logs"
for c in $(docker ps -a --format '{{.Names}}' 2>/dev/null); do
  case "$c" in dev-*) continue;; esac                                   # 회원 개발환경 로그는 대화 내용이 섞일 수 있어 제외
  docker logs --tail "$N" "$c" 2>&1 | mask > "$D/logs/$c.log.tail"
done
put 60-caddy.txt bash -c 'systemctl is-active caddy; journalctl -u caddy -n 50 --no-pager'

# ── 자체 검사: 토큰 패턴이 남았으면 묶지 않는다 ──
if grep -rIlE -e "$HIGH" "$D" >/dev/null 2>&1; then
  echo "실패: 마스킹 뒤에도 비밀 패턴이 남은 파일이 있어 묶지 않았습니다:" >&2; grep -rIlE -e "$HIGH" "$D" | sed "s#$D/##" >&2; exit 1
fi
echo "성공: 자체 검사 — 토큰 패턴 0건"
F="$OUT/$PFX-support-$(hostname)-$(date +%Y%m%d-%H%M%S).tar.gz"
tar -C "$W" -czf "$F" "$PFX-support" && chmod 600 "$F" || { echo "실패: 묶기 실패" >&2; exit 1; }
echo "성공: $F ($(du -h "$F" | cut -f1), 권한 600)"
echo "※ 이슈에 첨부하기 전에 직접 열어 확인하세요: tar -tzf $F  /  tar -xzOf $F $PFX-support/30-site.env | less"
echo "  (마스킹은 알려진 패턴만 지웁니다. 도메인·회원 ID·컨테이너 이름은 그대로 들어 있습니다.)"
