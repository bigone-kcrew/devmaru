#!/usr/bin/env bash
# @@PFX@@-golden-progress <버전> — @@PFX@@-golden-rc 진행 표시(읽기 전용: 로그·ps 만 읽고, 아무것도 쓰지 않고, 어떤 프로세스에도 신호를 보내지 않는다)
# 환경 변수(시험용): PROGRESS_LOG(로그 경로) PROGRESS_PS(ps 출력 파일) PROGRESS_NOW·PROGRESS_START(epoch 초)
# 종료: 0 정상 표시 · 1 로그 없음 · 2 사용법 · 3 빌드 실패 표시
set -uo pipefail
ver=${1:-}; [[ $ver =~ ^[0-9][0-9.]*$ ]] || { echo "사용: @@PFX@@-golden-progress <버전>  예) @@PFX@@-golden-progress 0.5.4" >&2; exit 2; }
log=${PROGRESS_LOG:-/tmp/build-$ver-rc1.log}
rel=/opt/@@PFX@@/images/dev/releases
now=${PROGRESS_NOW:-$(date +%s)}
fmt(){ local s=$1; printf '%d분 %02d초' $((s/60)) $((s%60)); }
[[ -f $log ]] || { echo "로그 없음: $log — RC 가 아직 시작되지 않았거나 버전이 다르다"; exit 1; }
mtime=$(stat -c %Y "$log"); start=${PROGRESS_START:-$(stat -c %W "$log")}
[[ $start =~ ^[0-9]+$ && $start -gt 0 ]] || start=
ps_out=$(if [[ -n ${PROGRESS_PS:-} ]]; then cat "$PROGRESS_PS"; else ps -eo args; fi)
# ps 줄은 «실행 경로로 시작하는 줄» 만 본다(ssh·셸 래퍼의 명령행에 같은 글자가 있어도 안 걸린다)
run(){ grep -qE "^([^ ]*/)?((python3?|bash|sh) )?$1( |\$)" <<<"$ps_out"; }
rc_up=0; run '[^ ]*/@@PFX@@-golden-rc' && rc_up=1

# 빌드: 마지막 단계(stage-X, X 가 가장 큰 것)의 «N/M» — M 은 로그가 말해 주는 값, 끝난 단계 수 = DONE/CACHED 가 찍힌 단계 수
read -r N M < <(awk '
  match($0, /^#[0-9]+ \[stage-[0-9]+ +[0-9]+\/[0-9]+\]/) {
    id=$1; s=$2; sub(/\[stage-/,"",s); x=s+0; t=$3" "$4; m=$0; sub(/.*\[stage-[0-9]+ +/,"",m); sub(/\].*/,"",m); split(m,a,"/")
    if (x>=bx) { bx=x; M=a[2]; ids[id]=x; seen[id]=1 }
  }
  /^#[0-9]+ (DONE|CACHED)/ { fin[$1]=1 }
  END { n=0; for (i in ids) if (ids[i]==bx && (i in fin)) n++; print n+1, M+0 }' "$log")
fail=$(grep -m1 -E '^(#[0-9]+ )?ERROR(:| )' "$log" | cut -c1-160)
exp_id=$(grep -m1 -E '^#[0-9]+ exporting to image' "$log" | cut -d' ' -f1)
built=0; [[ -n $exp_id ]] && grep -qE "^$exp_id DONE" "$log" && built=1

p1="1/4 빌드"; p2="2/4 selftest"; p3="3/4 canary"; p4="4/4 회차검증"
cur=0; note=""
if [[ ! -s $log ]]; then note="빌드 시작 대기(로그가 비어 있다)"; cur=1
elif [[ -n $fail ]]; then note="빌드 실패: $fail"; cur=1
elif [[ $built = 0 ]]; then
  cur=1; p1="1/4 빌드(${N}/${M:-?})"
  if [[ $rc_up = 0 ]]; then note="@@PFX@@-golden-rc 프로세스가 없고 로그가 $(fmt $((now-mtime))) 전에 멈췄다 — 중단된 것으로 보인다(터미널 출력 확인)"; fi
else
  p1="1/4 빌드(${N}/${M}) 완료"
  if run '[^ ]*/@@PFX@@-golden-selftest'; then cur=2
  elif run '[^ ]*/@@PFX@@-golden-canary'; then cur=3
  elif run "$rel/$ver\\.checks"; then cur=4
  elif [[ $rc_up = 1 ]]; then cur=1; note="빌드 뒤 단계 사이(레이어 압축 해제 대기 등)"
  else cur=0; note="@@PFX@@-golden-rc 가 끝났다 — selftest·canary·회차검증의 성공/실패는 로그에 없으니 터미널 출력으로 확인"; fi
fi
out=""; i=0
for p in "$p1" "$p2" "$p3" "$p4"; do i=$((i+1)); [[ $i = $cur ]] && p="[$p]"; out+="${out:+ → }$p"; done
echo "@@PFX@@-golden-progress $ver  (로그 $log)"
echo "$out"
if [[ -z $start ]]; then el="경과 확인 못 함(로그 생성 시각 없음)"
elif [[ $rc_up = 1 ]]; then el="경과 $(fmt $((now-start)))"
else el="빌드 로그 기준 $(fmt $((mtime-start)))"; fi
echo "$el"
[[ -n $note ]] && echo "$note"
[[ -n $fail ]] && exit 3
exit 0
