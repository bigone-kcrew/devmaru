#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="/opt/@@PFX@@/scripts"
LOG_BASE="/srv/@@PFX@@/logs/member-add"
MEMBER_META_BASE="/opt/@@PFX@@/config/members"

if [[ $EUID -ne 0 ]]; then
  echo "ERROR: run as root: sudo @@PFX@@-member-add <username> --email <address>"
  exit 1
fi

if [[ $# -ne 3 || "$2" != "--email" ]]; then
  echo "Usage: @@PFX@@-member-add <username> --email <address>"
  exit 1
fi

USERNAME="$1"
EMAIL="$3"

if [[ ! "$USERNAME" =~ ^[a-z][a-z0-9_-]{1,31}$ ]]; then
  echo "ERROR: invalid username: $USERNAME"
  exit 1
fi

if [[ ! "$EMAIL" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]]; then
  echo "ERROR: invalid email address"
  exit 1
fi

mkdir -p "$LOG_BASE"
mkdir -p "$MEMBER_META_BASE"
chown root:root "$MEMBER_META_BASE"
chmod 700 "$MEMBER_META_BASE"

MEMBER_META="${MEMBER_META_BASE}/${USERNAME}.json"

if [[ -e "$MEMBER_META" ]]; then
  echo "ERROR: member metadata already exists: $USERNAME"
  exit 1
fi

LOG_FILE="${LOG_BASE}/${USERNAME}-$(date +%Y%m%d-%H%M%S).log"

touch "$LOG_FILE"
chown root:@@PFX@@ "$LOG_FILE"
chmod 640 "$LOG_FILE"

exec 3>&1
exec > >(tee -a "$LOG_FILE") 2>&1

SECRET_DIR="/run/@@PFX@@/member-secrets"
SECRET_FILE="${SECRET_DIR}/${USERNAME}.password"

install -d -o root -g root -m 0700 "$SECRET_DIR"

BOOTSTRAP_PASSWORD="$(
  python3 - <<'PY2'
import secrets
alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789"
print("".join(secrets.choice(alphabet) for _ in range(12)), end="")
PY2
)"

umask 077
printf '%s\n' "$BOOTSTRAP_PASSWORD" > "$SECRET_FILE"
unset BOOTSTRAP_PASSWORD

chown root:root "$SECRET_FILE"
chmod 600 "$SECRET_FILE"

CURRENT_STAGE="START"

fail() {
  echo
  echo "================================="
  echo " Provisioning Failed"
  echo "================================="
  echo
  echo "Reason:"
  echo "  $1"
  echo
  echo "Failed stage:"
  echo "  $CURRENT_STAGE"
  echo
  echo "Cleanup:"
  echo "  sudo @@PFX@@-member-remove $USERNAME"
  echo
  echo "Log:"
  echo "  $LOG_FILE"

  rm -f "$SECRET_FILE"
  exit 1
}

CONTAINER_NAME="dev-${USERNAME}"

echo
echo "================================="
echo " @@BRAND@@ Member Provisioning"
echo "================================="
echo
echo "User: $USERNAME"
echo "Log:  $LOG_FILE"
echo


CURRENT_STAGE="CREATE_MEMBER"

echo "[1/8] Create member environment..."

if ! "${SCRIPT_DIR}/@@PFX@@-user-add"   "$USERNAME"   --password-file "$SECRET_FILE" >>"$LOG_FILE" 2>&1; then
  fail "member environment creation failed"
fi

if ! "${SCRIPT_DIR}/@@PFX@@-agent-config-link" "$USERNAME" >>"$LOG_FILE" 2>&1; then
  fail "agent config link creation failed"
fi

HOST_UID="$(id -u "$USERNAME")"
HOST_GID="$(id -g "$USERNAME")"

META_TMP="$(mktemp "${MEMBER_META_BASE}/.${USERNAME}.XXXXXX")"

AGENT_DEFAULTS_VERSION="$(
  cat /opt/@@PFX@@/config/agent-defaults/VERSION
)"

jq -n   --arg username "$USERNAME"   --arg email "$EMAIL"   --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"   --arg agent_defaults_version "$AGENT_DEFAULTS_VERSION"   '{
    username: $username,
    email: $email,
    created_at: $created_at,
    agent_defaults_version: $agent_defaults_version
  }' > "$META_TMP"

chown root:root "$META_TMP"
chmod 600 "$META_TMP"
mv "$META_TMP" "$MEMBER_META"

echo "OK"


CURRENT_STAGE="START_CONTAINER"

echo
echo "[2/8] Start AI container..."

if ! docker start "$CONTAINER_NAME" >/dev/null; then
  fail "container start failed"
fi

echo "OK"


CURRENT_STAGE="INITIALIZE_SERVICES"

echo
echo "[3/8] Initialize AI services..."

READY=0

for i in $(seq 1 45); do

  if ! docker exec "$CONTAINER_NAME" \
      id "$USERNAME" >/dev/null 2>&1; then
    sleep 2
    continue
  fi

  STATUS="$(
    docker exec "$CONTAINER_NAME" \
      setpriv \
      --reuid="$HOST_UID" \
      --regid="$HOST_GID" \
      --init-groups \
      -- env \
      HOME="/home/$USERNAME" \
      USER="$USERNAME" \
      LOGNAME="$USERNAME" \
      paseo daemon status \
      2>/dev/null || true
  )"

  if echo "$STATUS" | grep -Eiq "local ?daemon[: ]+running" \
     && echo "$STATUS" | grep -Eiq "connected ?daemon[: ]+reachable"; then
    READY=1
    break
  fi

  sleep 2
done

if [[ "$READY" != "1" ]]; then
  fail "AI services initialization failed"
fi

if ! docker exec "$CONTAINER_NAME" \
    setpriv \
    --reuid="$HOST_UID" \
    --regid="$HOST_GID" \
    --init-groups \
    -- env \
    HOME="/home/$USERNAME" \
    USER="$USERNAME" \
    LOGNAME="$USERNAME" \
    /usr/local/bin/@@PFX@@-user-bootstrap >>"$LOG_FILE" 2>&1; then
  fail "user bootstrap failed"
fi

echo "OK"


CURRENT_STAGE="PROVISION_STORAGE"

echo
echo "[4/8] Provision member storage..."

if ! "${SCRIPT_DIR}/@@PFX@@-member-storage-provision"   "$USERNAME"   --password-file "$SECRET_FILE" >>"$LOG_FILE" 2>&1; then
  fail "member storage provisioning failed"
fi

echo "OK"


CURRENT_STAGE="CREATE_PASEO"

echo
echo "[5/8] Create Paseo onboarding..."

PAIR_READY=0

for i in $(seq 1 10); do

  if "${SCRIPT_DIR}/@@PFX@@-paseo-pair-create" "$USERNAME" >>"$LOG_FILE" 2>&1; then
    PAIR_READY=1
    break
  fi

  sleep 3
done

if [[ "$PAIR_READY" != "1" ]]; then
  fail "Paseo onboarding failed"
fi

echo "OK"


# Paseo 직접 연결 서브도메인(옵트인, 2026-10-25): /etc/@@PFX@@/paseo-direct.default 가 있을 때만 만든다(기본은 없음). Paseo 0.12.0 부터 릴레이 연결에서도
# 64MB 이하 파일 다운로드가 되므로 신규 멤버에게 자동으로 열지 않는다. 필요한 멤버는 관리자가 `sudo @@PFX@@-paseo-caddy add <멤버>`. 실패해도 프로비저닝은 계속한다.
if [[ -f /etc/@@PFX@@/paseo-direct.default && -x /usr/local/sbin/@@PFX@@-paseo-caddy ]] \
   && ! flock /run/@@PFX@@-paseo-caddy.lock /usr/local/sbin/@@PFX@@-paseo-caddy add "$USERNAME" >>"$LOG_FILE" 2>&1; then
  echo "WARNING: Paseo direct-connect Caddy block not created (retry: sudo @@PFX@@-paseo-caddy add $USERNAME)"
fi

# 멤버 사이트 공개(publish) 블록(선택 기능): 실패해도 프로비저닝은 계속한다(@@PFX@@-site-caddy 가 스스로 원복). 통과 ACL 은 더 이상 쓰지 않는다.
if [[ -x /usr/local/sbin/@@PFX@@-site-caddy ]] \
   && ! /usr/local/sbin/@@PFX@@-site-caddy add "$USERNAME" >>"$LOG_FILE" 2>&1; then
  echo "WARNING: site publish Caddy block not created (retry: sudo @@PFX@@-site-caddy add $USERNAME)"
fi
# 멤버 PostgreSQL 자동 발급(선택 기능): 실패해도 프로비저닝은 계속한다. 암호는 화면·로그에 남지 않고 멤버 컨테이너의 ~/.pgpass 로 들어간다.
if [[ -x /usr/local/sbin/@@PFX@@-member-db-setup ]]; then
  if [[ "$USERNAME" =~ ^[a-z][a-z0-9_]*$ ]]; then
    if ! /usr/local/sbin/@@PFX@@-member-db-setup "$USERNAME" >>"$LOG_FILE" 2>&1; then
      echo "WARNING: member PostgreSQL not issued (retry: sudo @@PFX@@-member-db-setup $USERNAME)"
    fi
  else
    echo "NOTE: member PostgreSQL skipped (ID has a hyphen; DB names allow letters, digits, underscore only)"
  fi
fi

CURRENT_STAGE="CREATE_QR"

echo
echo "[6/8] Generate QR artifact..."

if ! "${SCRIPT_DIR}/@@PFX@@-paseo-pair-qr-create" "$USERNAME" >>"$LOG_FILE" 2>&1; then
  fail "QR generation failed"
fi

echo "OK"


CURRENT_STAGE="CREATE_ONBOARDING"

echo
echo "[7/8] Create onboarding document..."

if ! "${SCRIPT_DIR}/@@PFX@@-onboarding-create" "$USERNAME" >>"$LOG_FILE" 2>&1; then
  fail "onboarding document creation failed"
fi

echo "OK"


CURRENT_STAGE="NOTIFY_ONBOARDING"

echo
echo "[8/8] Send onboarding notification..."

# 전달 채널(docs/ONBOARDING.md): screen · smtp · n8n · link · webhook · print — 비밀은 fd 3(터미널)으로만 나가 로그에 남지 않는다
if [[ -x /usr/local/sbin/@@PFX@@-onboard-deliver ]]; then
  /usr/local/sbin/@@PFX@@-onboard-deliver deliver --user "$USERNAME" --email "$EMAIL" --password-file "$SECRET_FILE" --secret-fd 3 \
    || echo "안내: 전달 채널을 실행하지 못했습니다 — 초기 비밀번호 파일(root 전용): $SECRET_FILE  (sudo @@PFX@@-onboard-deliver --check 로 점검)"
else
  echo "안내: @@PFX@@-onboard-deliver 명령이 없어 안내를 전달하지 못했습니다 — 초기 비밀번호 파일(root 전용): $SECRET_FILE"
fi

echo

echo "================================="
echo " Provisioning Complete"
echo "================================="
echo
echo "User:"
echo "  $USERNAME"
echo
echo "Container:"
echo "  $CONTAINER_NAME"
echo
echo "Workspace:"
echo "  /srv/@@PFX@@/users/$USERNAME/workspace"
echo
echo "Onboarding:"
echo "  /srv/@@PFX@@/onboarding/$USERNAME"
echo
echo "Artifacts:"
echo "  - README.md"
echo "  - pairing.json"
echo "  - pairing-url.txt"
echo "  - pairing.png"
echo
echo "Log:"
echo "  $LOG_FILE"

_wo="$(sed -n 's/^WORKSPACE_OTHERS=//p' /etc/@@PFX@@/site.env 2>/dev/null | tr -d "'\"" | tail -1)"
_others="$(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^dev-' | grep -vxF "dev-$USERNAME" | wc -l || true)"
if [[ "$_wo" == "read" && "${_others:-0}" -gt 0 ]]; then
  echo
  echo "기존 회원 컨테이너 갱신: sudo @@PFX@@-member-update-all (작업 중인 회원이 있으면 --check 로 확인)"
  echo "  (읽기 정책이라 기존 회원 컨테이너에는 /members/$USERNAME 이 재생성 전까지 보이지 않습니다. 자동으로 재생성하지 않습니다)"
fi
