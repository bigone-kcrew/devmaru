#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="/opt/@@PFX@@/config/dev-container.env"
CONTAINER_CREATE="/opt/@@PFX@@/scripts/@@PFX@@-dev-container-create"

if [[ $EUID -ne 0 ]]; then
  echo "ERROR: run as root: sudo @@PFX@@-member-runtime-recreate-all [--check]"
  exit 1
fi

MODE="update"

if [[ $# -gt 1 ]]; then
  echo "Usage: @@PFX@@-member-runtime-recreate-all [--check]"
  exit 1
fi

if [[ $# -eq 1 ]]; then
  if [[ "$1" == "--check" ]]; then
    MODE="check"
  else
    echo "Usage: @@PFX@@-member-runtime-recreate-all [--check]"
    exit 1
  fi
fi

if [[ ! -r "$CONFIG_FILE" ]]; then
  echo "ERROR: config file not found or unreadable: $CONFIG_FILE"
  exit 1
fi

# shellcheck disable=SC1090
source "$CONFIG_FILE"

required_vars=(
  GOLDEN_IMAGE
  USER_ROOT_BASE
)

for var in "${required_vars[@]}"; do
  if [[ -z "${!var:-}" ]]; then
    echo "ERROR: required config variable is missing: $var"
    exit 1
  fi
done

if [[ ! -x "$CONTAINER_CREATE" ]]; then
  echo "ERROR: container creator not found or not executable: $CONTAINER_CREATE"
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "ERROR: Docker daemon is not available"
  exit 1
fi

if ! docker image inspect "$GOLDEN_IMAGE" >/dev/null 2>&1; then
  echo "ERROR: Golden Image not found: $GOLDEN_IMAGE"
  exit 1
fi

if [[ ! -d "$USER_ROOT_BASE" ]]; then
  echo "ERROR: user root does not exist: $USER_ROOT_BASE"
  exit 1
fi

GOLDEN_ID="$(docker image inspect "$GOLDEN_IMAGE" --format '{{.Id}}')"

is_excluded_user() {
  local username="$1"
  local excluded_user

  for excluded_user in ${UPDATE_EXCLUDE_USERS:-}; do
    if [[ "$username" == "$excluded_user" ]]; then
      return 0
    fi
  done

  return 1
}

declare -a MEMBERS=()

TOTAL=0
READY=0
BUSY=0
MISSING=0

echo "=============================================="
echo " @@BRAND@@ Runtime Recreate Preflight"
echo "=============================================="
echo
echo "Golden image:"
echo "  $GOLDEN_IMAGE"
echo "  $GOLDEN_ID"
echo

printf '%-18s %-18s %-7s %-9s %s\n' \
  "USER" "CONTAINER" "TMUX" "STATE" "RESULT"

printf '%-18s %-18s %-7s %-9s %s\n' \
  "------------------" \
  "------------------" \
  "-------" \
  "---------" \
  "------"

shopt -s nullglob

for user_path in "$USER_ROOT_BASE"/*; do
  [[ -d "$user_path" ]] || continue

  USERNAME="$(basename "$user_path")"

  if is_excluded_user "$USERNAME"; then
    continue
  fi

  if ! id "$USERNAME" >/dev/null 2>&1; then
    continue
  fi

  MEMBERS+=("$USERNAME")
  TOTAL=$((TOTAL + 1))

  CONTAINER_NAME="dev-${USERNAME}"

  if ! docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
    printf '%-18s %-18s %-7s %-9s %s\n' \
      "$USERNAME" "$CONTAINER_NAME" "-" "MISSING" "NO CONTAINER"
    MISSING=$((MISSING + 1))
    continue
  fi

  STATE="$(docker inspect "$CONTAINER_NAME" --format '{{.State.Status}}')"

  TMUX_COUNT=0

  if [[ "$STATE" == "running" ]]; then
    USER_UID="$(id -u "$USERNAME")"
    USER_GID="$(id -g "$USERNAME")"

    TMUX_OUTPUT="$(
      docker exec "$CONTAINER_NAME" \
        setpriv \
        --reuid="$USER_UID" \
        --regid="$USER_GID" \
        --init-groups \
        -- env \
        HOME="/home/$USERNAME" \
        USER="$USERNAME" \
        LOGNAME="$USERNAME" \
        tmux list-sessions 2>/dev/null || true
    )"

    if [[ -n "$TMUX_OUTPUT" ]]; then
      TMUX_COUNT="$(
        printf '%s\n' "$TMUX_OUTPUT" \
          | sed '/^[[:space:]]*$/d' \
          | wc -l
      )"
    fi
  fi

  if (( TMUX_COUNT > 0 )); then
    RESULT="BUSY"
    BUSY=$((BUSY + 1))
  else
    RESULT="READY"
    READY=$((READY + 1))
  fi

  printf '%-18s %-18s %-7s %-9s %s\n' \
    "$USERNAME" \
    "$CONTAINER_NAME" \
    "$TMUX_COUNT" \
    "$STATE" \
    "$RESULT"
done

echo
echo "Summary:"
echo "  members: $TOTAL"
echo "  ready:   $READY"
echo "  busy:    $BUSY"
echo "  missing: $MISSING"
echo

if (( BUSY > 0 )); then
  echo "RESULT: BLOCKED"
  echo "One or more members have active tmux sessions."
  echo "No containers will be changed."
  exit 1
fi

if (( MISSING > 0 )); then
  echo "RESULT: REVIEW"
  echo "One or more members are missing dev containers."
  echo "No containers will be changed."
  exit 1
fi

echo "RESULT: READY"
echo "All member containers are safe for runtime recreation."

if [[ "$MODE" == "check" ]]; then
  exit 0
fi

if (( TOTAL == 0 )); then
  echo
  echo "No member accounts found."
  exit 0
fi

echo
echo "=============================================="
echo " @@BRAND@@ Runtime Recreate"
echo "=============================================="

UPDATED=0

for USERNAME in "${MEMBERS[@]}"; do
  CONTAINER_NAME="dev-${USERNAME}"

  echo
  echo "----------------------------------------------"
  echo "Recreating: $USERNAME"
  echo "Container:  $CONTAINER_NAME"

  echo
  echo "[0/5] Prepare agent configuration..."

  /opt/@@PFX@@/scripts/@@PFX@@-agent-config-provision "$USERNAME"

  install -d \
    -o "$USERNAME" \
    -g "$USERNAME" \
    -m 0750 \
    "/home/$USERNAME/.@@PFX@@" \
    "/home/$USERNAME/.@@PFX@@/agent-config"

  /opt/@@PFX@@/scripts/@@PFX@@-agent-config-link "$USERNAME"

  echo "OK"

  echo
  echo "[1/5] Remove old container..."
  docker rm -f "$CONTAINER_NAME" >/dev/null
  echo "OK"

  echo
  echo "[2/5] Create container..."
  "$CONTAINER_CREATE" "$USERNAME"
  echo "OK"

  echo
  echo "[3/5] Start container..."
  docker start "$CONTAINER_NAME" >/dev/null
  echo "OK"

  echo
  echo "[4/5] Wait for member environment..."

  HOST_UID="$(id -u "$USERNAME")"
  HOST_GID="$(id -g "$USERNAME")"

  READY_ENV=0

  for i in $(seq 1 45); do
    if docker exec "$CONTAINER_NAME" \
      id "$USERNAME" >/dev/null 2>&1; then
      READY_ENV=1
      break
    fi

    sleep 2
  done

  if [[ "$READY_ENV" != "1" ]]; then
    echo "ERROR: member environment did not initialize: $USERNAME"
    exit 1
  fi

  echo "OK"

  /usr/local/sbin/@@PFX@@-paseo-caddy-sync || echo "WARNING: Paseo Caddy IP sync failed (run: sudo @@PFX@@-paseo-caddy-sync)"

  echo
  echo "[5/5] Verify runtime and bootstrap..."

  NEW_IMAGE_ID="$(
    docker inspect "$CONTAINER_NAME" \
      --format '{{.Image}}'
  )"

  if [[ "$NEW_IMAGE_ID" != "$GOLDEN_ID" ]]; then
    echo "ERROR: unexpected image ID for $CONTAINER_NAME"
    echo "Expected: $GOLDEN_ID"
    echo "Actual:   $NEW_IMAGE_ID"
    exit 1
  fi

  docker exec "$CONTAINER_NAME" \
    setpriv \
    --reuid="$HOST_UID" \
    --regid="$HOST_GID" \
    --init-groups \
    -- env \
    HOME="/home/$USERNAME" \
    USER="$USERNAME" \
    LOGNAME="$USERNAME" \
    /usr/local/bin/@@PFX@@-user-bootstrap

  docker exec "$CONTAINER_NAME" \
    setpriv \
    --reuid="$HOST_UID" \
    --regid="$HOST_GID" \
    --init-groups \
    -- env \
    HOME="/home/$USERNAME" \
    USER="$USERNAME" \
    LOGNAME="$USERNAME" \
    bash -lc '
      test -d "$HOME/.claude/skills" &&
      test -d "$HOME/.agents/skills" &&
      test -f "$HOME/.@@PFX@@/agent-config/CLAUDE.md" &&
      test -f "$HOME/.@@PFX@@/agent-config/AGENTS.md" &&
      test -L "$HOME/.claude/CLAUDE.md" &&
      test -L "$HOME/.codex/AGENTS.md" &&
      test -f "$HOME/.claude/CLAUDE.md" &&
      test -f "$HOME/.codex/AGENTS.md" &&
      test -d /opt/@@PFX@@/managed-mcp &&
      test -r /opt/@@PFX@@/managed-mcp/kordoc/server.mjs &&
      test -r /opt/@@PFX@@/managed-mcp/markitdown/server.mjs &&
      test -r /opt/@@PFX@@/api-catalog/data/catalog.json &&
      test -x /usr/local/bin/api-catalog-search &&
      test -x /usr/local/bin/@@PFX@@-mcp-sync &&
      command -v claude >/dev/null &&
      command -v codex >/dev/null &&
      command -v paseo >/dev/null &&
      command -v kordoc-api >/dev/null
    '

  echo "OK"

  UPDATED=$((UPDATED + 1))

  echo
  echo "$USERNAME: PASS"
done

echo
echo "=============================================="
echo " Runtime Recreate Complete"
echo "=============================================="
echo
echo "Golden:    $GOLDEN_IMAGE"
echo "Recreated: $UPDATED"
echo "Members:   $TOTAL"
echo
echo "Linux accounts: preserved"
echo "Home data:      preserved"
echo "Workspaces:     preserved"
