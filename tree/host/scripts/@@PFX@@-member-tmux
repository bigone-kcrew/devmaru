#!/usr/bin/env bash
set -euo pipefail

die() {
  echo "ERROR: $*" >&2
  exit 1
}

[[ "${EUID}" -eq 0 ]] || die "must run via sudo wrapper"

MEMBER="${SUDO_USER:-}"
[[ -n "$MEMBER" && "$MEMBER" != "root" ]] || die "cannot determine member"

[[ "$MEMBER" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid username"

id "$MEMBER" >/dev/null 2>&1 || die "unknown user: $MEMBER"

id -nG "$MEMBER" | tr ' ' '\n' | grep -qx '@@PFX@@' \
  || die "$MEMBER is not an @@BRAND@@ member"

[[ -d "/srv/@@PFX@@/users/$MEMBER" ]] \
  || die "member workspace not found"

SESSION="${1:-main}"
[[ "$SESSION" =~ ^[A-Za-z0-9._-]{1,64}$ ]] \
  || die "invalid tmux session name"

CONTAINER="dev-$MEMBER"

RUNNING="$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null || true)"
[[ "$RUNNING" == "true" ]] || die "$CONTAINER is not running"

[[ -t 0 && -t 1 ]] || die "tmx requires an interactive terminal"

exec docker exec \
  -it \
  --user "$MEMBER" \
  -e "HOME=/home/$MEMBER" \
  -e "@@PFX_UP@@_DEV=1" \
  -e "TERM=${TERM:-xterm-256color}" \
  -w /workspace \
  "$CONTAINER" \
  bash -lc 'exec tmux new-session -A -s "$1"' _ "$SESSION"
