#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -eq 0 ]]; then
  echo "오류: root가 아닌 회원 계정으로 실행하세요." >&2
  exit 1
fi

echo "===== @@BRAND@@ GitHub 상태 ====="

if ! command -v git >/dev/null 2>&1; then
  echo "Git: 설치되지 않음"
  exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "GitHub CLI: 설치되지 않음"
  exit 1
fi

if ! gh auth status --hostname github.com >/dev/null 2>&1; then
  echo
  echo "상태: 연결되지 않음"
  echo
  echo "GitHub는 처음부터 연결할 필요가 없습니다."
  echo "필요할 때 아래 명령으로 연결하세요."
  echo
  echo "  @@PFX@@-github-connect"
  exit 2
fi

LOGIN="$(gh api user --jq '.login' 2>/dev/null || true)"
NAME="$(gh api user --jq '.name // empty' 2>/dev/null || true)"
PROTOCOL="$(gh config get git_protocol --host github.com 2>/dev/null || true)"

echo
echo "상태: 연결됨"
echo "GitHub 계정: ${LOGIN:-확인 불가}"
[[ -n "$NAME" ]] && echo "이름: $NAME"
echo "Git 방식: ${PROTOCOL:-확인 불가}"
echo
echo "이제 다음 환경에서 같은 GitHub 계정을 사용할 수 있습니다."
echo
echo "  - Claude Code"
echo "  - Codex"
echo "  - Paseo를 통한 Claude/Codex 세션"
echo "  - git clone / pull / push"
echo "  - GitHub Issue / Pull Request"
